@model GoIPGateway.Web.Models.CompanyDashboardViewModel
@{
    ViewData["Title"] = "بوابة التاجر - الرئيسية";
}

<!-- Merchant Hero Banner & Balance Display -->
<div class="portal-card p-4 p-md-5 mb-4 position-relative overflow-hidden">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="fw-bold mb-0">أهلاً بك، @Model.Tenant.CompanyName 👋</h2>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fs-8">حساب تاجر نشط</span>
                    </div>
                    <p class="text-muted mb-0 mt-1">بوابة السداد والشحن المباشر عبر ماكينات وأجهزة GoIP</p>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <a asp-area="Company" asp-controller="Execute" asp-action="Index" class="btn btn-warning btn-merchant-action text-dark">
                    <i class="bi bi-lightning-charge-fill fs-5"></i>
                    <span>تنفيذ عملية فورية الآن</span>
                </a>
                <a asp-area="Company" asp-controller="Transactions" asp-action="Index" class="btn btn-outline-secondary btn-merchant-action">
                    <i class="bi bi-receipt fs-5"></i>
                    <span>سجل معاملاتي</span>
                </a>
            </div>
        </div>

        <!-- Big Merchant Balance Highlight Card -->
        <div class="col-lg-5">
            <div class="p-4 rounded-4" style="background: linear-gradient(135deg, rgba(37,99,235,0.08) 0%, rgba(34,197,94,0.08) 100%); border: 2px dashed rgba(34,197,94,0.35);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fw-bold small"><i class="bi bi-wallet2 text-success me-1"></i> رصيدك المتاح حالياً</span>
                    <span class="badge bg-success bg-opacity-25 text-success">محفظة فورية</span>
                </div>
                <div class="display-6 fw-bold text-success my-2" style="font-family: 'Cairo', sans-serif;">
                    @Model.Tenant.Balance.ToString("N2") <span class="fs-5 text-muted fw-normal">ج.م</span>
                </div>
                <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top border-secondary border-opacity-25">
                    <span>حد الائتمان الإضافي:</span>
                    <strong class="text-main">@Model.Tenant.CreditLimit.ToString("N2") ج.م</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4 Key Indicators for Merchant -->
<div class="row g-3 mb-4">
    <!-- Today's Operations -->
    <div class="col-xl-3 col-md-6">
        <div class="card-stat">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">عمليات اليوم</span>
                    <h3 class="fw-bold my-2">@Model.TodayOperationsCount <span class="fs-6 text-muted fw-normal">عملية</span></h3>
                    <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> @Model.TodaySuccessfulOps ناجحة</span>
                </div>
                <div class="icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Rate -->
    <div class="col-xl-3 col-md-6">
        <div class="card-stat">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">نسبة كفاءة التنفيذ</span>
                    <h3 class="fw-bold my-2 text-info">@Model.SuccessRate%</h3>
                    <span class="text-muted small">تنفيذ سريع ومباشر</span>
                </div>
                <div class="icon-box bg-info bg-opacity-10 text-info">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Ready Lines -->
    <div class="col-xl-3 col-md-6">
        <div class="card-stat">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">الخطوط المخصصة لك</span>
                    <h3 class="fw-bold my-2 text-warning">@Model.AssignedSimCards.Count <span class="fs-6 text-muted fw-normal">شريحة</span></h3>
                    <span class="text-success small"><span class="badge-live-pulse me-1"></span> جاهزة للعمل 24/7</span>
                </div>
                <div class="icon-box bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-sim-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- System Status -->
    <div class="col-xl-3 col-md-6">
        <div class="card-stat">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">حالة الربط والشبكة</span>
                    <h3 class="fw-bold my-2 text-success">مستقر ومتصل</h3>
                    <span class="text-muted small">سيرفر GoIP نشط</span>
                </div>
                <div class="icon-box bg-success bg-opacity-10 text-success">
                    <i class="bi bi-hdd-network"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3 Large Action Cards for Ordinary Market Users -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-area="Company" asp-controller="Execute" asp-action="Index" class="text-decoration-none">
            <div class="portal-card p-4 h-100 d-flex align-items-center gap-3 border-2 border-warning border-opacity-50">
                <div class="p-3 rounded-4 bg-warning bg-opacity-15 text-warning fs-1">
                    <i class="bi bi-qr-code-scan"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-main">دفع تاجر QR</h5>
                    <p class="text-muted small mb-0">تحويل فوري لماكينة أو كود التاجر بالجنيه</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-area="Company" asp-controller="Execute" asp-action="Index" class="text-decoration-none">
            <div class="portal-card p-4 h-100 d-flex align-items-center gap-3 border-2 border-primary border-opacity-50">
                <div class="p-3 rounded-4 bg-primary bg-opacity-15 text-primary fs-1">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-main">تحويل كاش لمحفظة</h5>
                    <p class="text-muted small mb-0">تحويل فوري لأي رقم محفظة إلكترونية</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-area="Company" asp-controller="Execute" asp-action="Index" class="text-decoration-none">
            <div class="portal-card p-4 h-100 d-flex align-items-center gap-3 border-2 border-success border-opacity-50">
                <div class="p-3 rounded-4 bg-success bg-opacity-15 text-success fs-1">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-main">استعلام رصيد المحفظة</h5>
                    <p class="text-muted small mb-0">كشف رصيد الخط والشريحة في ثواني</p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Merchant Assigned SIMs -->
    <div class="col-lg-6">
        <div class="portal-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-sim-fill text-primary me-2"></i> خطوط المحافظ المخصصة لحسابك</h5>
                <span class="badge bg-secondary">@Model.AssignedSimCards.Count خطوط</span>
            </div>

            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>الشبكة</th>
                            <th>رقم الخط</th>
                            <th>رصيد الشريحة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AssignedSimCards.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">لا توجد خطوط مخصصة لحسابكم حالياً.</td>
                            </tr>
                        }
                        @foreach (var sim in Model.AssignedSimCards)
                        {
                            <tr>
                                <td>
                                    @switch (sim.Operator)
                                    {
                                        case GoIPGateway.Domain.Enums.OperatorType.Vodafone:
                                            <span class="badge badge-op-vodafone px-3 py-2">فودافون كاش</span>
                                            break;
                                        case GoIPGateway.Domain.Enums.OperatorType.Orange:
                                            <span class="badge badge-op-orange px-3 py-2">أورانج كاش</span>
                                            break;
                                        case GoIPGateway.Domain.Enums.OperatorType.Etisalat:
                                            <span class="badge badge-op-etisalat px-3 py-2">اتصالات كاش</span>
                                            break;
                                        default:
                                            <span class="badge badge-op-we px-3 py-2">وي باي (WE)</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-bold fs-6">@sim.PhoneNumber</td>
                                <td class="fw-bold fs-6 text-success">@sim.CurrentBalance.ToString("N2") ج.م</td>
                                <td>
                                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2 py-1">
                                        <i class="bi bi-check2-circle me-1"></i> جاهز وشغال
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Merchant Transactions -->
    <div class="col-lg-6">
        <div class="portal-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-warning me-2"></i> آخر المعاملات المنفذة</h5>
                <a asp-area="Company" asp-controller="Transactions" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-bold">عرض السجل الكامل</a>
            </div>

            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>نوع المعاملة</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>التوقيت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTransactions.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">لا توجد عمليات منفذة بعد. اضغط على "تنفيذ عملية فورية" للبدء.</td>
                            </tr>
                        }
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@(tx.ServiceDefinition?.NameAr ?? "عملية USSD")</div>
                                    <code class="small">@tx.TransactionRef</code>
                                </td>
                                <td class="fw-bold fs-6">@(tx.Amount.HasValue ? tx.Amount.Value.ToString("N2") + " ج.م" : "-")</td>
                                <td>
                                    @if (tx.Status == GoIPGateway.Domain.Enums.TransactionStatus.Completed)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> ناجحة
                                        </span>
                                    }
                                    else if (tx.Status == GoIPGateway.Domain.Enums.TransactionStatus.Processing)
                                    {
                                        <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> قيد التنفيذ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> فشلت
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">@tx.RequestedAt.ToString("HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
