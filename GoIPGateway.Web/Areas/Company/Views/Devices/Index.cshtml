@model IEnumerable<GoIPGateway.Domain.Entities.TenantDevice>
@{
    var tenant = ViewBag.Tenant as GoIPGateway.Domain.Entities.Tenant;
    int currentCount = ViewBag.CurrentCount ?? 0;
    int maxDevices = ViewBag.MaxDevices ?? 1;
    bool canAddMore = ViewBag.CanAddMore ?? false;
    ViewData["Title"] = "أجهزة GoIP الخاصة بالشركة";

    var devList = Model.ToList();
    var onlineDevices = devList.Count(td => td.Device != null && td.Device.IsOnline);
    var totalPorts = devList.Sum(td => td.Device?.TotalPorts ?? 0);
    var activeSims = devList.Sum(td => td.Device?.Ports?.Count(p => p.SimCard != null && p.SimCard.IsActive && !p.SimCard.IsDelete) ?? 0);
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">أجهزة GoIP والبوابات</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-black mb-1 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-router-fill fs-4"></i>
                </span>
                <span>أجهزة GoIP وبوابات الدفع (Company Devices)</span>
            </h3>
            <p class="text-muted small mb-0">إدارة البوابات المربوطة بحساب شركتك، فحص الاتصال ومراقبة منافذ الشرائح</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (canAddMore)
            {
                <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill fs-5"></i>
                    <span>إضافة جهاز جديد</span>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-secondary px-3 py-2 rounded-3 fw-bold" disabled title="وصلت للحد الأقصى">
                    <i class="bi bi-lock-fill me-1"></i> استنفذت الحصة (@maxDevices)
                </button>
            }
        </div>
    </div>

    <!-- 4 KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">حصة الأجهزة المخصصة</div>
                        <div class="fs-4 fw-black text-primary font-monospace my-1">@currentCount <span class="fs-7 text-muted fw-normal">/ @maxDevices</span></div>
                        <div class="text-muted fs-8">@(canAddMore ? $"متبقي {maxDevices - currentCount} أجهزة" : "استنفذت كامل الحصة")</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-router"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">حالة الاتصال بالشبكة</div>
                        <div class="fs-4 fw-black text-success my-1 font-monospace">@onlineDevices <span class="fs-7 text-muted fw-normal">أونلاين</span></div>
                        <div class="text-muted fs-8">بوابات متصلة بالخادم</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-wifi"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">سعة البورتات الكلية</div>
                        <div class="fs-4 fw-black text-info font-monospace my-1">@totalPorts <span class="fs-7 text-muted fw-normal">منفذ</span></div>
                        <div class="text-muted fs-8">إجمالي منافذ الشرايح</div>
                    </div>
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">الشرائح المركبة والنشطة</div>
                        <div class="fs-4 fw-black text-warning font-monospace my-1">@activeSims <span class="fs-7 text-muted fw-normal">خط</span></div>
                        <div class="text-muted fs-8">جاهزة لتنفيذ العمليات</div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-sim"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!canAddMore)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-2 mb-4 rounded-3">
            <i class="bi bi-info-circle-fill fs-5"></i>
            <div>
                لقد استخدمت كامل عدد الأجهزة المسموح بها في باقتك الحالية (<strong>@maxDevices أجهزة</strong>). إذا كنت بحاجة لإضافة بوابات إضافية، يرجى التواصل مع إدارة النظام لترقية باقتك.
            </div>
        </div>
    }

    <!-- Toolbar: Search & Count -->
    <div class="portal-card p-3 mb-4 shadow-sm">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="devSearchInput" class="form-control border-start-0" 
                           placeholder="ابحث باسم الجهاز، السيريال، أو عنوان الـ IP..." 
                           onkeyup="filterDevices()" />
                </div>
            </div>

            <div class="col-12 col-md-6 text-md-end">
                <span class="text-muted small">
                    عرض <strong class="text-primary font-monospace" id="visibleDevCount">@devList.Count</strong> من أصل @devList.Count أجهزة
                </span>
            </div>
        </div>
    </div>

    <!-- Devices Table Card -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        @if (!devList.Any())
        {
            <div class="text-center py-5">
                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary d-inline-block mb-3">
                    <i class="bi bi-router fs-2"></i>
                </div>
                <h5 class="fw-bold text-main mb-2">لا توجد أجهزة GoIP مسجلة بعد</h5>
                <p class="text-muted small mb-3">أضف بيانات جهاز GoIP الأول الخاص بك للبدء في تركيب وإدارة الشرائح.</p>
                @if (canAddMore)
                {
                    <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-bold">
                        <i class="bi bi-plus-circle-fill me-1"></i> إضافة أول جهاز الآن
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive table-responsive-custom">
                <table class="table table-custom align-middle mb-0" id="devMasterTable">
                    <thead>
                        <tr>
                            <th style="min-width: 220px;">اسم الجهاز</th>
                            <th style="min-width: 140px;">النوع والموديل</th>
                            <th style="min-width: 160px;">عنوان IP والمنفذ</th>
                            <th style="min-width: 120px;">حالة الاتصال</th>
                            <th style="min-width: 150px;">المنافذ والشرائح</th>
                            <th class="text-center" style="min-width: 160px;">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="devTableBody">
                        @foreach (var td in devList)
                        {
                            var dev = td.Device;
                            var devActiveSims = dev.Ports.Count(p => p.SimCard != null && p.SimCard.IsActive && !p.SimCard.IsDelete);
                            var searchKeywords = $"{dev.DeviceName} {dev.SerialNumber} {dev.IpAddress} {dev.DeviceType}".ToLower();

                            <tr class="dev-row" data-search="@searchKeywords">
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="row-avatar" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                            <i class="bi bi-router"></i>
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@dev.Id" class="fw-bold text-main text-decoration-none d-block hover-primary">
                                                @dev.DeviceName
                                            </a>
                                            <small class="text-muted font-monospace fs-8">SN: @(dev.SerialNumber ?? "N/A")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="pill-badge pill-badge-neutral font-monospace">
                                        @dev.DeviceType
                                    </span>
                                </td>
                                <td>
                                    <code class="text-primary font-monospace fw-bold">@dev.IpAddress:@dev.Port</code>
                                </td>
                                <td>
                                    @if (dev.IsOnline)
                                    {
                                        <span class="pill-badge pill-badge-success">
                                            <span class="dot-indicator"></span>متصل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill-badge pill-badge-danger">
                                            <span class="dot-indicator"></span>غير متصل
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-main font-monospace">@devActiveSims / @dev.TotalPorts <small class="text-muted fw-normal">منافذ نشطة</small></div>
                                </td>
                                <td class="text-center">
                                    <div class="actions-btn-group justify-content-center">
                                        <a asp-action="Details" asp-route-id="@dev.Id" class="btn btn-sm btn-outline-primary fw-bold px-3 py-1.5 rounded-3 d-flex align-items-center gap-1.5 shadow-sm" title="فتح خريطة ومصفوفة البورتات اللحظية">
                                            <i class="bi bi-grid-3x3-gap-fill"></i>
                                            <span>مصفوفة البورتات</span>
                                        </a>
                                        <a asp-area="Company" asp-controller="SimCards" asp-action="Index" class="btn-action-icon" title="إدارة الشرائح المركبة">
                                            <i class="bi bi-sim"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterDevices() {
            const query = (document.getElementById('devSearchInput')?.value || '').trim().toLowerCase();
            const rows = document.querySelectorAll('.dev-row');
            let visible = 0;

            rows.forEach(row => {
                const rowSearch = row.getAttribute('data-search') || '';
                if (!query || rowSearch.includes(query)) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleDevCount');
            if (countEl) countEl.innerText = visible;
        }
    </script>
}
