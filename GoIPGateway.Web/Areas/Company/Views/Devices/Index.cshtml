@model IEnumerable<GoIPGateway.Domain.Entities.TenantDevice>
@{
    var tenant = ViewBag.Tenant as GoIPGateway.Domain.Entities.Tenant;
    int maxDevices = ViewBag.MaxDevices ?? 1;
    ViewData["Title"] = "أجهزة GoIP الخاصة بالشركة";

    var devList = Model.ToList();
    var activeList = devList.Where(td => td.Device != null && !td.Device.IsDelete).ToList();
    var deletedList = devList.Where(td => td.Device != null && td.Device.IsDelete).ToList();

    int activeCount = ViewBag.CurrentCount ?? activeList.Count;
    int deletedCount = ViewBag.DeletedCount ?? deletedList.Count;
    bool canAddMore = activeCount < maxDevices;

    var onlineDevices = activeList.Count(td => td.Device != null && td.Device.IsOnline);
    var totalPorts = activeList.Sum(td => td.Device?.TotalPorts ?? 0);
    var activeSims = activeList.Sum(td => td.Device?.Ports?.Count(p => p.SimCard != null && p.SimCard.IsActive && !p.SimCard.IsDelete) ?? 0);
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">أجهزة GoIP والبوابات</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-black mb-1 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-router-fill fs-4"></i>
                </span>
                <span>أجهزة GoIP وبوابات الدفع (Company Devices)</span>
            </h3>
            <p class="text-muted small mb-0">إدارة البوابات المربوطة بحساب شركتك، تعديل إعدادات الربط، ومراقبة منافذ الشرائح</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (canAddMore)
            {
                <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill fs-5"></i>
                    <span>إضافة جهاز جديد</span>
                </a>
            }
            else
            {
                <button type="button" class="btn btn-secondary px-3 py-2 rounded-3 fw-bold" disabled title="وصلت للحد الأقصى">
                    <i class="bi bi-lock-fill me-1"></i> استنفذت الحصة (@maxDevices)
                </button>
            }
        </div>
    </div>

    <!-- 4 KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Quota -->
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">حصة الأجهزة المخصصة</div>
                        <div class="fs-4 fw-black text-primary font-monospace my-1">@activeCount <span class="fs-7 text-muted fw-normal">/ @maxDevices</span></div>
                        <div class="text-muted fs-8">@(canAddMore ? $"متبقي {maxDevices - activeCount} أجهزة" : "استنفذت كامل الحصة")</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-router"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Online Status -->
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">حالة الاتصال بالشبكة</div>
                        <div class="fs-4 fw-black text-success my-1 font-monospace">@onlineDevices <span class="fs-7 text-muted fw-normal">أونلاين</span></div>
                        <div class="text-muted fs-8">بوابات متصلة بالخادم</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-wifi"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Deleted / Trash -->
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">سلة المحذوفات (تعطيل مؤقت)</div>
                        <div class="fs-4 fw-black text-danger font-monospace my-1">@deletedCount <span class="fs-7 text-muted fw-normal">أجهزة</span></div>
                        <div class="text-muted fs-8">@(deletedCount > 0 ? "يمكن استعادتها بأي وقت" : "لا توجد أجهزة محذوفة")</div>
                    </div>
                    <div class="icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-trash3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Ports & Sims -->
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">الشرائح / إجمالي المنافذ</div>
                        <div class="fs-4 fw-black text-info font-monospace my-1">@activeSims <span class="fs-7 text-muted fw-normal">/ @totalPorts</span></div>
                        <div class="text-muted fs-8">منافذ مركبة ونشطة</div>
                    </div>
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!canAddMore)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-2 mb-4 rounded-3">
            <i class="bi bi-info-circle-fill fs-5"></i>
            <div>
                لقد استخدمت كامل عدد الأجهزة المسموح بها في باقتك الحالية (<strong>@maxDevices أجهزة</strong>). إذا كنت بحاجة لإضافة بوابات إضافية، يرجى التواصل مع إدارة النظام لترقية باقتك.
            </div>
        </div>
    }

    <!-- Toolbar: Search & Filter Tabs -->
    <div class="portal-card p-3 mb-4 shadow-sm">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="devSearchInput" class="form-control border-start-0" 
                           placeholder="ابحث باسم الجهاز، السيريال، أو عنوان الـ IP..." 
                           onkeyup="filterDevices()" />
                </div>
            </div>

            <div class="col-12 col-md-5">
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" name="statusFilter" id="filterAll" value="all" checked onchange="filterDevices()">
                    <label class="btn btn-sm btn-outline-secondary fw-semibold" for="filterAll">
                        الكل (@devList.Count)
                    </label>

                    <input type="radio" class="btn-check" name="statusFilter" id="filterActive" value="active" onchange="filterDevices()">
                    <label class="btn btn-sm btn-outline-success fw-semibold" for="filterActive">
                        النشطة (@activeCount)
                    </label>

                    <input type="radio" class="btn-check" name="statusFilter" id="filterDeleted" value="deleted" onchange="filterDevices()">
                    <label class="btn btn-sm btn-outline-danger fw-semibold" for="filterDeleted">
                        المحذوفة مؤقتاً (@deletedCount)
                    </label>
                </div>
            </div>

            <div class="col-12 col-md-2 text-md-end">
                <span class="text-muted small">
                    عرض <strong class="text-primary font-monospace" id="visibleDevCount">@devList.Count</strong> جهاز
                </span>
            </div>
        </div>
    </div>

    <!-- Devices Table Card -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        @if (!devList.Any())
        {
            <div class="text-center py-5">
                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary d-inline-block mb-3">
                    <i class="bi bi-router fs-2"></i>
                </div>
                <h5 class="fw-bold text-main mb-2">لا توجد أجهزة GoIP مسجلة بعد</h5>
                <p class="text-muted small mb-3">أضف بيانات جهاز GoIP الأول الخاص بك للبدء في تركيب وإدارة الشرائح.</p>
                @if (canAddMore)
                {
                    <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-bold">
                        <i class="bi bi-plus-circle-fill me-1"></i> إضافة أول جهاز الآن
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive table-responsive-custom">
                <table class="table table-custom align-middle mb-0" id="devMasterTable">
                    <thead>
                        <tr>
                            <th style="min-width: 220px;">اسم الجهاز</th>
                            <th style="min-width: 140px;">النوع والموديل</th>
                            <th style="min-width: 160px;">عنوان IP والمنفذ</th>
                            <th style="min-width: 120px;">حالة الاتصال والتشغيل</th>
                            <th style="min-width: 150px;">المنافذ والشرائح</th>
                            <th class="text-center" style="min-width: 170px;">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="devTableBody">
                        @foreach (var td in devList)
                        {
                            var dev = td.Device;
                            if (dev == null) continue;

                            var isDel = dev.IsDelete;
                            var devActiveSims = dev.Ports?.Count(p => p.SimCard != null && p.SimCard.IsActive && !p.SimCard.IsDelete) ?? 0;
                            var searchKeywords = $"{dev.DeviceName} {dev.SerialNumber} {dev.IpAddress} {dev.DeviceType} {dev.Location} {dev.MerchantCode}".ToLower();

                            <tr class="dev-row @(isDel ? "table-danger bg-opacity-10 opacity-75" : "")" 
                                data-search="@searchKeywords" 
                                data-status="@(isDel ? "deleted" : "active")">
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="row-avatar @(isDel ? "bg-danger bg-opacity-10 text-danger" : "")" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                            <i class="bi @(isDel ? "bi-trash3" : "bi-router")"></i>
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-1.5">
                                                <a asp-action="Details" asp-route-id="@dev.Id" class="fw-bold text-main text-decoration-none hover-primary @(isDel ? "text-decoration-line-through text-muted" : "")">
                                                    @dev.DeviceName
                                                </a>
                                                @if (isDel)
                                                {
                                                    <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 fs-9 py-0.5 px-1.5 rounded-pill">
                                                        محذوف
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-1 mt-0.5 flex-wrap">
                                                <small class="text-muted font-monospace fs-8">SN: @(dev.SerialNumber ?? "N/A")</small>
                                                @if (!string.IsNullOrWhiteSpace(dev.MerchantCode))
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 font-monospace fs-9 py-0.5 px-1.5" title="كود التاجر الافتراضي لجهاز GoIP (يُستخدم لاستبدال {MerchantCode} في الـ USSD)">
                                                        <i class="bi bi-shop me-0.5"></i> كود: @dev.MerchantCode
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(dev.Location))
                                            {
                                                <small class="text-muted d-block fs-9"><i class="bi bi-geo-alt me-0.5"></i>@dev.Location</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="pill-badge pill-badge-neutral font-monospace">
                                        @dev.DeviceType
                                    </span>
                                </td>
                                <td>
                                    <code class="text-primary font-monospace fw-bold">@dev.IpAddress:@dev.Port</code>
                                </td>
                                <td>
                                    @if (isDel)
                                    {
                                        <span class="pill-badge pill-badge-danger">
                                            <i class="bi bi-slash-circle me-1"></i>معطل (محذوف)
                                        </span>
                                    }
                                    else if (dev.IsOnline)
                                    {
                                        <span class="pill-badge pill-badge-success">
                                            <span class="dot-indicator"></span>متصل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill-badge pill-badge-danger">
                                            <span class="dot-indicator"></span>غير متصل
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-main font-monospace">@devActiveSims / @dev.TotalPorts <small class="text-muted fw-normal">منافذ نشطة</small></div>
                                </td>
                                <td class="text-center">
                                    @if (isDel)
                                    {
                                        <!-- Soft Deleted State: Show Restore Button Only -->
                                        <form asp-action="Restore" asp-route-id="@dev.Id" method="post" class="d-inline"
                                              data-confirm="true"
                                              data-confirm-title="استعادة جهاز GoIP"
                                              data-confirm-message="هل تريد استعادة هذا الجهاز وإعادة تفعيله بالمنظومة؟"
                                              data-confirm-detail="@dev.DeviceName (IP: @dev.IpAddress)"
                                              data-confirm-detail-label="الجهاز:"
                                              data-confirm-consequence="ستتم استعادة الجهاز ومنافذه وستتمكن الشركة من استخدامه مجدداً."
                                              data-confirm-btn="نعم، استعادة الجهاز"
                                              data-confirm-type="success">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-restore-pill fw-bold d-inline-flex align-items-center gap-1.5 shadow-sm">
                                                <i class="bi bi-arrow-counterclockwise fs-6"></i>
                                                <span>استعادة الجهاز</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <!-- Active State: Unified Action Pill Group -->
                                        <div class="actions-pill-group justify-content-center">
                                            <!-- Action 1: View Matrix / Details -->
                                            <a asp-action="Details" asp-route-id="@dev.Id" class="action-pill-btn action-pill-primary" title="عرض مصفوفة البورتات اللحظية">
                                                <i class="bi bi-grid-3x3-gap-fill"></i>
                                                <span>المصفوفة</span>
                                            </a>

                                            <!-- Action 2: Quick Edit Device -->
                                            <a asp-action="Edit" asp-route-id="@dev.Id" class="action-pill-btn action-pill-warning" title="تعديل بيانات الجهاز">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Action 3: Dropdown More Actions -->
                                            <div class="dropdown d-inline-block">
                                                <button class="action-pill-btn action-pill-more dropdown-toggle-no-caret" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="المزيد من الخيارات">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions shadow-lg border-0 rounded-3 p-2">
                                                    <li>
                                                        <a class="dropdown-item py-2 rounded-2 fw-semibold" asp-area="Company" asp-controller="SimCards" asp-action="Index">
                                                            <i class="bi bi-sim text-primary me-2 fs-6"></i>إدارة الشرائح المركبة
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item py-2 rounded-2 fw-semibold" asp-action="Details" asp-route-id="@dev.Id">
                                                            <i class="bi bi-cpu text-info me-2 fs-6"></i>فحص حالة الهاردوير
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    <li>
                                                        <form asp-action="Delete" asp-route-id="@dev.Id" method="post"
                                                              data-confirm="true"
                                                              data-confirm-title="نقل الجهاز لسلة المحذوفات"
                                                              data-confirm-message="هل أنت متأكد من حذف هذا الجهاز ونقله إلى سلة المحذوفات؟"
                                                              data-confirm-detail="@dev.DeviceName (IP: @dev.IpAddress)"
                                                              data-confirm-detail-label="الجهاز:"
                                                              data-confirm-consequence="سيتم إيقاف تشغيل الجهاز وتعطيل منافذه مؤقتاً، ويمكنك استعادته في أي وقت."
                                                              data-confirm-btn="نعم، حذف الجهاز مؤقتاً"
                                                              data-confirm-type="danger">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item py-2 rounded-2 fw-semibold text-danger border-0 bg-transparent w-100 text-start">
                                                                <i class="bi bi-trash3 text-danger me-2 fs-6"></i>حذف الجهاز (تعطيل مؤقت)
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterDevices() {
            const query = (document.getElementById('devSearchInput')?.value || '').trim().toLowerCase();
            const selectedFilter = document.querySelector('input[name="statusFilter"]:checked')?.value || 'all';
            const rows = document.querySelectorAll('.dev-row');
            let visible = 0;

            rows.forEach(row => {
                const rowSearch = row.getAttribute('data-search') || '';
                const rowStatus = row.getAttribute('data-status') || 'active';

                const matchesQuery = !query || rowSearch.includes(query);
                const matchesStatus = (selectedFilter === 'all') || (selectedFilter === rowStatus);

                if (matchesQuery && matchesStatus) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleDevCount');
            if (countEl) countEl.innerText = visible;
        }
    </script>
}
