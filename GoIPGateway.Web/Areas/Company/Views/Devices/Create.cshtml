@model GoIPGateway.Domain.Entities.Device
@{
    var tenant = ViewBag.Tenant as GoIPGateway.Domain.Entities.Tenant;
    int currentCount = ViewBag.CurrentCount ?? 0;
    int maxDevices = ViewBag.MaxDevices ?? 1;
    ViewData["Title"] = "إضافة جهاز GoIP جديد";
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">أجهزة GoIP</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">إضافة جهاز جديد</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-plus-circle-fill"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">إضافة جهاز GoIP جديد لحسابك</h4>
                    <div class="text-muted small">
                        المتبقي في باقتك: <strong class="text-primary">@(maxDevices - currentCount) أجهزة</strong> 
                        (مستخدم @currentCount من أصل @maxDevices)
                    </div>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-arrow-right me-1"></i> العودة للأجهزة
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="portal-card p-4 shadow-sm mb-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold small">اسم الجهاز التعريفي <span class="text-danger">*</span></label>
                    <input type="text" name="DeviceName" class="form-control form-control-sm" placeholder="مثال: جهاز بورتات المحل الرئيسي أو GoIP 8 Port Server" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">نوع وموديل الجهاز <span class="text-danger">*</span></label>
                    <select name="DeviceType" class="form-select form-select-sm">
                        <option value="1">GoIP 1 Port (منفذ واحد)</option>
                        <option value="2" selected>GoIP 4 Ports (4 منافذ)</option>
                        <option value="3">GoIP 8 Ports (8 منافذ)</option>
                        <option value="4">GoIP 16 Ports (16 منفذ)</option>
                        <option value="5">GoIP 32 Ports (32 منفذ)</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">عنوان الـ IP للجهاز (داخل شبكتك أو IP ثابت) <span class="text-danger">*</span></label>
                    <input type="text" name="IpAddress" class="form-control form-control-sm font-monospace dir-ltr" value="192.168.1.100" placeholder="192.168.1.100" required />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small">منفذ الويب (HTTP Port) <span class="text-danger">*</span></label>
                    <input type="number" name="Port" class="form-control form-control-sm font-monospace" value="80" required />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small">منفذ Telnet</label>
                    <input type="number" name="TelnetPort" class="form-control form-control-sm font-monospace" value="23" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">اسم المستخدم للجهاز (Username)</label>
                    <input type="text" name="Username" class="form-control form-control-sm" value="admin" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">كلمة مرور الجهاز (Password)</label>
                    <input type="password" name="Password" class="form-control form-control-sm" value="admin" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold small">موقع الجهاز أو ملاحظات</label>
                    <input type="text" name="Location" class="form-control form-control-sm" placeholder="مثال: الفرع الرئيسي - غرفة الخوادم" />
                </div>

                <div class="col-12 text-end pt-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">إلغاء</a>
                    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 rounded-3 shadow">
                        <i class="bi bi-check-circle-fill me-1"></i> حفظ الجهاز وتوليد المنافذ
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
