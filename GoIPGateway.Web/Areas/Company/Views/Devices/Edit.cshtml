@model GoIPGateway.Domain.Entities.Device
@{
    ViewData["Title"] = $"تعديل جهاز: {Model.DeviceName}";
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">أجهزة GoIP</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">تعديل جهاز: @Model.DeviceName</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-warning bg-opacity-10 text-warning fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h4 class="fw-black mb-0 text-main">@Model.DeviceName</h4>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") px-2.5 py-1 rounded-pill">
                            @(Model.IsActive ? "نشط" : "معطل")
                        </span>
                        <span class="badge bg-light text-muted border font-monospace fs-8">
                            @Model.DeviceType (@Model.TotalPorts منفذ)
                        </span>
                    </div>
                    <div class="text-muted small">
                        تعديل إعدادات الربط وعنوان الشبكة وبيانات الاعتماد للبوابة
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-grid-3x3-gap me-1"></i> مصفوفة البورتات
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-arrow-right me-1"></i> العودة للأجهزة
                </a>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="portal-card p-4 shadow-sm mb-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DeviceType" />
            <input type="hidden" asp-for="TotalPorts" />

            <div class="row g-3">
                <!-- Device Name -->
                <div class="col-md-8">
                    <label class="form-label fw-bold small">اسم الجهاز التعريفي <span class="text-danger">*</span></label>
                    <input type="text" asp-for="DeviceName" class="form-control form-control-sm" placeholder="مثال: جهاز الفرع الرئيسي" required />
                    <span asp-validation-for="DeviceName" class="text-danger small"></span>
                </div>

                <!-- Active Status -->
                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check form-switch pt-4">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="isActiveSwitch">
                        <label class="form-check-label fw-bold small me-2" for="isActiveSwitch">الجهاز مفعل ويعمل</label>
                    </div>
                </div>

                <!-- IP Address -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">عنوان الـ IP للجهاز <span class="text-danger">*</span></label>
                    <input type="text" asp-for="IpAddress" class="form-control form-control-sm font-monospace dir-ltr" required />
                    <span asp-validation-for="IpAddress" class="text-danger small"></span>
                </div>

                <!-- HTTP Port -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small">منفذ الويب (HTTP Port) <span class="text-danger">*</span></label>
                    <input type="number" asp-for="Port" class="form-control form-control-sm font-monospace" min="1" max="65535" required />
                    <span asp-validation-for="Port" class="text-danger small"></span>
                </div>

                <!-- Telnet Port -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small">منفذ Telnet</label>
                    <input type="number" asp-for="TelnetPort" class="form-control form-control-sm font-monospace" min="1" max="65535" />
                </div>

                <!-- Username -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">اسم مستخدم الدخول للجهاز (Username)</label>
                    <input type="text" asp-for="Username" class="form-control form-control-sm" />
                </div>

                <!-- Password -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">كلمة مرور الجهاز (Password)</label>
                    <input type="password" asp-for="Password" class="form-control form-control-sm" placeholder="اتركه كما هو إذا لم ترغب في التغيير" />
                </div>

                <!-- Merchant Code -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">كود التاجر (MerchantCode) الخاص بالجهاز</label>
                    <input type="text" asp-for="MerchantCode" class="form-control form-control-sm font-monospace" placeholder="مثال: 123456 أو كود المحل" />
                    <small class="text-muted fs-9">يُقرأ تلقائياً لاستبدال <code>{MerchantCode}</code> في أوامر USSD في حال عدم إرساله من الـ API</small>
                </div>

                <!-- Location -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">موقع الجهاز</label>
                    <input type="text" asp-for="Location" class="form-control form-control-sm" placeholder="مثال: الفرع الرئيسي - غرفة السيرفرات" />
                </div>

                <!-- Serial Number (Read-only) -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">الرقم التسلسلي (SN)</label>
                    <input type="text" asp-for="SerialNumber" class="form-control form-control-sm font-monospace bg-light" readonly />
                </div>

                <!-- Notes -->
                <div class="col-12">
                    <label class="form-label fw-bold small">ملاحظات إضافية</label>
                    <textarea asp-for="Notes" class="form-control form-control-sm" rows="3" placeholder="أي ملاحظات تشغيلية خاصة بهذا الجهاز..."></textarea>
                </div>

                <!-- Action Buttons -->
                <div class="col-12 text-end pt-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">إلغاء</a>
                    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 rounded-3 shadow">
                        <i class="bi bi-check2-circle me-1"></i> حفظ تعديلات الجهاز
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
