@model GoIPGateway.Domain.Entities.Device
@{
    ViewData["Title"] = $"منافذ الجهاز: {Model.DeviceName}";
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">أجهزة GoIP</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">منافذ: @Model.DeviceName</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">@Model.DeviceName</h4>
                    <div class="text-muted small">
                        <span class="badge bg-primary bg-opacity-10 text-primary font-monospace">@Model.DeviceType</span>
                        <span class="ms-2 font-monospace">IP: @Model.IpAddress:@Model.Port</span>
                        <span class="ms-2">• إجمالي المنافذ: <strong>@Model.TotalPorts</strong></span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-area="Company" asp-controller="SimCards" asp-action="Create" class="btn btn-primary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-plus-circle-fill me-1"></i> تركيب شريحة جديدة
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-arrow-right me-1"></i> العودة للأجهزة
                </a>
            </div>
        </div>
    </div>

    <!-- Ports Grid / Table Card -->
    <div class="portal-card p-4 shadow-sm">
        <h5 class="fw-black mb-3 pb-2 border-bottom text-main">منافذ الجهاز والشرائح المركبة</h5>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light fs-8">
                    <tr>
                        <th style="width: 60px;" class="text-center">المنفذ</th>
                        <th>التسمية</th>
                        <th>حالة المنفذ</th>
                        <th>الشريحة المركبة</th>
                        <th>الشبكة</th>
                        <th>الرصيد الحالي</th>
                        <th class="text-center">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var port in Model.Ports.OrderBy(p => p.PortNumber))
                    {
                        var sim = port.SimCard;
                        <tr>
                            <td class="text-center fw-bold">
                                <span class="badge bg-secondary bg-opacity-10 text-main border">#@port.PortNumber</span>
                            </td>
                            <td class="font-monospace fw-bold">@port.PortLabel</td>
                            <td>
                                @if (sim != null)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success">
                                        <i class="bi bi-sim-fill me-1"></i> به شريحة
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-muted">فارغ</span>
                                }
                            </td>
                            <td>
                                @if (sim != null)
                                {
                                    <span class="fw-bold font-monospace text-primary">@sim.PhoneNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">لا توجد شريحة</span>
                                }
                            </td>
                            <td>
                                @if (sim != null)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@sim.Operator</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (sim != null)
                                {
                                    <span class="fw-bold text-success font-monospace">@sim.CurrentBalance.ToString("N2") ج.م</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (sim != null)
                                {
                                    <a asp-area="Company" asp-controller="SimCards" asp-action="Edit" asp-route-id="@sim.Id" class="btn btn-sm btn-outline-primary" title="تعديل الشريحة">
                                        <i class="bi bi-pencil"></i> تعديل الشريحة
                                    </a>
                                }
                                else
                                {
                                    <a asp-area="Company" asp-controller="SimCards" asp-action="Create" asp-route-portId="@port.Id" class="btn btn-sm btn-outline-success" title="تركيب شريحة">
                                        <i class="bi bi-plus-lg"></i> تركيب شريحة
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
