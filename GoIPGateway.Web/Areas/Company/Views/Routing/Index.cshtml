                            <i class="bi bi-tags-fill me-1"></i>التصنيف:
                        </label>
                        <div style="min-width: 150px; max-width: 210px;" class="flex-grow-1">
                            <select id="simServiceCatFilter" class="form-select form-select-sm searchable-select" data-searchable="true" onchange="applySimServicesFilters()" data-placeholder="التصنيف...">
