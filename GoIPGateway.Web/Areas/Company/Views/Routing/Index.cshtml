                                <option value="Payment" data-badge="@tenantServices.Count(ts => ts.ServiceDefinition?.Category == ServiceCategory.Payment)" data-badge-color="info" data-icon="bi-credit-card">دفع كاش</option>
                                <option value="Transfer" data-badge="@tenantServices.Count(ts => ts.ServiceDefinition?.Category == ServiceCategory.Transfer)" data-badge-color="primary" data-icon="bi-arrow-left-right">تحويل كاش</option>
                                <option value="BalanceInquiry" data-badge="@tenantServices.Count(ts => ts.ServiceDefinition?.Category == ServiceCategory.BalanceInquiry)" data-badge-color="secondary" data-icon="bi-search">استعلام رصيد</option>
                                <option value="NumberInquiry" data-badge="@tenantServices.Count(ts => ts.ServiceDefinition?.Category == ServiceCategory.NumberInquiry)" data-badge-color="warning" data-icon="bi-123">استعلام رقم</option>
                                <option value="Settlement" data-badge="@tenantServices.Count(ts => ts.ServiceDefinition?.Category == ServiceCategory.Settlement)" data-badge-color="success" data-icon="bi-receipt">تسوية وتحصيل</option>
                                <option value="Management" data-badge="@tenantServices.Count(ts => ts.ServiceDefinition?.Category == ServiceCategory.Management)" data-badge-color="secondary" data-icon="bi-gear">إدارة</option>
                            </select>
                        </div>
                    </div>

