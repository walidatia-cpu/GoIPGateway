        }

        function clearSimServiceSearch() {
            const input = document.getElementById('simServiceSearchInput');
            const clearBtn = document.getElementById('simServiceSearchClearBtn');
            if (input) input.value = '';
            if (clearBtn) clearBtn.classList.add('d-none');
            applySimServicesFilters();
            input?.focus();
        }

        function resetSimServicesFilters() {
            const input = document.getElementById('simServiceSearchInput');
            if (input) input.value = '';
            const clearBtn = document.getElementById('simServiceSearchClearBtn');
            if (clearBtn) clearBtn.classList.add('d-none');

            const catSelect = document.getElementById('simServiceCatFilter');
            if (catSelect) catSelect.value = 'ALL';

            const netSelect = document.getElementById('simServiceNetFilter');
            if (netSelect) netSelect.value = 'ALL';

            const assignSelect = document.getElementById('simServiceAssignFilter');
            if (assignSelect) assignSelect.value = 'ALL';

            applySimServicesFilters();
            showAutoSaveToast('تمت إعادة ضبط فلاتر الخدمات');
        }

        function applySimServicesFilters() {
            const query = (document.getElementById('simServiceSearchInput')?.value || '').trim().toLowerCase();
            const catFilter = document.getElementById('simServiceCatFilter')?.value || 'ALL';
            const netFilter = document.getElementById('simServiceNetFilter')?.value || 'ALL';
            const assignFilter = document.getElementById('simServiceAssignFilter')?.value || 'ALL';

            const sim = allSims.find(s => s.id === currentSimId);
            const assignedServices = simAssignments[currentSimId] || new Set();

            const allServicesList = Object.values(servicesMeta);

            filteredSimServices = allServicesList.filter(service => {
                // Category match
                if (catFilter !== 'ALL' && service.category !== catFilter) return false;

                // Network match
                if (netFilter === 'MATCHING_SIM' && sim) {
                    if (service.operator !== 'General' && service.operator !== sim.op) return false;
                } else if (netFilter !== 'ALL' && netFilter !== 'MATCHING_SIM') {
                    if (service.operator !== netFilter) return false;
                }

                // Assignment match
                const isAssigned = assignedServices.has(service.id);
                if (assignFilter === 'ASSIGNED' && !isAssigned) return false;
                if (assignFilter === 'UNASSIGNED' && isAssigned) return false;

                // Search query match
                if (query) {
                    const matchName = service.name && service.name.toLowerCase().includes(query);
                    const matchCode = service.code && service.code.toLowerCase().includes(query);
                    const matchCat = service.categoryLabel && service.categoryLabel.toLowerCase().includes(query);
                    const matchOp = service.operatorLabel && service.operatorLabel.toLowerCase().includes(query);
                    if (!matchName && !matchCode && !matchCat && !matchOp) return false;
                }

                return true;
            });

            renderSimServicesGrid();
        }

        function renderSimServicesGrid() {
            const tbody = document.getElementById('simServicesGridBody');
            const emptyPlaceholder = document.getElementById('simServicesEmptyPlaceholder');
            const lblVisible = document.getElementById('lblSimServicesVisibleCount');

            if (lblVisible) lblVisible.innerText = filteredSimServices.length.toLocaleString();

            if (filteredSimServices.length === 0) {
                if (tbody) tbody.innerHTML = '';
                if (emptyPlaceholder) emptyPlaceholder.classList.remove('d-none');
                return;
            } else {
                if (emptyPlaceholder) emptyPlaceholder.classList.add('d-none');
            }

            const assignedServices = simAssignments[currentSimId] || new Set();

            let html = '';
            for (let i = 0; i < filteredSimServices.length; i++) {
                const s = filteredSimServices[i];
                const isAssigned = assignedServices.has(s.id);

                // Other assigned SIMs count
                const otherSimsCount = serviceAssignments[s.id] ? serviceAssignments[s.id].size : 0;

                // Network badge
                let opBadgeClass = 'badge-op-vf';
                if (s.operator === 'Orange') opBadgeClass = 'badge-op-or';
                else if (s.operator === 'Etisalat') opBadgeClass = 'badge-op-et';
                else if (s.operator === 'WE') opBadgeClass = 'badge-op-we';
                else if (s.operator === 'General') opBadgeClass = 'bg-secondary bg-opacity-10 text-muted border';

                const rowAssignedClass = isAssigned ? 'table-row-assigned' : '';

                const assignBtnHtml = isAssigned
                    ? `<button type="button" class="btn-assign-action is-assigned" onclick="toggleSimServiceAssignment(${s.id}, false)" title="انقر لإلغاء تفعيل هذه الخدمة لهذا الخط">
                           <span class="state-active"><i class="bi bi-check-circle-fill me-1.5"></i>مفعلة على الخط</span>
                           <span class="state-hover"><i class="bi bi-x-circle-fill me-1.5"></i>إلغاء التفعيل</span>
                       </button>`
                    : `<button type="button" class="btn-assign-action is-unassigned" onclick="toggleSimServiceAssignment(${s.id}, true)" title="انقر لتفعيل وتعيين هذه الخدمة لهذا الخط">
                           <span class="state-active"><i class="bi bi-plus-circle me-1.5"></i>غير مفعلة</span>
                           <span class="state-hover"><i class="bi bi-check2 me-1.5"></i>+ تفعيل للخط</span>
                       </button>`;

                html += `
                    <tr class="grid-sim-row ${rowAssignedClass}" id="sim-srv-row-${s.id}">
                        <td class="sticky-col-1" id="sim-srv-col-${s.id}">
                            ${assignBtnHtml}
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary fs-6 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-main fs-7">${s.name}</div>
                                    <span class="badge bg-light text-primary border font-monospace fs-9">${s.code}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge ${opBadgeClass} fs-8 py-1 px-2.5 rounded-pill font-monospace fw-bold">
                                ${s.operatorLabel}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border fs-8 py-1 px-2.5 rounded-pill">
                                ${s.categoryLabel}
                            </span>
                        </td>
                        <td>
                            <div class="fs-8 fw-semibold text-main">${s.balanceImpact}</div>
                            <small class="text-muted fs-9">الرسوم الأساسية: ${s.baseCost.toFixed(2)} ج.م</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-primary border font-monospace fs-8" title="مسندة إلى ${otherSimsCount} خطوط في النظام">
                                <i class="bi bi-sim me-1"></i> ${otherSimsCount} خطوط مسندة
                            </span>
                        </td>
                        <td>
                            ${s.isActive 
                                ? '<span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 fs-9 py-1 px-2 rounded-pill">نشطة</span>' 
                                : '<span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 fs-9 py-1 px-2 rounded-pill">معطلة</span>'}
                        </td>
                    </tr>
                `;
            }

            if (tbody) tbody.innerHTML = html;
            if (typeof initTableScrollShadows === 'function') initTableScrollShadows();
        }

        async function toggleSimServiceAssignment(serviceId, assign) {
            const simSet = simAssignments[currentSimId] || new Set();
            const srvSet = serviceAssignments[serviceId] || new Set();

            if (assign) {
                simSet.add(serviceId);
                srvSet.add(currentSimId);
            } else {
                simSet.delete(serviceId);
                srvSet.delete(currentSimId);
            }

            // Optimistic UI update
            const row = document.getElementById('sim-srv-row-' + serviceId);
            const col = document.getElementById('sim-srv-col-' + serviceId);
            if (row) row.classList.toggle('table-row-assigned', assign);
            if (col) {
                col.innerHTML = assign
                    ? `<button type="button" class="btn-assign-action is-assigned" onclick="toggleSimServiceAssignment(${serviceId}, false)" title="انقر لإلغاء تفعيل هذه الخدمة لهذا الخط">
                           <span class="state-active"><i class="bi bi-check-circle-fill me-1.5"></i>مفعلة على الخط</span>
                           <span class="state-hover"><i class="bi bi-x-circle-fill me-1.5"></i>إلغاء التفعيل</span>
                       </button>`
                    : `<button type="button" class="btn-assign-action is-unassigned" onclick="toggleSimServiceAssignment(${serviceId}, true)" title="انقر لتفعيل وتعيين هذه الخدمة لهذا الخط">
                           <span class="state-active"><i class="bi bi-plus-circle me-1.5"></i>غير مفعلة</span>
                           <span class="state-hover"><i class="bi bi-check2 me-1.5"></i>+ تفعيل للخط</span>
                       </button>`;
            }

            updateSimHeroCard();
            updateCoverageKPI();

            const assignFilter = document.getElementById('simServiceAssignFilter')?.value;
            if (assignFilter && assignFilter !== 'ALL') {
                applySimServicesFilters();
            }

            try {
                const res = await fetch('/Company/Routing/ToggleSimServiceAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        simId: currentSimId,
                        serviceId: serviceId,
                        assign: assign
                    })
                });
                const data = await res.json();
                if (data.success) {
                    showAutoSaveToast(`تم ${assign ? 'تفعيل' : 'إلغاء تفعيل'} الخدمة للخط بنجاح (${data.count} خدمات مفعلة)`);
                } else {
                    // Revert
                    if (assign) {
                        simSet.delete(serviceId);
                        srvSet.delete(currentSimId);
                    } else {
                        simSet.add(serviceId);
                        srvSet.add(currentSimId);
                    }
                    updateSimHeroCard();
                    renderSimServicesGrid();
                    showAutoSaveToast(data.message || 'فشل حفظ التخصيص', false);
                }
            } catch (err) {
                console.error(err);
                if (assign) {
                    simSet.delete(serviceId);
                    srvSet.delete(currentSimId);
                } else {
                    simSet.add(serviceId);
                    srvSet.add(currentSimId);
                }
                updateSimHeroCard();
                renderSimServicesGrid();
                showAutoSaveToast('تعذر الاتصال بالخادم', false);
            }
        }

        // Batch Actions for SIM Services
        function assignAllMatchingOperatorServicesToSim() {
            const sim = allSims.find(s => s.id === currentSimId);
            if (!sim) return;

            const matchingServices = Object.values(servicesMeta).filter(s => s.operator === 'General' || s.operator === sim.op);
            if (matchingServices.length === 0) {
                showAlertModal({
                    title: 'لا توجد خدمات مطابقة',
                    message: `لا توجد خدمات مخصصة لشبكة ${sim.op} أو عامة في باقة الشركة.`,
                    type: 'warning'
                });
                return;
            }

            showConfirmModal({
                title: 'تخصيص كافة خدمات شبكة هذا الخط',
                message: `هل ترغب في تفعيل كافة الخدمات المطابقة لشبكة (${sim.op}) والخدمات العامة (${matchingServices.length} خدمة) لهذا الخط؟`,
                detail: `${sim.phoneNumber} - ${sim.deviceName}`,
                detailLabel: 'الخط المحدد:',
                btnText: `نعم، تفعيل (${matchingServices.length}) خدمة`,
                type: 'primary',
                onConfirm: () => performBatchSimServicesSave(matchingServices.map(s => s.id), true)
            });
        }

        function assignAllFilteredServicesToSim() {
            if (filteredSimServices.length === 0) {
                showAlertModal({
                    title: 'لا توجد خدمات',
                    message: 'لا توجد أي خدمات معروضة بالفلتر لتفعيلها.',
                    type: 'warning'
                });
                return;
            }

            const sim = allSims.find(s => s.id === currentSimId);
            const simSet = simAssignments[currentSimId] || new Set();
            const unionIds = new Set([...simSet, ...filteredSimServices.map(s => s.id)]);

            showConfirmModal({
                title: 'تخصيص كافة الخدمات المعروضة بالفلتر',
                message: `هل ترغب في تفعيل جميع الخدمات المعروضة بالفلتر (${filteredSimServices.length} خدمة) لهذا الخط؟`,
                detail: `${sim?.phoneNumber ?? ''}`,
                detailLabel: 'الخط المحدد:',
                btnText: `نعم، تفعيل (${filteredSimServices.length}) خدمة`,
                type: 'primary',
                onConfirm: () => performBatchSimServicesSave(Array.from(unionIds), false)
            });
        }

        function unassignAllServicesFromSim() {
            const sim = allSims.find(s => s.id === currentSimId);
            const currentCount = simAssignments[currentSimId]?.size || 0;

            if (currentCount === 0) {
                showAlertModal({
                    title: 'لا توجد خدمات مفعلة',
                    message: 'هذا الخط لا يحتوي على أي خدمات مفعلة حالياً.',
                    type: 'info'
                });
                return;
            }

            showConfirmModal({
                title: 'إلغاء تخصيص كافة الخدمات عن هذا الخط',
                message: `هل أنت متأكد من إلغاء تفعيل كافة الخدمات (${currentCount} خدمة) عن هذا الخط؟`,
                detail: `${sim?.phoneNumber ?? ''}`,
                detailLabel: 'الخط المحدد:',
                consequence: 'تنبيه: لن يتم توجيه أي عمليات إلى هذا الخط حتى إعادة تفعيل خدمات له.',
                btnText: 'نعم، إلغاء تفعيل كافة الخدمات',
                type: 'warning',
                onConfirm: () => performBatchSimServicesSave([], false)
            });
        }

        async function performBatchSimServicesSave(serviceIdsToSet, isMatchingOp) {
            const targetIds = Array.isArray(serviceIdsToSet) ? serviceIdsToSet : [];
            const previousSet = new Set(simAssignments[currentSimId] || []);

            // Optimistic update
            simAssignments[currentSimId] = new Set(targetIds);

            // Synchronize serviceAssignments
            Object.keys(serviceAssignments).forEach(sId => {
                const intSId = parseInt(sId);
                if (targetIds.includes(intSId)) {
                    serviceAssignments[sId].add(currentSimId);
                } else {
                    serviceAssignments[sId].delete(currentSimId);
                }
            });

            updateSimHeroCard();
            updateCoverageKPI();
            renderSimServicesGrid();

            showAutoSaveToast(`جاري حفظ ${targetIds.length} خدمة للخط...`);

            try {
                const res = await fetch('/Company/Routing/SetSimServicesAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        simId: currentSimId,
                        serviceIds: targetIds
                    })
                });
                const data = await res.json();
                if (data.success) {
                    showAutoSaveToast(`تم تحديث الخدمات المسندة للخط بنجاح (${targetIds.length} خدمة)`);
                } else {
                    // Revert
                    simAssignments[currentSimId] = previousSet;
                    updateSimHeroCard();
                    renderSimServicesGrid();
                    showAlertModal({
                        title: 'فشل حفظ التوجيه',
                        message: data.message || 'حدث خطأ أثناء حفظ التخصيص.',
                        type: 'danger'
                    });
                }
            } catch (err) {
                console.error(err);
                simAssignments[currentSimId] = previousSet;
                updateSimHeroCard();
                renderSimServicesGrid();
                showAlertModal({
                    title: 'خطأ اتصال بالخادم',
                    message: 'تعذر الاتصال بالخادم، يرجى إعادة المحاولة.',
                    type: 'danger'
                });
            }
        }
    </script>
}
