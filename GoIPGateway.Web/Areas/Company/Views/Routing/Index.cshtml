                           placeholder="ابحث باسم الخدمة، كود الـ API، أو التصنيف..." 
                           oninput="onSimServiceSearchChanged()" />
                    <button type="button" id="simServiceSearchClearBtn" class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted p-0 me-2 text-decoration-none d-none" onclick="clearSimServiceSearch()">
                        <i class="bi bi-x-circle-fill fs-7"></i>
                    </button>
                </div>

                <!-- Dropdown Filters -->
                <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
