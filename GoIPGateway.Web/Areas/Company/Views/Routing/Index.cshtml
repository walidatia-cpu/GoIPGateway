            <div class="position-relative flex-grow-1" style="min-width: 220px; max-width: 320px;">
                <span class="position-absolute top-50 translate-middle-y text-muted opacity-75" style="inset-inline-start: 14px; pointer-events: none;">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="gridSearchInput" class="form-control form-control-sm rounded-pill bg-body-tertiary border-0 shadow-none text-truncate" 
                       style="padding-inline-start: 38px; padding-inline-end: 34px;"
