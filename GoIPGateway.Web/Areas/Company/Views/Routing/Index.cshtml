        function onSimSelectionChange(newSimId) {
            currentSimId = parseInt(newSimId);
            updateSimHeroCard();
            applySimServicesFilters();
        }

        function updateSimHeroCard() {
            const sim = allSims.find(s => s.id === currentSimId);
            if (!sim) return;

            const lblPhone = document.getElementById('lblSimHeroPhone');
            const lblPort = document.getElementById('lblSimHeroPort');
            const statusBadge = document.getElementById('lblSimHeroStatusBadge');
            const fraction = document.getElementById('lblSimServicesFraction');
            const percentage = document.getElementById('lblSimServicesPercentage');
            const progressBar = document.getElementById('kpiSimProgressBar');
            const balanceSummary = document.getElementById('lblSimBalanceSummary');
            const opDesc = document.getElementById('lblSimOpDesc');

            if (lblPhone) lblPhone.innerText = sim.phoneNumber;
            if (lblPort) lblPort.innerText = `${sim.deviceName} (${sim.portLabel})`;

            const assignedServices = simAssignments[currentSimId] || new Set();
            const count = assignedServices.size;
            const totalServices = Object.keys(servicesMeta).length;
            const pct = totalServices > 0 ? Math.round((count / totalServices) * 100) : 0;

            if (fraction) fraction.innerText = `${count} / ${totalServices}`;
            if (percentage) percentage.innerText = `${pct}%`;

            if (progressBar) {
                progressBar.style.width = `${pct}%`;
                progressBar.setAttribute('aria-valuenow', pct);
                if (pct === 0) progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-secondary';
                else if (pct < 30) progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-warning';
                else progressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-success';
            }

            if (statusBadge) {
                if (!sim.isActive || sim.isBlocked) {
                    statusBadge.innerHTML = '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 fw-bold fs-9"><i class="bi bi-x-circle-fill me-1"></i> الخط معطل</span>';
                } else if (count > 0) {
                    statusBadge.innerHTML = '<span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 fw-bold fs-9"><i class="bi bi-check-circle-fill me-1"></i> جاهزة للتشغيل</span>';
                } else {
                    statusBadge.innerHTML = '<span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1 fw-bold fs-9"><i class="bi bi-exclamation-triangle-fill me-1"></i> لا توجد خدمات مسندة</span>';
                }
            }

            if (balanceSummary) {
                balanceSummary.innerHTML = `<i class="bi bi-wallet2 text-success me-1"></i> الرصيد: <b class="font-monospace text-main">${sim.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ج.م</b>`;
            }

            if (opDesc) {
                opDesc.innerHTML = `شبكة: <b class="text-main">${sim.op}</b>`;
            }
        }

