                       oninput="onSearchInputChanged()" />
                <button type="button" id="gridSearchClearBtn" class="btn btn-link text-muted position-absolute top-50 translate-middle-y p-0 d-none text-decoration-none" 
                        style="inset-inline-end: 12px;" onclick="clearSearchInput()" title="مسح كلمة البحث">
                    <i class="bi bi-x-circle-fill fs-7"></i>
                </button>
            </div>

            <!-- Dropdown Filters Group -->
            <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                <!-- Filter by Device -->
                <div class="d-inline-flex align-items-center gap-1.5 filter-dropdown-wrapper">
                    <label for="gridDeviceFilter" class="small fw-semibold text-muted text-nowrap mb-0 d-none d-xl-inline">
                        <i class="bi bi-router me-1"></i>الجهاز:
                    </label>
                    <div style="min-width: 150px; max-width: 220px;" class="flex-grow-1">
                        <select id="gridDeviceFilter" class="form-select form-select-sm searchable-select" data-searchable="true" onchange="onFilterChanged()" data-placeholder="اختر الجهاز...">
                            <option value="ALL" data-badge="@devices.Count" data-badge-color="primary" data-icon="bi-router">كل أجهزة GoIP</option>
                            @foreach (var dev in devices)
                            {
                                var devSimCount = sims.Count(s => s.DevicePort?.DeviceId == dev.Id);
                                var modelName = dev.DeviceType == DeviceType.GoIP512 ? "512P" : "128P";
                                <option value="@dev.Id" data-badge="@devSimCount خط" data-badge-color="secondary" data-icon="bi-cpu">@dev.DeviceName (@modelName)</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Operator Network Filter Dropdown -->
                <div class="d-inline-flex align-items-center gap-1.5 filter-dropdown-wrapper">
                    <label for="gridOpFilter" class="small fw-semibold text-muted text-nowrap mb-0 d-none d-xl-inline">
                        <i class="bi bi-broadcast-pin me-1"></i>الشبكة:
                    </label>
                    <div style="min-width: 150px; max-width: 200px;" class="flex-grow-1">
                        <select id="gridOpFilter" class="form-select form-select-sm searchable-select" data-searchable="true" onchange="onOperatorDropdownChanged(this.value)" data-placeholder="اختر الشبكة...">
                            <option value="ALL" data-badge="@totalSimsCount" data-badge-color="primary" data-icon="bi-globe2">كل الشبكات</option>
                            <option value="Vodafone" data-badge="@vfCount" data-badge-color="danger" data-icon="bi-broadcast">فودافون كاش</option>
                            <option value="Orange" data-badge="@orCount" data-badge-color="warning" data-icon="bi-broadcast">أورانج كاش</option>
                            <option value="Etisalat" data-badge="@etCount" data-badge-color="success" data-icon="bi-broadcast">اتصالات كاش</option>
                            <option value="WE" data-badge="@weCount" data-badge-color="purple" data-icon="bi-broadcast">وي باي WE</option>
                        </select>
                    </div>
                </div>

                <!-- Assignment Status Filter Dropdown -->
                <div class="d-inline-flex align-items-center gap-1.5 filter-dropdown-wrapper">
                    <label for="gridAssignFilter" class="small fw-semibold text-muted text-nowrap mb-0 d-none d-xl-inline">
                        <i class="bi bi-funnel-fill me-1"></i>التخصيص:
                    </label>
                    <div style="min-width: 150px; max-width: 200px;" class="flex-grow-1">
                        <select id="gridAssignFilter" class="form-select form-select-sm searchable-select" data-searchable="true" onchange="onAssignmentDropdownChanged(this.value)" data-placeholder="حالة التخصيص...">
                            <option value="ALL" data-icon="bi-layers">كل الشرائح</option>
                            <option value="ASSIGNED" data-badge-color="success" data-icon="bi-check-circle-fill">مخصصة للخدمة فقط</option>
                            <option value="UNASSIGNED" data-badge-color="secondary" data-icon="bi-dash-circle">غير مخصصة</option>
                        </select>
                    </div>
                </div>

                <!-- Page Size Density Selector -->
                <div style="min-width: 110px; max-width: 140px;">
                    <select id="gridPageSizeSelect" class="form-select form-select-sm searchable-select" data-searchable="false" onchange="onPageSizeChanged(this.value)" title="عدد الشرائح في الصفحة">
                        <option value="50">50 خط / ص</option>
                        <option value="100" selected>100 خط (الموصى به)</option>
                        <option value="250">250 خط</option>
                        <option value="500">500 خط</option>
                        <option value="ALL">عرض الكل</option>
                    </select>
                </div>

                <!-- Reset Button -->
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1 fs-8" onclick="resetAllFilters()" title="إعادة ضبط كافة الفلاتر والبحث">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span class="d-none d-sm-inline">إعادة ضبط</span>
                </button>
            </div>
        </div>

        <!-- Bottom Row: Quick Selection Tools & Visible Stats -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pt-3 border-top mt-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="text-muted small fw-bold me-1 d-flex align-items-center gap-1">
                    <i class="bi bi-lightning-charge text-warning"></i>
                    <span>تحديد سريع:</span>
                </span>
                <button type="button" class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5" onclick="selectAllFiltered()">
                    <i class="bi bi-check-all"></i>
                    <span>تحديد كل المعروض بالفلتر</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5" onclick="selectFilteredByOperatorMatch()">
                    <i class="bi bi-sim text-primary"></i>
                    <span>تحديد خطوط شبكة الخدمة</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold rounded-pill px-3 py-1.5 d-flex align-items-center gap-1.5" onclick="selectCurrentDeviceOnly()">
                    <i class="bi bi-router"></i>
                    <span>تحديد كامل الجهاز المختار</span>
                </button>
                <button type="button" id="btnQuickClearSelection" class="btn btn-sm btn-outline-danger fw-semibold rounded-pill px-3 py-1.5 d-none align-items-center gap-1.5" onclick="clearAllSelections()">
                    <i class="bi bi-x-circle"></i>
                    <span>إلغاء التحديد (<span id="lblClearSelCount">0</span>)</span>
                </button>
            </div>

            <div class="d-flex align-items-center gap-3 text-muted small">
                <div>
                    <span>المعروض: </span>
                    <b id="lblVisibleCount" class="text-main font-monospace fs-7">0</b>
                    <span> من أصل </span>
                    <b class="font-monospace">@totalSimsCount</b>
                    <span> خط</span>
                </div>
                <div class="vr" style="height: 18px;"></div>
                <div class="badge bg-light text-primary border px-3 py-1.5 rounded-pill font-monospace fw-bold fs-8" id="badgeSelectedCounter">
                    <i class="bi bi-check2-square me-1"></i> تم تحديد: <span id="lblSelectedCount">0</span>
                </div>
            </div>
        </div>
    </div>

    <!-- The High-Density Routing Data Grid -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        <div class="table-responsive table-responsive-custom">
            <table class="table table-custom table-sticky-dual align-middle mb-0" id="routingMasterGrid">
                <thead>
                    <tr>
                        <th style="width: 44px;" class="text-center sticky-col-1">
                            <input type="checkbox" id="masterGridCheckbox" class="form-check-input" onchange="toggleMasterCheckbox(this.checked)" title="تحديد / إلغاء تحديد الكل في هذه الصفحة" />
                        </th>
                        <th style="min-width: 135px;" class="sticky-col-2"><span class="d-none d-sm-inline">رقم الشريحة (المحفظة)</span><span class="d-sm-none">رقم الشريحة</span></th>
                        <th style="min-width: 175px;">التخصيص للخدمة</th>
                        <th style="min-width: 130px;">الشبكة</th>
                        <th style="min-width: 200px;">الجهاز والمنفذ</th>
                        <th style="min-width: 140px;">الرصيد الحالي</th>
                        <th style="min-width: 160px;">الاستهلاك / الحد اليومي</th>
                        <th style="min-width: 140px;">خدمات أخرى مسندة</th>
                        <th style="min-width: 90px;">حالة الخط</th>
                    </tr>
                </thead>
                <tbody id="routingGridBody">
                    <!-- Dynamic rendering by JS for high performance -->
                </tbody>
            </table>
        </div>

        <!-- Empty state placeholder -->
        <div id="gridEmptyPlaceholder" class="text-center py-5 d-none">
            <div class="p-3 rounded-circle bg-light d-inline-block mb-3">
                <i class="bi bi-funnel text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-main mb-1">لا توجد شرائح تطابق الفلاتر المحددة</h5>
            <p class="text-muted small">جرب تغيير كلمات البحث أو إعادة ضبط خيارات أجهزة GoIP والشبكات.</p>
            <button type="button" class="btn btn-outline-primary btn-sm rounded-3 fw-bold px-3 py-1.5" onclick="resetAllFilters()">
                <i class="bi bi-arrow-counterclockwise me-1"></i> إعادة ضبط كافة الفلاتر
            </button>
        </div>

        <!-- Grid Pagination Footer -->
        <div class="p-3 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-3" id="gridPaginationBar">
            <div class="text-muted small font-monospace">
                عرض الصفحات: <span id="lblPageInfo">الصفحة 1 من 1</span>
            </div>
            <div class="d-flex align-items-center gap-1.5" id="paginationButtons">
                <!-- Injected via JS -->
            </div>
        </div>
    </div>
    </div>
    <!-- ==================== END MODE 1: BY SERVICE PANEL ==================== -->

    <!-- ==================== MODE 2: BY SIM PANEL (التوجيه بحسب الخط والشريحة) ==================== -->
    <div id="routingPanelBySim" class="@(activeTab == "bySim" ? "" : "d-none")">
        <!-- SIM Hero & Coverage Banner -->
        <div class="portal-card service-hero-card p-4 mb-4 shadow-sm">
            <div class="row g-4 align-items-center">
                <!-- SIM Card Selector & Info -->
                <div class="col-12 col-xl-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success bg-opacity-10 text-success px-2.5 py-1 rounded-pill fw-bold fs-8">
                            <i class="bi bi-sim me-1"></i> الشريحة والخط المستهدف للتوجيه
                        </span>
                        <span class="text-muted small">اختر الشريحة لتحديد وتعيين الخدمات المصرح بتنفيذها عليها فورياً</span>
                    </div>

                    <!-- Searchable SIM Selector Combobox -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="flex-grow-1" style="min-width: 250px;">
                            <select id="simRoutingSelect" class="form-select form-select-lg searchable-select" data-searchable="true" onchange="onSimSelectionChange(this.value)" data-placeholder="ابحث برقم الشريحة أو الجهاز...">
                                @foreach (var s in sims)
                                {
                                    var dev = s.DevicePort?.Device;
                                    var isSel = (s.Id == activeSimId);
                                    var opBadgeColor = s.Operator switch {
                                        OperatorType.Vodafone => "danger",
                                        OperatorType.Orange => "warning",
                                        OperatorType.Etisalat => "success",
                                        OperatorType.WE => "purple",
                                        _ => "secondary"
                                    };
                                    <option value="@s.Id" selected="@(isSel ? "selected" : null)" 
                                            data-badge="@s.Operator.ToString()" 
                                            data-badge-color="@opBadgeColor"
                                            data-icon="bi-sim">
                                        @s.PhoneNumber - @(dev?.DeviceName ?? "N/A") (@(s.DevicePort?.PortLabel ?? $"#{s.DevicePort?.PortNumber}")) - رصيد: @s.CurrentBalance.ToString("N2") ج.م
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- SIM KPI Coverage & Balance Box -->
                <div class="col-12 col-xl-6">
                    <div class="service-kpi-box">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-2 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold fs-5 text-main font-monospace" id="lblSimHeroPhone">@(activeSim?.PhoneNumber ?? "---")</span>
                                <span class="badge bg-light text-primary border fs-8 font-monospace" id="lblSimHeroPort">@(activeSim?.DevicePort?.PortLabel ?? "---")</span>
                            </div>
                            <div id="lblSimHeroStatusBadge">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 fw-bold fs-9">
                                    <i class="bi bi-check-circle-fill me-1"></i> جاهزة للتشغيل
                                </span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="text-muted small fw-semibold">
                                <i class="bi bi-diagram-3-fill me-1 text-primary"></i> الخدمات المسندة لهذا الخط:
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-6 fw-bold text-main font-monospace" id="lblSimServicesFraction">0 / @tenantServices.Count</span>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill font-monospace fw-bold" id="lblSimServicesPercentage">0%</span>
                            </div>
                        </div>

                        <div class="progress mb-2" style="height: 9px; border-radius: 9999px; background: rgba(148, 163, 184, 0.18);">
                            <div id="kpiSimProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center text-muted fs-8">
                            <div id="lblSimBalanceSummary" class="text-truncate">
                                <i class="bi bi-wallet2 text-success me-1"></i> الرصيد: <b class="font-monospace text-main">@(activeSim?.CurrentBalance.ToString("N2") ?? "0.00") ج.م</b>
                            </div>
                            <div class="text-nowrap" id="lblSimOpDesc">
                                شبكة: <b class="text-main">@(activeSim?.Operator.ToString() ?? "---")</b>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- By-SIM Filters Command Center Card -->
