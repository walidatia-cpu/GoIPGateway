@model GoIPGateway.Web.Models.ExecuteServiceViewModel
@{
    ViewData["Title"] = "تنفيذ وتجربة عملية فورية";

    var servicesList = Model.Services?.ToList() ?? new List<GoIPGateway.Domain.Entities.ServiceDefinition>();
    var totalServices = servicesList.Count;

    // Grouping by Category Standard
    var paymentServices = servicesList.Where(s => s.Category == GoIPGateway.Domain.Enums.ServiceCategory.Payment || s.Category == GoIPGateway.Domain.Enums.ServiceCategory.Transfer).ToList();
    var balanceServices = servicesList.Where(s => s.Category == GoIPGateway.Domain.Enums.ServiceCategory.Inquiry || s.Category == GoIPGateway.Domain.Enums.ServiceCategory.BalanceInquiry).ToList();
    var numberServices = servicesList.Where(s => s.Category == GoIPGateway.Domain.Enums.ServiceCategory.NumberInquiry).ToList();
    var otherServices = servicesList.Except(paymentServices).Except(balanceServices).Except(numberServices).ToList();

    // Egyptian Operators counts
    int vfCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Vodafone);
    int orCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Orange);
    int etCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Etisalat);
    int weCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.WE);

    // Check for Execution Result from TempData
    var executionResultJson = TempData["ExecutionResultJson"] as string;
    GoIPGateway.Application.DTOs.TransactionResultDto? execResult = null;
    if (!string.IsNullOrEmpty(executionResultJson))
    {
        try { execResult = System.Text.Json.JsonSerializer.Deserialize<GoIPGateway.Application.DTOs.TransactionResultDto>(executionResultJson); }
        catch { }
    }
}

<style>
    .exec-service-card {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        border-width: 2px !important;
        border-radius: 14px;
    }
    .exec-service-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08) !important;
    }
    .exec-service-card.card-selected {
        border-color: var(--primary-accent) !important;
        background-color: rgba(13, 110, 253, 0.06) !important;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.18) !important;
    }
    .filter-pill.active, .filter-cat-pill.active {
        background-color: var(--primary-accent) !important;
        color: #fff !important;
        border-color: var(--primary-accent) !important;
    }
    .category-section-title {
        background: rgba(13, 110, 253, 0.04);
        border-radius: 10px;
        padding: 8px 14px;
        margin-bottom: 12px;
        border-right: 4px solid var(--primary-accent);
    }
    .goip-terminal {
        background-color: #0f172a;
        color: #38bdf8;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        border-radius: 10px;
        padding: 16px;
        direction: ltr;
        text-align: left;
        overflow-x: auto;
    }
    .result-badge-pulse {
        animation: pulseAnimation 2s infinite;
    }
    @@keyframes pulseAnimation {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.85; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-11 col-xl-10">

        <!-- Live / Flash Execution Result Banner -->
        <div id="liveAjaxResultContainer"></div>

        @if (execResult != null)
        {
            var isSuccess = execResult.IsSuccess;
            var alertBorder = isSuccess ? "border-success" : "border-danger";
            var headerBg = isSuccess ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger";

            <div class="portal-card p-4 mb-4 shadow border @alertBorder rounded-4 position-relative" id="staticExecResultCard">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" onclick="document.getElementById('staticExecResultCard').remove()"></button>
                
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <div class="p-3 rounded-circle @headerBg fs-2 d-flex align-items-center justify-content-center result-badge-pulse" style="width: 54px; height: 54px;">
                        <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold mb-0 @(isSuccess ? "text-success" : "text-danger")">
                                @(isSuccess ? "تم تنفيذ العملية بنجاح عبر أجهزة GoIP" : "فشل تنفيذ العملية على بوابة GoIP")
                            </h4>
                            <span class="badge @(isSuccess ? "bg-success" : "bg-danger") font-monospace">@execResult.Status</span>
                        </div>
                        <div class="text-muted small mt-1">
                            رقم المرجع: <strong class="text-dark font-monospace">@execResult.TransactionRef</strong> 
                            | التوقيت: <span class="font-monospace">@execResult.CompletedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                    </div>
                </div>

                <!-- Metrics & SIM Info -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted fs-8 d-block mb-1">الخط والمنفذ المستخدم (GoIP Port):</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary rounded-pill">منفذ #@(execResult.PortNumber?.ToString() ?? "Auto")</span>
                                <strong class="font-monospace text-dark">@(execResult.SimPhoneNumber ?? "شريحة تلقائية")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted fs-8 d-block mb-1">رصيد الشريحة قبل / بعد:</span>
                            <div class="d-flex align-items-center gap-2 font-monospace">
                                <span>@(execResult.SimBalanceBefore?.ToString("N2") ?? "--")</span>
                                <i class="bi bi-arrow-left text-muted"></i>
                                <strong class="text-success">@(execResult.SimBalanceAfter?.ToString("N2") ?? "--") ج.م</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted fs-8 d-block mb-1">رسالة النظام النهائية:</span>
                            <strong class="text-main fs-8 d-block text-truncate" title="@execResult.Message">
                                @(execResult.Message ?? "تم استلام الرد من الشبكة بنجاح")
                            </strong>
                        </div>
                    </div>
                </div>

                <!-- GoIP Raw Terminal View -->
                @if (!string.IsNullOrEmpty(execResult.RawResponse))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted d-flex align-items-center gap-1">
                            <i class="bi bi-terminal"></i> استجابة جهاز GoIP المباشرة (Raw USSD Output):
                        </label>
                        <div class="goip-terminal">
                            <div class="text-muted small mb-1" style="color: #64748b !important;">[GoIP-128 Port @(execResult.PortNumber?.ToString() ?? "Line") &gt;&gt; Network Response]:</div>
                            <div class="text-light">@execResult.RawResponse</div>
                        </div>
                    </div>
                }

                <!-- Trace Logs Table -->
                @if (execResult.Logs != null && execResult.Logs.Any())
                {
                    <div>
                        <label class="form-label fw-bold small text-muted d-flex align-items-center gap-1">
                            <i class="bi bi-list-check"></i> تفاصيل خطوات الـ USSD المنفذة:
                        </label>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0 fs-8 bg-white">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>الخطوة</th>
                                        <th>الأمر المرسل للجهاز</th>
                                        <th>استجابة الشبكة</th>
                                        <th style="width: 80px;">الزمن</th>
                                        <th style="width: 80px;">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in execResult.Logs)
                                    {
                                        <tr>
                                            <td class="text-center font-monospace">@log.StepOrder</td>
                                            <td>@(log.StepName ?? $"خطوة {log.StepOrder}")</td>
                                            <td><code class="text-primary font-monospace">@log.Command</code></td>
                                            <td><small class="text-muted">@log.Response</small></td>
                                            <td class="font-monospace text-center">@(log.DurationMs)ms</td>
                                            <td class="text-center">
                                                <span class="badge @(log.IsSuccess ? "bg-success" : "bg-danger")">
                                                    @(log.IsSuccess ? "ناجحة" : "فشل")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="portal-card p-4 p-md-5 mb-4 shadow-sm">
            <!-- Header -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--card-border);">
                <div class="p-3 rounded-4 bg-warning bg-opacity-15 text-warning fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1">تنفيذ وتجربة العمليات الفورية</h3>
                    <p class="text-muted small mb-0">اختر الخدمة، واملأ الحقول المطلوبة ديناميكياً لتنفيذها ومحاكاتها لحظياً عبر أجهزة وسيرفر GoIP</p>
                </div>
            </div>

            <form asp-action="Execute" method="post" id="executeForm" onsubmit="showExecutingState()">
                @Html.AntiForgeryToken()

                <!-- Step 1: Operation Selection with Search & Unified Filters -->
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label fw-bold fs-5 mb-0 d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-pill px-2.5 py-1">1</span>
                            <span>اختر نوع العملية والخدمة المطلوبة:</span>
                        </label>
                        <div class="text-muted small">
                            عرض <strong class="text-primary font-monospace" id="execVisibleCount">@totalServices</strong> من @totalServices خدمة
                        </div>
                    </div>

                    <!-- Filter & Search Toolbar for Services -->
                    <div class="p-3 rounded-3 bg-light border mb-4">
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="execSearchInput" class="form-control border-start-0" placeholder="ابحث باسم الخدمة، الكود (مثل QR_PAY أو VF_PAY)، أو الشبكة..." onkeyup="filterExecServices()" />
                                </div>
                            </div>
                        </div>

                        <!-- Network Filters -->
                        <div class="d-flex flex-wrap align-items-center gap-1.5 mb-2">
                            <span class="text-muted fs-8 fw-bold me-1">الشبكة:</span>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill filter-pill active" data-op="ALL" onclick="filterExecByOp(this, 'ALL')">
                                كل الشبكات (@totalServices)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-danger rounded-pill filter-pill" data-op="Vodafone" onclick="filterExecByOp(this, 'Vodafone')">
                                🔴 فودافون كاش (@vfCount)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill filter-pill" data-op="Orange" onclick="filterExecByOp(this, 'Orange')">
                                🟠 أورانج كاش (@orCount)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-success rounded-pill filter-pill" data-op="Etisalat" onclick="filterExecByOp(this, 'Etisalat')">
                                🟢 اتصالات كاش (@etCount)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill filter-pill" data-op="WE" onclick="filterExecByOp(this, 'WE')">
                                🟣 وي باي WE (@weCount)
                            </button>
                        </div>

                        <!-- Category Filters -->
                        <div class="d-flex flex-wrap align-items-center gap-1.5 pt-1 border-top">
                            <span class="text-muted fs-8 fw-bold me-1">التصنيف:</span>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill filter-cat-pill active" data-cat="ALL" onclick="filterExecByCat(this, 'ALL')">
                                كل التصنيفات (@totalServices)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill filter-cat-pill" data-cat="Payment" onclick="filterExecByCat(this, 'Payment')">
                                💳 دفع وتحويل كاش (@paymentServices.Count)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info rounded-pill filter-cat-pill" data-cat="Inquiry" onclick="filterExecByCat(this, 'Inquiry')">
                                🔍 استعلام رصيد (@balanceServices.Count)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-warning text-dark rounded-pill filter-cat-pill" data-cat="NumberInquiry" onclick="filterExecByCat(this, 'NumberInquiry')">
                                📱 استعلام رقم (@numberServices.Count)
                            </button>
                        </div>
                    </div>

                    @if (!servicesList.Any())
                    {
                        <div class="text-center py-5 text-muted border rounded-3 bg-light">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            لا توجد خدمات مفعلة لحساب شركتك حالياً. يرجى مراجعة إدارة النظام لتفعيل الخدمات المطلوبة.
                        </div>
                    }
                    else
                    {
                        <!-- Helper Local Functions -->
                        @functions {
                            string GetExecOpArabic(GoIPGateway.Domain.Enums.OperatorType? op) => op switch
                            {
                                GoIPGateway.Domain.Enums.OperatorType.Vodafone => "فودافون كاش",
                                GoIPGateway.Domain.Enums.OperatorType.Orange => "أورانج كاش",
                                GoIPGateway.Domain.Enums.OperatorType.Etisalat => "اتصالات كاش",
                                GoIPGateway.Domain.Enums.OperatorType.WE => "وي باي WE",
                                _ => "عامة"
                            };

                            string GetExecOpBadgeClass(GoIPGateway.Domain.Enums.OperatorType? op) => op switch
                            {
                                GoIPGateway.Domain.Enums.OperatorType.Vodafone => "badge-op-vodafone",
                                GoIPGateway.Domain.Enums.OperatorType.Orange => "badge-op-orange",
                                GoIPGateway.Domain.Enums.OperatorType.Etisalat => "badge-op-etisalat",
                                GoIPGateway.Domain.Enums.OperatorType.WE => "badge-op-we",
                                _ => "bg-secondary"
                            };

                            string GetExecCatArabic(GoIPGateway.Domain.Enums.ServiceCategory cat) => cat switch
                            {
                                GoIPGateway.Domain.Enums.ServiceCategory.Payment => "دفع تاجر",
                                GoIPGateway.Domain.Enums.ServiceCategory.Transfer => "تحويل كاش",
                                GoIPGateway.Domain.Enums.ServiceCategory.Inquiry => "استعلام رصيد",
                                GoIPGateway.Domain.Enums.ServiceCategory.NumberInquiry => "استعلام رقم",
                                _ => cat.ToString()
                            };

                            string GetExecBorderClass(GoIPGateway.Domain.Enums.OperatorType? op) => op switch
                            {
                                GoIPGateway.Domain.Enums.OperatorType.Vodafone => "border-danger border-opacity-25",
                                GoIPGateway.Domain.Enums.OperatorType.Orange => "border-warning border-opacity-50",
                                GoIPGateway.Domain.Enums.OperatorType.Etisalat => "border-success border-opacity-25",
                                GoIPGateway.Domain.Enums.OperatorType.WE => "border-secondary border-opacity-50",
                                _ => "border-secondary border-opacity-25"
                            };

                            string BuildParamsJson(GoIPGateway.Domain.Entities.ServiceDefinition s)
                            {
                                var pars = s.Parameters?.Where(p => p.IsActive).OrderBy(p => p.SortOrder).Select(p => new
                                {
                                    key = p.ParameterKey,
                                    name = p.DisplayNameAr ?? p.ParameterName,
                                    type = p.DataType.ToString(),
                                    required = p.IsRequired,
                                    defaultValue = p.DefaultValue ?? ""
                                }).ToList() ?? new();
                                return System.Text.Json.JsonSerializer.Serialize(pars);
                            }
                        }

                        <!-- GROUP 1: PAYMENT & TRANSFER -->
                        @if (paymentServices.Any())
                        {
                            <div class="exec-category-group mb-4" id="exec-group-payment">
                                <div class="category-section-title d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">💳</span>
                                        <strong class="text-main">عمليات الدفع والتحويل المالي</strong>
                                    </div>
                                    <span class="badge bg-primary bg-opacity-10 text-primary font-monospace fs-8">@paymentServices.Count عمليات</span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var srv in paymentServices)
                                    {
                                        var opStr = srv.Operator?.ToString() ?? "ALL";
                                        var opArabic = GetExecOpArabic(srv.Operator);
                                        var opBadgeClass = GetExecOpBadgeClass(srv.Operator);
                                        var catArabic = GetExecCatArabic(srv.Category);
                                        var borderClass = GetExecBorderClass(srv.Operator);
                                        var searchStr = $"{srv.NameAr} {srv.NameEn} {srv.ServiceCode} {opArabic} {catArabic} {opStr}".ToLower();
                                        var paramsJson = BuildParamsJson(srv);

                                        <div class="col-12 col-md-6 exec-service-item" 
                                             data-op="@opStr" 
                                             data-cat="Payment" 
                                             data-search="@searchStr">
                                            <div class="p-3 border h-100 exec-service-card @borderClass bg-white position-relative" 
                                                 id="card_srv_@srv.ServiceCode"
                                                 data-params='@paramsJson'
                                                 onclick="selectExecuteCard('@srv.ServiceCode', 'Payment')">
                                                <input type="radio" 
                                                       class="btn-check" 
                                                       name="serviceCode" 
                                                       id="srv_@srv.ServiceCode" 
                                                       value="@srv.ServiceCode" 
                                                       data-cat="Payment"
                                                       required />
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi @(string.IsNullOrEmpty(srv.IconClass) ? "bi-credit-card-2-front" : srv.IconClass)"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="fw-bold mb-0 text-main">@srv.NameAr</h6>
                                                            @if (!string.IsNullOrEmpty(srv.NameEn))
                                                            {
                                                                <small class="text-muted" style="font-size: 0.78rem;">@srv.NameEn</small>
                                                            }
                                                        </div>
                                                    </div>
                                                    <span class="badge @opBadgeClass px-2 py-1 rounded-pill fs-8">
                                                        @opArabic
                                                    </span>
                                                </div>

                                                @if (!string.IsNullOrEmpty(srv.Description))
                                                {
                                                    <p class="text-muted small mb-2" style="font-size: 0.82rem;">@srv.Description</p>
                                                }

                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top fs-8 text-muted">
                                                    <span class="badge bg-light text-dark font-monospace border">@srv.ServiceCode</span>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">@catArabic</span>
                                                    <span>الرسوم: <strong class="text-primary font-monospace">@srv.BaseCost.ToString("N2") ج.م</strong></span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- GROUP 2: BALANCE INQUIRY -->
                        @if (balanceServices.Any())
                        {
                            <div class="exec-category-group mb-4" id="exec-group-inquiry">
                                <div class="category-section-title d-flex justify-content-between align-items-center" style="border-right-color: #0dcaf0;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">🔍</span>
                                        <strong class="text-main">عمليات استعلام الرصيد</strong>
                                    </div>
                                    <span class="badge bg-info bg-opacity-10 text-info font-monospace fs-8">@balanceServices.Count عمليات</span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var srv in balanceServices)
                                    {
                                        var opStr = srv.Operator?.ToString() ?? "ALL";
                                        var opArabic = GetExecOpArabic(srv.Operator);
                                        var opBadgeClass = GetExecOpBadgeClass(srv.Operator);
                                        var catArabic = GetExecCatArabic(srv.Category);
                                        var borderClass = GetExecBorderClass(srv.Operator);
                                        var searchStr = $"{srv.NameAr} {srv.NameEn} {srv.ServiceCode} {opArabic} {catArabic} {opStr}".ToLower();
                                        var paramsJson = BuildParamsJson(srv);

                                        <div class="col-12 col-md-6 exec-service-item" 
                                             data-op="@opStr" 
                                             data-cat="Inquiry" 
                                             data-search="@searchStr">
                                            <div class="p-3 border h-100 exec-service-card @borderClass bg-white position-relative" 
                                                 id="card_srv_@srv.ServiceCode"
                                                 data-params='@paramsJson'
                                                 onclick="selectExecuteCard('@srv.ServiceCode', 'Inquiry')">
                                                <input type="radio" 
                                                       class="btn-check" 
                                                       name="serviceCode" 
                                                       id="srv_@srv.ServiceCode" 
                                                       value="@srv.ServiceCode" 
                                                       data-cat="Inquiry"
                                                       required />
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="p-2 rounded-3 bg-info bg-opacity-10 text-info fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi @(string.IsNullOrEmpty(srv.IconClass) ? "bi-search" : srv.IconClass)"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="fw-bold mb-0 text-main">@srv.NameAr</h6>
                                                            @if (!string.IsNullOrEmpty(srv.NameEn))
                                                            {
                                                                <small class="text-muted" style="font-size: 0.78rem;">@srv.NameEn</small>
                                                            }
                                                        </div>
                                                    </div>
                                                    <span class="badge @opBadgeClass px-2 py-1 rounded-pill fs-8">
                                                        @opArabic
                                                    </span>
                                                </div>

                                                @if (!string.IsNullOrEmpty(srv.Description))
                                                {
                                                    <p class="text-muted small mb-2" style="font-size: 0.82rem;">@srv.Description</p>
                                                }

                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top fs-8 text-muted">
                                                    <span class="badge bg-light text-dark font-monospace border">@srv.ServiceCode</span>
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@catArabic</span>
                                                    <span>الرسوم: <strong class="text-primary font-monospace">@srv.BaseCost.ToString("N2") ج.م</strong></span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- GROUP 3: NUMBER INQUIRY -->
                        @if (numberServices.Any())
                        {
                            <div class="exec-category-group mb-4" id="exec-group-numberinquiry">
                                <div class="category-section-title d-flex justify-content-between align-items-center" style="border-right-color: #ffc107;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">📱</span>
                                        <strong class="text-main">عمليات استعلام وتأكيد الرقم</strong>
                                    </div>
                                    <span class="badge bg-warning bg-opacity-10 text-dark font-monospace fs-8">@numberServices.Count عمليات</span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var srv in numberServices)
                                    {
                                        var opStr = srv.Operator?.ToString() ?? "ALL";
                                        var opArabic = GetExecOpArabic(srv.Operator);
                                        var opBadgeClass = GetExecOpBadgeClass(srv.Operator);
                                        var catArabic = GetExecCatArabic(srv.Category);
                                        var borderClass = GetExecBorderClass(srv.Operator);
                                        var searchStr = $"{srv.NameAr} {srv.NameEn} {srv.ServiceCode} {opArabic} {catArabic} {opStr}".ToLower();
                                        var paramsJson = BuildParamsJson(srv);

                                        <div class="col-12 col-md-6 exec-service-item" 
                                             data-op="@opStr" 
                                             data-cat="NumberInquiry" 
                                             data-search="@searchStr">
                                            <div class="p-3 border h-100 exec-service-card @borderClass bg-white position-relative" 
                                                 id="card_srv_@srv.ServiceCode"
                                                 data-params='@paramsJson'
                                                 onclick="selectExecuteCard('@srv.ServiceCode', 'NumberInquiry')">
                                                <input type="radio" 
                                                       class="btn-check" 
                                                       name="serviceCode" 
                                                       id="srv_@srv.ServiceCode" 
                                                       value="@srv.ServiceCode" 
                                                       data-cat="NumberInquiry"
                                                       required />
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="p-2 rounded-3 bg-warning bg-opacity-10 text-warning fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi @(string.IsNullOrEmpty(srv.IconClass) ? "bi-phone" : srv.IconClass)"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="fw-bold mb-0 text-main">@srv.NameAr</h6>
                                                            @if (!string.IsNullOrEmpty(srv.NameEn))
                                                            {
                                                                <small class="text-muted" style="font-size: 0.78rem;">@srv.NameEn</small>
                                                            }
                                                        </div>
                                                    </div>
                                                    <span class="badge @opBadgeClass px-2 py-1 rounded-pill fs-8">
                                                        @opArabic
                                                    </span>
                                                </div>

                                                @if (!string.IsNullOrEmpty(srv.Description))
                                                {
                                                    <p class="text-muted small mb-2" style="font-size: 0.82rem;">@srv.Description</p>
                                                }

                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top fs-8 text-muted">
                                                    <span class="badge bg-light text-dark font-monospace border">@srv.ServiceCode</span>
                                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">@catArabic</span>
                                                    <span>الرسوم: <strong class="text-primary font-monospace">@srv.BaseCost.ToString("N2") ج.م</strong></span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- GROUP 4: OTHER SERVICES -->
                        @if (otherServices.Any())
                        {
                            <div class="exec-category-group mb-4" id="exec-group-other">
                                <div class="category-section-title d-flex justify-content-between align-items-center" style="border-right-color: #6c757d;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">⚙️</span>
                                        <strong class="text-main">عمليات وخدمات أخرى</strong>
                                    </div>
                                    <span class="badge bg-secondary bg-opacity-10 text-main font-monospace fs-8">@otherServices.Count عمليات</span>
                                </div>
                                <div class="row g-3">
                                    @foreach (var srv in otherServices)
                                    {
                                        var opStr = srv.Operator?.ToString() ?? "ALL";
                                        var opArabic = GetExecOpArabic(srv.Operator);
                                        var opBadgeClass = GetExecOpBadgeClass(srv.Operator);
                                        var catArabic = GetExecCatArabic(srv.Category);
                                        var borderClass = GetExecBorderClass(srv.Operator);
                                        var searchStr = $"{srv.NameAr} {srv.NameEn} {srv.ServiceCode} {opArabic} {catArabic} {opStr}".ToLower();
                                        var paramsJson = BuildParamsJson(srv);

                                        <div class="col-12 col-md-6 exec-service-item" 
                                             data-op="@opStr" 
                                             data-cat="Other" 
                                             data-search="@searchStr">
                                            <div class="p-3 border h-100 exec-service-card @borderClass bg-white position-relative" 
                                                 id="card_srv_@srv.ServiceCode"
                                                 data-params='@paramsJson'
                                                 onclick="selectExecuteCard('@srv.ServiceCode', 'Other')">
                                                <input type="radio" 
                                                       class="btn-check" 
                                                       name="serviceCode" 
                                                       id="srv_@srv.ServiceCode" 
                                                       value="@srv.ServiceCode" 
                                                       data-cat="Other"
                                                       required />
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="p-2 rounded-3 bg-secondary bg-opacity-10 text-secondary fs-5" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi @(string.IsNullOrEmpty(srv.IconClass) ? "bi-gear" : srv.IconClass)"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="fw-bold mb-0 text-main">@srv.NameAr</h6>
                                                            @if (!string.IsNullOrEmpty(srv.NameEn))
                                                            {
                                                                <small class="text-muted" style="font-size: 0.78rem;">@srv.NameEn</small>
                                                            }
                                                        </div>
                                                    </div>
                                                    <span class="badge @opBadgeClass px-2 py-1 rounded-pill fs-8">
                                                        @opArabic
                                                    </span>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center pt-2 border-top fs-8 text-muted">
                                                    <span class="badge bg-light text-dark font-monospace border">@srv.ServiceCode</span>
                                                    <span class="badge bg-secondary bg-opacity-10 text-main border">@catArabic</span>
                                                    <span>الرسوم: <strong class="text-primary font-monospace">@srv.BaseCost.ToString("N2") ج.م</strong></span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- No Matches Card -->
                        <div id="noExecMatches" class="text-center py-4 text-muted border rounded-3 bg-light d-none">
                            <i class="bi bi-funnel fs-2 d-block mb-2 text-warning"></i>
                            لا توجد عمليات مطابقة لخيارات البحث أو التصفية الحالية.
                        </div>
                    }
                </div>

                <!-- Step 2: Line / SIM Selection -->
                <div class="mb-4">
                    <label class="form-label fw-bold fs-5 mb-2 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-pill px-2.5 py-1">2</span>
                        <span>خط التنفيذ (الشريحة أو المنفذ):</span>
                    </label>
                    <select name="simCardId" id="simCardIdSelect" class="form-select fs-6 py-3 rounded-3">
                        <option value="">⚡ توجيه تلقائي ذكي (أسرع خط متاح وفيه رصيد كافي)</option>
                        @foreach (var sim in Model.AvailableSims)
                        {
                            <option value="@sim.Id">
                                @sim.Operator (@sim.PhoneNumber) - منفذ #@(sim.DevicePort?.PortNumber) - رصيد الخط: @sim.CurrentBalance.ToString("N2") ج.م
                            </option>
                        }
                    </select>
                    <small class="text-muted mt-1 d-block">نوصي بترك الاختيار التلقائي لتوزيع الحمل وسرعة التنفيذ بين الخطوط الشاغرة.</small>
                </div>

                <!-- Step 3: Dynamic Parameters ("موضوع الحقول") -->
                <div id="dynamicParamsSection" class="p-4 rounded-4 mb-4 d-none" style="background: var(--bg-app); border: 2px dashed var(--card-border);">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-pill px-2.5 py-1">3</span>
                            <h5 class="fw-bold mb-0 text-primary">بيانات وحقول العملية المطلوبة:</h5>
                        </div>
                        <span class="badge bg-light text-muted border fs-8" id="paramsCountBadge">0 حقول</span>
                    </div>

                    <!-- Dynamic Fields Injected Here via JavaScript -->
                    <div id="dynamicFieldsContainer"></div>
                </div>

                <!-- External Ref (Optional) -->
                <div class="mb-4">
                    <label class="form-label small text-muted">رقم مرجع خارجي خاص بك في نظامك (External Reference - اختياري):</label>
                    <input type="text" name="externalRef" id="externalRefInput" class="form-control form-control-sm" placeholder="مثال: ORDER-987654" />
                </div>

                <!-- Action Buttons: Standard Submit + Live AJAX Instant Test -->
                <div class="row g-3 mt-4">
                    <div class="col-md-7">
                        <button type="submit" id="submitBtn" class="btn btn-success py-3 fw-bold fs-5 shadow rounded-4 w-100">
                            <i class="bi bi-play-circle-fill me-2"></i> تأكيد وتنفيذ العملية الآن
                        </button>
                    </div>
                    <div class="col-md-5">
                        <button type="button" id="ajaxTestBtn" class="btn btn-outline-primary py-3 fw-bold fs-5 shadow-sm rounded-4 w-100" onclick="runLiveQuickTest()">
                            <i class="bi bi-cpu-fill me-2"></i> تجربة واختبار مباشر (Live Test)
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentExecOp = 'ALL';
        let currentExecCat = 'ALL';
        let currentSelectedCode = '';
        let currentSelectedCat = '';

        function filterExecByOp(btn, op) {
            document.querySelectorAll(".filter-pill").forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
            currentExecOp = op;
            filterExecServices();
        }

        function filterExecByCat(btn, cat) {
            document.querySelectorAll(".filter-cat-pill").forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
            currentExecCat = cat;
            filterExecServices();
        }

        function filterExecServices() {
            const query = (document.getElementById('execSearchInput')?.value || '').trim().toLowerCase();
            const items = document.querySelectorAll('.exec-service-item');
            let visibleCount = 0;

            items.forEach(el => {
                const itemOp = el.getAttribute('data-op') || 'ALL';
                const itemCat = el.getAttribute('data-cat') || '';
                const itemSearch = el.getAttribute('data-search') || '';

                const matchesOp = (currentExecOp === 'ALL' || itemOp === currentExecOp);
                const matchesCat = (currentExecCat === 'ALL' || itemCat === currentExecCat);
                const matchesQuery = (!query || itemSearch.includes(query));

                if (matchesOp && matchesCat && matchesQuery) {
                    el.style.display = '';
                    visibleCount++;
                } else {
                    el.style.display = 'none';
                }
            });

            const counter = document.getElementById('execVisibleCount');
            if (counter) counter.innerText = visibleCount;

            document.querySelectorAll('.exec-category-group').forEach(group => {
                const visibleInGroup = group.querySelectorAll('.exec-service-item:not([style*="display: none"])');
                group.style.display = visibleInGroup.length > 0 ? '' : 'none';
            });

            const noMatches = document.getElementById('noExecMatches');
            if (noMatches) {
                noMatches.classList.toggle('d-none', visibleCount > 0);
            }
        }

        function selectExecuteCard(code, category) {
            currentSelectedCode = code;
            currentSelectedCat = category;

            document.querySelectorAll('.exec-service-card').forEach(c => c.classList.remove('card-selected'));

            const radio = document.getElementById('srv_' + code);
            if (radio) radio.checked = true;

            const card = document.getElementById('card_srv_' + code);
            if (card) card.classList.add('card-selected');

            // Render Dynamic Parameters
            renderDynamicParameters(card, code, category);
        }

        function renderDynamicParameters(card, code, category) {
            const section = document.getElementById("dynamicParamsSection");
            const container = document.getElementById("dynamicFieldsContainer");
            const countBadge = document.getElementById("paramsCountBadge");
            container.innerHTML = '';

            let rawParams = [];
            try {
                const attr = card.getAttribute('data-params');
                if (attr) rawParams = JSON.parse(attr);
            } catch (e) {
                console.error("Error parsing params json", e);
            }

            const upperCode = (code || '').toUpperCase();

            // Scenario 1: Service has explicit parameters defined in DB
            if (rawParams && rawParams.length > 0) {
                section.classList.remove("d-none");
                countBadge.innerText = `${rawParams.length} حقول مطلوبة`;

                rawParams.forEach(param => {
                    const fieldDiv = document.createElement("div");
                    fieldDiv.className = "mb-3";

                    const isReq = param.required;
                    const reqStar = isReq ? `<span class="text-danger">*</span>` : `<span class="text-muted small fs-8">(اختياري)</span>`;
                    const inputType = param.type === 'Decimal' || param.type === 'Number' ? 'number' : (param.type === 'Phone' ? 'tel' : 'text');
                    const stepAttr = param.type === 'Decimal' ? 'step="0.01"' : '';
                    const defVal = param.defaultValue || '';

                    let placeholder = `أدخل ${param.name}`;
                    if (param.key.toLowerCase().includes('amount')) placeholder = "مثال: 500";
                    else if (param.key.toLowerCase().includes('merchant')) placeholder = "مثال: 123456";
                    else if (param.key.toLowerCase().includes('phone')) placeholder = "مثال: 01012345678";

                    fieldDiv.innerHTML = `
                        <label class="form-label fw-bold mb-1">${param.name} (${param.key}) ${reqStar}</label>
                        <div class="input-group">
                            <input type="${inputType}" ${stepAttr} name="param_${param.key}" id="dyn_${param.key}" 
                                   class="form-control fs-5 ${param.key.toLowerCase().includes('amount') ? 'fw-bold text-success' : ''}" 
                                   value="${defVal}" placeholder="${placeholder}" ${isReq ? 'required' : ''} />
                            ${param.key.toLowerCase().includes('amount') ? '<span class="input-group-text fw-bold">ج.م</span>' : ''}
                        </div>
                    `;
                    container.appendChild(fieldDiv);
                });
                return;
            }

            // Scenario 2: Standard Fallbacks if no explicit parameters in DB
            if (category === 'Payment' || upperCode.includes('PAY') || upperCode.includes('QR')) {
                section.classList.remove("d-none");
                countBadge.innerText = "2 حقول (دفع تاجر)";
                container.innerHTML = `
                    <div class="mb-3">
                        <label class="form-label fw-bold mb-1">كود التاجر أو الماكينة (Merchant Code) <span class="text-danger">*</span></label>
                        <input type="text" name="param_merchantCode" id="dyn_merchantCode" class="form-control fs-5" placeholder="مثال: 123456" required />
                        <small class="text-muted">الرقم المكتوب تحت كود الـ QR الخاص بالتاجر أو على شاشة ماكينة POS</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold mb-1">المبلغ المطلوب تنفيذه (Amount) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="1" name="param_amount" id="dyn_amount" class="form-control fs-4 fw-bold text-success" placeholder="مثال: 500" required />
                            <span class="input-group-text fw-bold fs-6">جنيه مصري (ج.م)</span>
                        </div>
                    </div>
                `;
            } else if (category === 'Transfer' || upperCode.includes('TRANS')) {
                section.classList.remove("d-none");
                countBadge.innerText = "2 حقول (تحويل كاش)";
                container.innerHTML = `
                    <div class="mb-3">
                        <label class="form-label fw-bold mb-1">رقم محفظة المستلم (Phone Number) <span class="text-danger">*</span></label>
                        <input type="tel" name="param_phoneNumber" id="dyn_phoneNumber" class="form-control fs-5" placeholder="مثال: 01012345678" required />
                        <small class="text-muted">رقم محفظة فودافون كاش، أورانج كاش، اتصالات كاش، أو وي باي</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold mb-1">المبلغ المراد تحويله (Amount) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="1" name="param_amount" id="dyn_amount" class="form-control fs-4 fw-bold text-success" placeholder="مثال: 250" required />
                            <span class="input-group-text fw-bold fs-6">جنيه مصري (ج.م)</span>
                        </div>
                    </div>
                `;
            } else if (category === 'Inquiry' || category === 'NumberInquiry' || upperCode.includes('INQ')) {
                section.classList.remove("d-none");
                countBadge.innerText = "خدمة تلقائية";
                container.innerHTML = `
                    <div class="alert alert-info border-0 rounded-3 mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span>هذه الخدمة استعلامية مؤتمتة بالكامل عبر USSD، ولا تتطلب إدخال أي حقول إضافية. يمكنك الضغط مباشرة على زر التنفيذ أو التجربة الحية.</span>
                    </div>
                `;
            } else {
                section.classList.add("d-none");
            }
        }

        function showExecutingState() {
            const btn = document.getElementById("submitBtn");
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> جاري إرسال الأمر لبوابة GoIP والتنفيذ...`;
        }

        // Live AJAX Instant Test Runner ("نقدر نعمل تجربه ونشوف الدنيا هتطلع معانا ايه")
        async function runLiveQuickTest() {
            if (!currentSelectedCode) {
                alert("يرجى اختيار إحدى الخدمات أولاً لتنفيذ التجربة.");
                return;
            }

            const simCardId = document.getElementById('simCardIdSelect')?.value;
            const externalRef = document.getElementById('externalRefInput')?.value;

            // Collect all dynamic params
            const parameters = {};
            const dynInputs = document.querySelectorAll('#dynamicFieldsContainer input');
            for (let input of dynInputs) {
                if (input.required && !input.value.trim()) {
                    input.focus();
                    alert(`الحقل مطلوب: يرجى ملء كافة البيانات المطلوبة قبل التجربة.`);
                    return;
                }
                const name = input.name.replace('param_', '');
                parameters[name] = input.value.trim();
            }

            const payload = {
                serviceCode: currentSelectedCode,
                simCardId: simCardId ? parseInt(simCardId) : null,
                externalRef: externalRef || `TEST-${Date.now()}`,
                parameters: parameters
            };

            const ajaxBtn = document.getElementById("ajaxTestBtn");
            const originalHtml = ajaxBtn.innerHTML;
            ajaxBtn.disabled = true;
            ajaxBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> جاري اختبار المنفذ وطلب الـ USSD...`;

            try {
                const response = await fetch('@Url.Action("QuickTest", "Execute", new { area = "Company" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(payload)
                });

                const json = await response.json();
                renderLiveTestResult(json);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } catch (err) {
                console.error("QuickTest error", err);
                alert("حدث خطأ أثناء إجراء الاختبار المباشر: " + err.message);
            } finally {
                ajaxBtn.disabled = false;
                ajaxBtn.innerHTML = originalHtml;
            }
        }

        function renderLiveTestResult(res) {
            const container = document.getElementById("liveAjaxResultContainer");
            if (!res || !res.success) {
                container.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm p-4 mb-4" role="alert">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                            <h5 class="fw-bold mb-0">فشل تنفيذ التجربة عبر البوابة</h5>
                        </div>
                        <p class="mb-0 fs-6">${res?.message || 'حدث خطأ أثناء إرسال الأمر للجهاز'}</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                return;
            }

            const data = res.data;
            const isSuccess = data.status === 2 || data.isSuccess;
            const alertBorder = isSuccess ? "border-success" : "border-danger";
            const headerBg = isSuccess ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger";

            let logsHtml = '';
            if (data.logs && data.logs.length > 0) {
                const rows = data.logs.map(l => `
                    <tr>
                        <td class="text-center font-monospace">${l.stepOrder}</td>
                        <td>${l.stepName || 'خطوة ' + l.stepOrder}</td>
                        <td><code class="text-primary font-monospace">${l.command || ''}</code></td>
                        <td><small class="text-muted">${l.response || ''}</small></td>
                        <td class="font-monospace text-center">${l.durationMs}ms</td>
                        <td class="text-center">
                            <span class="badge ${l.isSuccess ? 'bg-success' : 'bg-danger'}">${l.isSuccess ? 'ناجحة' : 'فشل'}</span>
                        </td>
                    </tr>
                `).join('');

                logsHtml = `
                    <div class="mt-3">
                        <label class="form-label fw-bold small text-muted"><i class="bi bi-list-check"></i> تفاصيل خطوات الـ USSD المنفذة:</label>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0 fs-8 bg-white">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>الخطوة</th>
                                        <th>الأمر المرسل للجهاز</th>
                                        <th>استجابة الشبكة</th>
                                        <th style="width: 80px;">الزمن</th>
                                        <th style="width: 80px;">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>${rows}</tbody>
                            </table>
                        </div>
                    </div>
                `;
            }

            container.innerHTML = `
                <div class="portal-card p-4 mb-4 shadow border ${alertBorder} rounded-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" onclick="this.closest('.portal-card').remove()"></button>
                    
                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                        <div class="p-3 rounded-circle ${headerBg} fs-2 d-flex align-items-center justify-content-center result-badge-pulse" style="width: 54px; height: 54px;">
                            <i class="bi ${isSuccess ? 'bi-check-circle-fill' : 'bi-x-circle-fill'}"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0 ${isSuccess ? 'text-success' : 'text-danger'}">
                                    ${isSuccess ? 'تمت التجربة بنجاح عبر أجهزة GoIP' : 'فشلت تجربة الخدمة'}
                                </h4>
                                <span class="badge ${isSuccess ? 'bg-success' : 'bg-danger'} font-monospace">LIVE TEST</span>
                            </div>
                            <div class="text-muted small mt-1">
                                رقم المرجع: <strong class="text-dark font-monospace">${data.transactionRef}</strong>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted fs-8 d-block mb-1">الخط والمنفذ المستخدم:</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-pill">منفذ #${data.portNumber || 'Auto'}</span>
                                    <strong class="font-monospace text-dark">${data.simPhoneNumber || 'شريحة تلقائية'}</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted fs-8 d-block mb-1">رصيد الشريحة قبل / بعد:</span>
                                <div class="d-flex align-items-center gap-2 font-monospace">
                                    <span>${data.simBalanceBefore != null ? data.simBalanceBefore.toFixed(2) : '--'}</span>
                                    <i class="bi bi-arrow-left text-muted"></i>
                                    <strong class="text-success">${data.simBalanceAfter != null ? data.simBalanceAfter.toFixed(2) : '--'} ج.م</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted fs-8 d-block mb-1">النتيجة:</span>
                                <strong class="text-main fs-8 d-block text-truncate" title="${data.message || ''}">
                                    ${data.message || 'تم استلام الرد من الشبكة بنجاح'}
                                </strong>
                            </div>
                        </div>
                    </div>

                    ${data.rawResponse ? `
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted"><i class="bi bi-terminal"></i> استجابة جهاز GoIP المباشرة (Raw USSD Output):</label>
                            <div class="goip-terminal">
                                <div class="text-muted small mb-1" style="color: #64748b !important;">[GoIP-128 Port ${data.portNumber || 'Line'} &gt;&gt; Network Response]:</div>
                                <div class="text-light">${data.rawResponse}</div>
                            </div>
                        </div>
                    ` : ''}

                    ${logsHtml}
                </div>
            `;
        }
    </script>
}
