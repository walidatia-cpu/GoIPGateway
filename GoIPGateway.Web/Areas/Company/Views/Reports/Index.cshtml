@model GoIPGateway.Application.DTOs.Reports.CompanyReportDto
@using GoIPGateway.Domain.Enums
@{
    ViewData["Title"] = "تقرير الأجهزة والعمليات المالية";
    var filter = Model.Filter;
}

<div class="container-fluid py-2">
    <!-- Header with Action Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-bold fs-7">
                    <i class="bi bi-file-earmark-bar-graph me-1"></i> بوابة الشركة والتاجر
                </span>
                <span class="text-muted fs-8">تحديث لحظي</span>
            </div>
            <h2 class="fw-black mb-1 text-main fs-3">التقرير الشامل للأجهزة والعمليات (GoIP Analytics)</h2>
            <p class="text-muted small mb-0">متابعة تفصيلية لأداء أجهزة GoIP المخصصة لحسابك، كفاءة الشرائح، وحركة المحافظ النقدية</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" onclick="window.print()" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-printer"></i> <span>طباعة التقرير</span>
            </button>
            <a asp-action="ExportCsv"
               asp-route-deviceId="@filter.DeviceId"
               asp-route-simCardId="@filter.SimCardId"
               asp-route-operator="@filter.Operator"
               asp-route-serviceDefinitionId="@filter.ServiceDefinitionId"
               asp-route-status="@filter.Status"
               asp-route-datePreset="@filter.DatePreset"
               asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
               asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
               asp-route-searchTerm="@filter.SearchTerm"
               class="btn btn-success d-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-bold shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> <span>تصدير Excel (CSV)</span>
            </a>
        </div>
    </div>

    <!-- Navigation Tabs Between Reports -->
    <ul class="nav nav-pills gap-2 mb-4 p-1.5 rounded-4 border" style="background: var(--card-bg); border-color: var(--card-border) !important; width: fit-content;">
        <li class="nav-item">
            <a class="nav-link text-muted rounded-3 px-3 py-2 fw-bold d-flex align-items-center gap-2" asp-action="Summary">
                <i class="bi bi-graph-up-arrow"></i> <span>تقرير الإجماليات والتسويات</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active rounded-3 px-3 py-2 fw-bold d-flex align-items-center gap-2" asp-action="Index">
                <i class="bi bi-cpu"></i> <span>التقرير التفصيلي للعمليات وبوابات GoIP</span>
            </a>
        </li>
    </ul>

    <!-- Filter Card ("فلاتر محترمه") -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" id="reportFilterForm">
                <!-- Date Presets Quick Bar -->
                <div class="d-flex flex-wrap align-items-center gap-2 pb-3 mb-3 border-bottom border-secondary border-opacity-10">
                    <span class="text-muted fs-8 fw-bold me-1"><i class="bi bi-calendar3 me-1"></i> الفترة الزمنية:</span>
                    <button type="submit" name="datePreset" value="today" class="btn btn-sm @(filter.DatePreset == "today" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">اليوم</button>
                    <button type="submit" name="datePreset" value="yesterday" class="btn btn-sm @(filter.DatePreset == "yesterday" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">أمس</button>
                    <button type="submit" name="datePreset" value="last7days" class="btn btn-sm @(filter.DatePreset == "last7days" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">آخر 7 أيام</button>
                    <button type="submit" name="datePreset" value="thismonth" class="btn btn-sm @(filter.DatePreset == "thismonth" || string.IsNullOrEmpty(filter.DatePreset) ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">هذا الشهر</button>
                    <button type="submit" name="datePreset" value="lastmonth" class="btn btn-sm @(filter.DatePreset == "lastmonth" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">الشهر الماضي</button>
                    <button type="button" onclick="toggleCustomDates()" class="btn btn-sm @(filter.DatePreset == "custom" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">تاريخ مخصص...</button>
                </div>

                <!-- Custom Dates Row -->
                <div id="customDatesRow" class="row g-3 mb-3 @(filter.DatePreset == "custom" ? "" : "d-none")">
                    <input type="hidden" name="datePreset" id="datePresetInput" value="@filter.DatePreset" />
                    <div class="col-md-6">
                        <label class="form-label fs-8 fw-bold text-muted">من تاريخ</label>
                        <input type="datetime-local" name="fromDate" value="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm")" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fs-8 fw-bold text-muted">إلى تاريخ</label>
                        <input type="datetime-local" name="toDate" value="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm")" class="form-control rounded-3" />
                    </div>
                </div>

                <!-- Advanced Filters Grid -->
                <div class="row g-3">
                    <!-- Device Filter ("وتاخد الاجهزه معاك") -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">📟 جهاز GoIP Gateway</label>
                        <select name="deviceId" class="form-select rounded-3 searchable-select" data-placeholder="-- كل الأجهزة --" data-search-placeholder="ابحث باسم الجهاز أو IP...">
                            <option value="">-- كل الأجهزة --</option>
                            @foreach (var d in Model.AvailableDevices)
                            {
                                <option value="@d.Id" selected="@(filter.DeviceId == d.Id)">@d.DeviceName (@d.IpAddress)</option>
                            }
                        </select>
                    </div>

                    <!-- SIM Card Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">📱 الشريحة / المحفظة</label>
                        <select name="simCardId" class="form-select rounded-3 searchable-select" data-placeholder="-- كل الشرائح --" data-search-placeholder="ابحث برقم الشريحة أو الشبكة...">
                            <option value="">-- كل الشرائح --</option>
                            @foreach (var s in Model.AvailableSimCards)
                            {
                                <option value="@s.Id" selected="@(filter.SimCardId == s.Id)">@(s.PhoneNumber ?? s.SimNumber) (@s.Operator)</option>
                            }
                        </select>
                    </div>

                    <!-- Telecom Operator Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">🌐 الشبكة والمحفظة</label>
                        <select name="operator" class="form-select rounded-3">
                            <option value="">-- كل الشبكات --</option>
                            <option value="@OperatorType.Vodafone" selected="@(filter.Operator == OperatorType.Vodafone)">فودافون كاش</option>
                            <option value="@OperatorType.Orange" selected="@(filter.Operator == OperatorType.Orange)">أورانج كاش</option>
                            <option value="@OperatorType.Etisalat" selected="@(filter.Operator == OperatorType.Etisalat)">اتصالات كاش</option>
                            <option value="@OperatorType.WE" selected="@(filter.Operator == OperatorType.WE)">وي باي (WE)</option>
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">🚦 حالة العملية</label>
                        <select name="status" class="form-select rounded-3">
                            <option value="">-- كل الحالات --</option>
                            <option value="@TransactionStatus.Completed" selected="@(filter.Status == TransactionStatus.Completed)">ناجحة (Completed)</option>
                            <option value="@TransactionStatus.Failed" selected="@(filter.Status == TransactionStatus.Failed)">فاشلة (Failed)</option>
                            <option value="@TransactionStatus.Processing" selected="@(filter.Status == TransactionStatus.Processing)">قيد المعالجة (Processing)</option>
                            <option value="@TransactionStatus.Pending" selected="@(filter.Status == TransactionStatus.Pending)">معلقة (Pending)</option>
                        </select>
                    </div>

                    <!-- Service Filter -->
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">⚡ نوع الخدمة</label>
                        <select name="serviceDefinitionId" class="form-select rounded-3 searchable-select" data-placeholder="-- كل الخدمات المتاحة --" data-search-placeholder="ابحث باسم الخدمة أو الكود...">
                            <option value="">-- كل الخدمات المتاحة --</option>
                            @foreach (var svc in Model.AvailableServices)
                            {
                                <option value="@svc.Id" selected="@(filter.ServiceDefinitionId == svc.Id)">@svc.NameAr (@svc.ServiceCode)</option>
                            }
                        </select>
                    </div>

                    <!-- Search Input -->
                    <div class="col-md-5 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">🔍 بحث برقم المعاملة / المرجع الخارجي / الهاتف</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchTerm" value="@filter.SearchTerm" class="form-control border-start-0 rounded-start-3" placeholder="مثال: GW-20261028-XXX أو 01012345678" />
                        </div>
                    </div>

                    <!-- Submit & Reset Buttons -->
                    <div class="col-md-3 col-sm-12 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-2 rounded-3 py-2 fw-bold shadow-sm">
                            <i class="bi bi-funnel-fill"></i> <span>تطبيق الفلترة</span>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center justify-content-center rounded-3 py-2 px-3 fw-bold" title="إعادة تعيين الفلاتر">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Executive KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Financial Volume -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #2563eb !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">حجم المبالغ المنفذة</span>
                    <div class="p-2.5 rounded-3 bg-primary bg-opacity-10 text-primary fs-5">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
                <div class="fs-3 fw-black text-main">@Model.TotalFinancialVolume.ToString("N2") <small class="fs-7 text-muted">ج.م</small></div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <span class="badge bg-primary bg-opacity-15 text-primary fs-8">تكلفة الخدمات: @Model.TotalPlatformFees.ToString("N2") ج.م</span>
                </div>
            </div>
        </div>

        <!-- Total Operations & Success Rate -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #16a34a !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">عدد العمليات ومعدل النجاح</span>
                    <div class="p-2.5 rounded-3 bg-success bg-opacity-10 text-success fs-5">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <div class="fs-3 fw-black text-main">@Model.TotalTransactionsCount.ToString("N0")</div>
                    <span class="badge @(Model.SuccessRate >= 90 ? "bg-success" : (Model.SuccessRate >= 75 ? "bg-warning" : "bg-danger")) text-white fs-8 fw-bold rounded-pill">
                        @Model.SuccessRate% نجاح
                    </span>
                </div>
                <div class="text-muted fs-8 mt-2">
                    <span class="text-success fw-bold">@Model.SuccessfulTransactionsCount ناجحة</span> • 
                    <span class="text-danger fw-bold">@Model.FailedTransactionsCount فاشلة</span>
                </div>
            </div>
        </div>

        <!-- Devices Performance ("وتاخد الاجهزه معاك") -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #8b5cf6 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">أجهزة GoIP المسجلة لحسابك</span>
                    <div class="p-2.5 rounded-3 bg-purple bg-opacity-10 text-purple fs-5" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                        <i class="bi bi-router-fill"></i>
                    </div>
                </div>
                <div class="fs-3 fw-black text-main">@Model.TotalActiveDevices <small class="fs-7 text-muted">أجهزة نشطة</small></div>
                <div class="text-muted fs-8 mt-2">
                    <span>تحتوي على <strong>@Model.DeviceStats.Sum(d => d.TotalPorts)</strong> منفذ ومسار تشغيلي</span>
                </div>
            </div>
        </div>

        <!-- SIM Cards & Liquidity Balance -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #f59e0b !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">الشرائح وسيولة المحافظ</span>
                    <div class="p-2.5 rounded-3 bg-warning bg-opacity-10 text-warning fs-5">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
                <div class="fs-3 fw-black text-main">@Model.TotalSimsBalance.ToString("N2") <small class="fs-7 text-muted">ج.م</small></div>
                <div class="text-muted fs-8 mt-2">
                    <span>إجمالي الرصيد المتاح على <strong>@Model.TotalActiveSims</strong> شريحة نشطة</span>
                </div>
            </div>
        </div>
    </div>

    <!-- "وتاخد الاجهزه معاك" - Detailed Devices Report Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
        <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center justify-content-between border-bottom" style="border-color: var(--card-border) !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-cpu-fill text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-main">كفاءة وأداء أجهزة GoIP ومنافذها (GoIP Gateway Devices)</h5>
            </div>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1.5 fw-bold fs-8">
                @Model.DeviceStats.Count أجهزة بالتقرير
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.DeviceStats.Any())
            {
                <div class="p-4 text-center text-muted">لا توجد أجهزة مطابقة لشروط الفلترة المحددة.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-sticky-col align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="min-width: 130px;"><span class="d-none d-sm-inline">اسم الجهاز والموديل</span><span class="d-sm-none">الجهاز</span></th>
                                <th>عنوان IP</th>
                                <th>الحالة</th>
                                <th>المنافذ والشرائح</th>
                                <th>عدد العمليات</th>
                                <th>نسبة النجاح</th>
                                <th>حجم المبالغ (ج.م)</th>
                                <th>أرقام الشرائح المربوطة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dev in Model.DeviceStats)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded-3 bg-secondary bg-opacity-10 text-main fs-6 d-none d-md-flex">
                                                <i class="bi bi-router"></i>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="fw-bold text-main text-truncate" style="max-width: 120px;" title="@dev.DeviceName">@dev.DeviceName</div>
                                                <div class="text-muted fs-8 font-monospace d-none d-md-block">@dev.DeviceType</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-main font-monospace px-2.5 py-1.5">@dev.IpAddress</span>
                                    </td>
                                    <td>
                                        @if (dev.IsOnline)
                                        {
                                            <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2.5 py-1 fw-bold">
                                                <span class="badge-live-pulse me-1"></span> متصل (Online)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-2.5 py-1 fw-bold">
                                                غير متصل (Offline)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-info bg-opacity-10 text-info fw-bold">@dev.TotalPorts منافذ</span>
                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold">@dev.ActiveSimsCount شرائح نشطة</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-main">@dev.OperationsCount.ToString("N0")</span>
                                        <span class="text-muted fs-8">(@dev.SuccessfulOperationsCount ناجحة)</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" style="min-width: 110px;">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar @(dev.SuccessRate >= 90 ? "bg-success" : (dev.SuccessRate >= 70 ? "bg-warning" : "bg-danger"))" style="width: @dev.SuccessRate%"></div>
                                            </div>
                                            <span class="fs-8 fw-bold">@dev.SuccessRate%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-main">@dev.TotalVolume.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1" style="max-width: 250px;">
                                            @foreach (var phone in dev.AssociatedSimNumbers.Take(3))
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-main font-monospace fs-8">@phone</span>
                                            }
                                            @if (dev.AssociatedSimNumbers.Count > 3)
                                            {
                                                <span class="badge bg-secondary bg-opacity-25 text-main fs-8">+@(dev.AssociatedSimNumbers.Count - 3)</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Telecom Operators & Services Analysis -->
    <div class="row g-4 mb-4">
        <!-- Operators Breakdown -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
                <div class="card-header bg-transparent py-3 px-4 border-bottom" style="border-color: var(--card-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart-fill text-primary"></i>
                        <h6 class="fw-bold mb-0 text-main">حالة ومؤشرات أداء شبكات المحمول والمحافظ</h6>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        @foreach (var c in Model.CarrierStats)
                        {
                            <div class="col-sm-6">
                                <div class="p-3 rounded-3" style="background: var(--bg-app); border: 1px solid var(--card-border); border-right: 4px solid var(--primary-accent) !important;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-main">@c.NameAr</span>
                                        <span class="badge @(c.SuccessRate >= 90 ? "bg-success" : "bg-warning") text-white fs-9 rounded-pill">@c.StatusText</span>
                                    </div>
                                    <div class="fs-5 fw-black text-main mb-1">@c.TodayOperations <small class="fs-8 text-muted">عملية</small></div>
                                    <div class="d-flex justify-content-between fs-8 text-muted">
                                        <span>نسبة النجاح:</span>
                                        <strong class="@(c.SuccessRate >= 80 ? "text-success" : "text-danger")">@c.SuccessRate%</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Services Breakdown -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
                <div class="card-header bg-transparent py-3 px-4 border-bottom" style="border-color: var(--card-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge-fill text-warning"></i>
                        <h6 class="fw-bold mb-0 text-main">أكثر الخدمات والعمليات استخداماً</h6>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom table-sticky-col align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="min-width: 120px;"><span class="d-none d-sm-inline">الخدمة</span><span class="d-sm-none">الخدمة</span></th>
                                    <th>التصنيف</th>
                                    <th>عدد العمليات</th>
                                    <th>نسبة النجاح</th>
                                    <th>حجم المبالغ (ج.م)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var svc in Model.ServiceStats.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <div class="min-w-0">
                                                <div class="fw-bold text-main text-truncate" style="max-width: 120px;" title="@svc.NameAr">@svc.NameAr</div>
                                                <div class="text-muted fs-8 font-monospace d-none d-md-block">@svc.ServiceCode</div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-main fs-8">@svc.Category</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-main">@svc.OperationsCount.ToString("N0")</span>
                                        </td>
                                        <td>
                                            <span class="badge @(svc.SuccessRate >= 85 ? "bg-success" : "bg-warning") text-white fs-8">@svc.SuccessRate%</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-main">@svc.TotalVolume.ToString("N2")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Paginated Transactions Table -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
        <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center justify-content-between border-bottom" style="border-color: var(--card-border) !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-main">سجل العمليات والتحويلات التفصيلي</h5>
            </div>
            <span class="text-muted fs-8">
                عرض <strong>@Model.Transactions.Items.Count</strong> من إجمالي <strong>@Model.Transactions.TotalCount</strong> عملية
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Transactions.Items.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    لا توجد عمليات مطابقة للفلاتر المحددة حالياً.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-sticky-col align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="min-width: 125px;"><span class="d-none d-sm-inline">رقم المعاملة</span><span class="d-sm-none">المعاملة</span></th>
                                <th>الجهاز والمنفذ</th>
                                <th>الشريحة والمحفظة</th>
                                <th>الخدمة</th>
                                <th>المبلغ المطلوب</th>
                                <th>التكلفة</th>
                                <th>الحالة</th>
                                <th>تاريخ التنفيذ</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.Transactions.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="min-w-0">
                                            <div class="fw-bold font-monospace text-main fs-8 text-truncate" style="max-width: 120px;" title="@tx.TransactionRef">@tx.TransactionRef</div>
                                            @if (!string.IsNullOrEmpty(tx.ExternalRef))
                                            {
                                                <div class="text-muted fs-8 font-monospace d-none d-md-block text-truncate" style="max-width: 120px;" title="@tx.ExternalRef">مرجع: @tx.ExternalRef</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (tx.DevicePort?.Device != null)
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-router text-primary fs-7"></i>
                                                <span class="fw-bold text-main fs-8">@tx.DevicePort.Device.DeviceName</span>
                                            </div>
                                            <span class="badge bg-secondary bg-opacity-10 text-muted font-monospace fs-8">منفذ @tx.DevicePort.PortNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-8">غير محدد</span>
                                        }
                                    </td>
                                    <td>
                                        @if (tx.SimCard != null)
                                        {
                                            <div class="fw-bold font-monospace text-main fs-8">@(tx.SimCard.PhoneNumber ?? tx.SimCard.SimNumber)</div>
                                            <span class="badge bg-info bg-opacity-10 text-info fs-8">@tx.SimCard.Operator</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-8">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-main fs-8">@(tx.ServiceDefinition?.NameAr ?? "عملية عامة")</div>
                                        <span class="text-muted fs-8 font-monospace">@(tx.ServiceDefinition?.ServiceCode ?? "-")</span>
                                    </td>
                                    <td>
                                        <span class="fw-black text-main">@(tx.Amount.HasValue ? tx.Amount.Value.ToString("N2") : "-")</span>
                                        @if (tx.Amount.HasValue)
                                        {
                                            <small class="fs-8 text-muted">ج.م</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-main font-monospace fs-8">@tx.TenantCharge.ToString("N2") ج.م</span>
                                    </td>
                                    <td>
                                        @switch (tx.Status)
                                        {
                                            case TransactionStatus.Completed:
                                                <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2.5 py-1 fw-bold fs-8">
                                                    <i class="bi bi-check-circle-fill me-1"></i> مكتملة
                                                </span>
                                                break;
                                            case TransactionStatus.Failed:
                                                <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-2.5 py-1 fw-bold fs-8" title="@tx.ErrorMessage">
                                                    <i class="bi bi-x-circle-fill me-1"></i> فاشلة
                                                </span>
                                                break;
                                            case TransactionStatus.Processing:
                                                <span class="badge bg-warning bg-opacity-15 text-warning rounded-pill px-2.5 py-1 fw-bold fs-8">
                                                    <i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm"></i> قيد المعالجة
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary bg-opacity-15 text-secondary rounded-pill px-2.5 py-1 fw-bold fs-8">
                                                    معلقة
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="text-main fs-8">@tx.RequestedAt.ToString("yyyy-MM-dd")</div>
                                        <div class="text-muted fs-8 font-monospace">@tx.RequestedAt.ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-1" onclick="viewTransactionDetails('@tx.TransactionRef', '@(tx.RawResponse?.Replace("'", "\\'") ?? "")', '@(tx.ErrorMessage?.Replace("'", "\\'") ?? "")')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.Transactions.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 border-top" style="border-color: var(--card-border) !important;">
                        <span class="text-muted fs-8">صفحة @Model.Transactions.PageNumber من @Model.Transactions.TotalPages</span>
                        <ul class="pagination pagination-sm mb-0 gap-1">
                            @if (Model.Transactions.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-2" asp-action="Index"
                                       asp-route-pageNumber="@(Model.Transactions.PageNumber - 1)"
                                       asp-route-deviceId="@filter.DeviceId"
                                       asp-route-simCardId="@filter.SimCardId"
                                       asp-route-operator="@filter.Operator"
                                       asp-route-serviceDefinitionId="@filter.ServiceDefinitionId"
                                       asp-route-status="@filter.Status"
                                       asp-route-datePreset="@filter.DatePreset"
                                       asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                       asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                       asp-route-searchTerm="@filter.SearchTerm">السابق</a>
                                </li>
                            }

                            @for (var p = Math.Max(1, Model.Transactions.PageNumber - 2); p <= Math.Min(Model.Transactions.TotalPages, Model.Transactions.PageNumber + 2); p++)
                            {
                                <li class="page-item @(p == Model.Transactions.PageNumber ? "active" : "")">
                                    <a class="page-link rounded-2" asp-action="Index"
                                       asp-route-pageNumber="@p"
                                       asp-route-deviceId="@filter.DeviceId"
                                       asp-route-simCardId="@filter.SimCardId"
                                       asp-route-operator="@filter.Operator"
                                       asp-route-serviceDefinitionId="@filter.ServiceDefinitionId"
                                       asp-route-status="@filter.Status"
                                       asp-route-datePreset="@filter.DatePreset"
                                       asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                       asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                       asp-route-searchTerm="@filter.SearchTerm">@p</a>
                                </li>
                            }

                            @if (Model.Transactions.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-2" asp-action="Index"
                                       asp-route-pageNumber="@(Model.Transactions.PageNumber + 1)"
                                       asp-route-deviceId="@filter.DeviceId"
                                       asp-route-simCardId="@filter.SimCardId"
                                       asp-route-operator="@filter.Operator"
                                       asp-route-serviceDefinitionId="@filter.ServiceDefinitionId"
                                       asp-route-status="@filter.Status"
                                       asp-route-datePreset="@filter.DatePreset"
                                       asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                       asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                       asp-route-searchTerm="@filter.SearchTerm">التالي</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal for Raw Response & Error Inspection -->
<div class="modal fade" id="txDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; background: var(--card-bg);">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0 text-main" id="txModalRef">تفاصيل استجابة البوابة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fs-8 fw-bold text-muted">رد البوابة الفعلي (Raw Response):</label>
                    <pre id="txModalRaw" class="p-3 rounded-3 bg-dark text-light font-monospace fs-8 text-wrap" style="max-height: 150px; overflow-y: auto;"></pre>
                </div>
                <div id="txModalErrorSection">
                    <label class="form-label fs-8 fw-bold text-danger">رسالة الخطأ المسجلة:</label>
                    <div id="txModalError" class="alert alert-danger py-2 px-3 fs-8 mb-0 rounded-3"></div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleCustomDates() {
            const row = document.getElementById('customDatesRow');
            const presetInput = document.getElementById('datePresetInput');
            if (row.classList.contains('d-none')) {
                row.classList.remove('d-none');
                presetInput.value = 'custom';
            } else {
                row.classList.add('d-none');
            }
        }

        function viewTransactionDetails(ref, raw, err) {
            document.getElementById('txModalRef').innerText = 'المعاملة: ' + ref;
            document.getElementById('txModalRaw').innerText = raw || 'لا يوجد رد نصي مسجل';
            
            const errEl = document.getElementById('txModalError');
            const errSec = document.getElementById('txModalErrorSection');
            if (err && err.trim() !== '') {
                errEl.innerText = err;
                errSec.classList.remove('d-none');
            } else {
                errSec.classList.add('d-none');
            }

            const modal = new bootstrap.Modal(document.getElementById('txDetailsModal'));
            modal.show();
        }
    </script>
}
