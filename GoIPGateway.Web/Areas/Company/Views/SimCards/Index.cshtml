@model IEnumerable<GoIPGateway.Domain.Entities.SimCard>
@{
    ViewData["Title"] = "إدارة الشرائح والمحافظ";
    decimal totalBalance = ViewBag.TotalBalance ?? 0m;
    int activeCount = ViewBag.ActiveCount ?? 0;
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">الشرائح والمحافظ الإلكترونية</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-sim-fill"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">إدارة الشرائح والمحافظ الإلكترونية</h4>
                    <div class="text-muted small">
                        الشرائح المركبة في أجهزتك لتنفيذ عمليات الكاش والدفع الآلي
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-action="Create" class="btn btn-primary fw-bold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>إضافة شريحة جديدة</span>
                </a>
                <a asp-area="Company" asp-controller="Routing" asp-action="Index" class="btn btn-outline-info px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-shuffle me-1"></i> توجيه الخدمات
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Quick Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-sim"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold">إجمالي الشرائح</div>
                        <div class="fs-4 fw-black text-main">@Model.Count() <small class="fs-8 fw-normal text-muted">(@activeCount نشطة)</small></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold">إجمالي رصيد المحافظ</div>
                        <div class="fs-4 fw-black text-success">@totalBalance.ToString("N2") <small class="fs-8 fw-normal text-muted">ج.م</small></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-router"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold">الأجهزة الحاضنة</div>
                        <div class="fs-4 fw-black text-main">
                            <a asp-area="Company" asp-controller="Devices" asp-action="Index" class="text-decoration-none text-primary fs-5 fw-bold">
                                إدارة الأجهزة <i class="bi bi-arrow-left fs-7"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SIMs Table Card -->
    <div class="portal-card p-4 shadow-sm">
        @if (!Model.Any())
        {
            <div class="text-center py-5 border rounded-3 border-dashed" style="border-color: var(--card-border) !important;">
                <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning d-inline-block mb-3">
                    <i class="bi bi-sim fs-2"></i>
                </div>
                <h5 class="fw-bold text-main mb-2">لا توجد شرائح مسجلة بعد</h5>
                <p class="text-muted small mb-3">قم بتركيب أول شريحة في أحد منافذ أجهزة GoIP الخاصة بك للبدء في تشغيل العمليات.</p>
                <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 fw-bold">
                    <i class="bi bi-plus-circle-fill me-1"></i> إضافة شريحة الآن
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8">
                        <tr>
                            <th>رقم الشريحة (المحفظة)</th>
                            <th>الشبكة</th>
                            <th>الجهاز والمنفذ</th>
                            <th>الرصيد الحالي</th>
                            <th>الحد اليومي</th>
                            <th>الحالة</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sim in Model)
                        {
                            var opBadge = sim.Operator switch
                            {
                                GoIPGateway.Domain.Enums.OperatorType.Vodafone => "bg-danger",
                                GoIPGateway.Domain.Enums.OperatorType.Orange => "bg-warning text-dark",
                                GoIPGateway.Domain.Enums.OperatorType.Etisalat => "bg-success",
                                GoIPGateway.Domain.Enums.OperatorType.WE => "bg-secondary",
                                _ => "bg-dark"
                            };

                            <tr>
                                <td>
                                    <div class="fw-bold font-monospace text-main fs-6 dir-ltr text-end">@sim.PhoneNumber</div>
                                    <small class="text-muted">PIN: ****</small>
                                </td>
                                <td>
                                    <span class="badge @opBadge px-2 py-1 rounded-pill fs-8">@sim.Operator</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-main small">@sim.DevicePort.Device.DeviceName</div>
                                    <span class="badge bg-light text-muted border font-monospace fs-9">منفذ #@sim.DevicePort.PortNumber (@sim.DevicePort.PortLabel)</span>
                                </td>
                                <td>
                                    <span class="fw-black text-success font-monospace fs-6">@sim.CurrentBalance.ToString("N2") ج.م</span>
                                </td>
                                <td>
                                    <span class="small font-monospace">@sim.DailyLimit.ToString("N0") ج.م</span>
                                </td>
                                <td>
                                    @if (sim.IsActive && !sim.IsBlocked)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success">نشطة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger">معطلة</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@sim.Id" class="btn btn-outline-primary" title="تعديل الشريحة">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@sim.Id" method="post" class="d-inline" onsubmit="return confirm('إزالة هذه الشريحة من المنفذ؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="إزالة">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
