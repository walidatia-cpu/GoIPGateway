@model GoIPGateway.Domain.Entities.SimCard
@{
    ViewData["Title"] = "إضافة شريحة جديدة";
    var emptyPorts = ViewBag.EmptyPorts as List<GoIPGateway.Domain.Entities.DevicePort> ?? new List<GoIPGateway.Domain.Entities.DevicePort>();
    int? selectedPortId = ViewBag.SelectedPortId;
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">الشرائح والمحافظ</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">إضافة شريحة جديدة</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-plus-circle-fill"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">تركيب شريحة جديدة في منفذ GoIP</h4>
                    <div class="text-muted small">
                        قم بتحديد المنفذ وإدخال بيانات الشريحة والـ PIN لتفعيلها في تنفيذ خدمات الكاش
                    </div>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-arrow-right me-1"></i> العودة للشرائح
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="portal-card p-4 shadow-sm mb-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <!-- Select Empty Port -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">منفذ الجهاز الشاغر <span class="text-danger">*</span></label>
                    <select name="DevicePortId" class="form-select form-select-sm searchable-select" 
                            data-placeholder="-- اضغط لاختيار المنفذ الشاغر --" 
                            data-search-placeholder="ابحث برقم المنفذ (مثل 1.01 أو 1A أو 32) أو الجهاز..." required>
                        @foreach (var p in emptyPorts)
                        {
                            <option value="@p.Id" selected="@(selectedPortId == p.Id ? "selected" : null)"
                                    data-badge="@p.PortLabel" data-badge-class="bg-primary bg-opacity-10 text-primary border"
                                    data-search="@p.Device.DeviceName @p.PortNumber @p.PortLabel">
                                @p.Device.DeviceName - منفذ #@p.PortNumber (@p.PortLabel)
                            </option>
                        }
                    </select>
                </div>

                <!-- Operator -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">شبكة الاتصالات <span class="text-danger">*</span></label>
                    <select name="Operator" class="form-select form-select-sm">
                        <option value="1">فودافون (Vodafone Cash)</option>
                        <option value="2">أورانج (Orange Money)</option>
                        <option value="3">اتصالات (Etisalat Cash)</option>
                        <option value="4">وي (WE Pay)</option>
                    </select>
                </div>

                <!-- Phone Number -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">رقم هاتف الشريحة (المحفظة) <span class="text-danger">*</span></label>
                    <input type="text" name="PhoneNumber" class="form-control form-control-sm font-monospace dir-ltr text-end" placeholder="مثال: 01012345678" required />
                </div>

                <!-- Wallet PIN -->
                <div class="col-md-6">
                    <label class="form-label fw-bold small">الرقم السري للمحفظة (Wallet PIN) <span class="text-danger">*</span></label>
                    <input type="password" name="WalletPassword" class="form-control form-control-sm font-monospace" placeholder="الـ PIN الخاص بعمليات التحويل" required />
                    <small class="text-muted fs-8">يتم استخدامه آلياً كـ {Password} في أوامر الـ USSD</small>
                </div>

                <!-- Balance -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small">الرصيد الحالي بالمحفظة (ج.م)</label>
                    <input type="number" step="0.01" name="CurrentBalance" class="form-control form-control-sm font-monospace" value="0.00" />
                </div>

                <!-- Daily Limit -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small">الحد الأقصى للإنفاق اليومي (ج.م)</label>
                    <input type="number" name="DailyLimit" class="form-control form-control-sm font-monospace" value="50000" />
                </div>

                <!-- Monthly Limit -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small">الحد الأقصى للإنفاق الشهري (ج.م)</label>
                    <input type="number" name="MonthlyLimit" class="form-control form-control-sm font-monospace" value="500000" />
                </div>

                <!-- Notes -->
                <div class="col-12">
                    <label class="form-label fw-bold small">ملاحظات على الشريحة (اختياري)</label>
                    <input type="text" name="Notes" class="form-control form-control-sm" placeholder="مثال: محفظة سحب ودفع تاجر رئيسية" />
                </div>

                <div class="col-12 text-end pt-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">إلغاء</a>
                    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 rounded-3 shadow">
                        <i class="bi bi-check-circle-fill me-1"></i> حفظ وتفعيل الشريحة بالمنفذ
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
