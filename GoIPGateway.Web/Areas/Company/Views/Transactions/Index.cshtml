@model GoIPGateway.Application.Common.Models.PagedResult<GoIPGateway.Application.DTOs.TransactionResultDto>
@{
    ViewData["Title"] = "سجل معاملاتي";
    var txList = Model.Items;
    var totalCount = Model.TotalCount;
    var pageCount = txList.Count;
    var completedCount = txList.Count(t => t.Status == GoIPGateway.Domain.Enums.TransactionStatus.Completed);
    var processingCount = txList.Count(t => t.Status == GoIPGateway.Domain.Enums.TransactionStatus.Processing);
    var failedCount = txList.Count(t => t.Status != GoIPGateway.Domain.Enums.TransactionStatus.Completed && t.Status != GoIPGateway.Domain.Enums.TransactionStatus.Processing);
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Company" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة المتابعة</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">سجل العمليات والمعاملات</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-black mb-1 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-receipt fs-4"></i>
                </span>
                <span>سجل العمليات والمعاملات (Transactions Log)</span>
            </h3>
            <p class="text-muted small mb-0">كشف حساب ومعاملات الدفع والشحن والاستعلام المنفذة على حساب شركتك</p>
        </div>
        <div>
            <a asp-area="Company" asp-controller="Execute" asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2">
                <i class="bi bi-play-circle-fill fs-5"></i>
                <span>تنفيذ عملية جديدة</span>
            </a>
        </div>
    </div>

    <!-- 4 KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي العمليات</div>
                        <div class="fs-4 fw-black text-main my-1 font-monospace">@totalCount</div>
                        <div class="text-muted fs-8">على حساب شركتك</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">العمليات الناجحة</div>
                        <div class="fs-4 fw-black text-success my-1 font-monospace">@completedCount <span class="fs-7 text-muted fw-normal">بالصفحة</span></div>
                        <div class="text-muted fs-8">نفذت واكتملت بنجاح</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">قيد التنفيذ</div>
                        <div class="fs-4 fw-black text-warning my-1 font-monospace">@processingCount</div>
                        <div class="text-muted fs-8">جلسات USSD جارية</div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">العمليات المتعثرة</div>
                        <div class="fs-4 fw-black text-danger my-1 font-monospace">@failedCount</div>
                        <div class="text-muted fs-8">فشل أو انتهاء وقت الانتظار</div>
                    </div>
                    <div class="icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var txFilterBar = new SearchFilterBarModel
        {
            SearchInputId = "txSearchInput",
            SearchPlaceholder = "ابحث برقم المرجع UUID، المرجع الخاص بك، أو نص الرسالة...",
            OnSearchInput = "filterTransactions()",
            CounterId = "visibleTxCount",
            CounterLabel = "العمليات الظاهرة:",
            InitialCount = pageCount,
            ResetFiltersFunction = "resetTxFilters()",
            Filters = new List<FilterDropdownModel>
            {
                new FilterDropdownModel
                {
                    Id = "txStatusFilter",
                    Label = "معيار الحالة:",
                    Icon = "bi-funnel-fill",
                    OnChange = "onTxStatusChange(this.value)",
                    Options = new List<FilterOptionModel>
                    {
                        new FilterOptionModel("ALL", "كل الحالات", badge: pageCount.ToString(), color: "primary", isSelected: true),
                        new FilterOptionModel("COMPLETED", "المكتملة بنجاح", badge: completedCount.ToString(), color: "success"),
                        new FilterOptionModel("FAILED", "المتعثرة أو الفاشلة", badge: failedCount.ToString(), color: "danger")
                    }
                }
            }
        };
    }

    <!-- Toolbar: Search & Filter Microcomponent -->
    <div class="portal-card mb-4 shadow-sm">
        <partial name="Partials/_SearchFilterBar" model="txFilterBar" />
    </div>

    <!-- Transactions Table Card -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        <div class="table-responsive table-responsive-custom">
            <table class="table table-custom table-sticky-col align-middle mb-0" id="txMasterTable">
                <thead>
                    <tr>
                        <th style="min-width: 125px;"><span class="d-none d-sm-inline">رقم المرجع (UUID)</span><span class="d-sm-none">المرجع</span></th>
                        <th style="min-width: 150px;">المرجع الخاص بك</th>
                        <th style="min-width: 130px;">الحالة</th>
                        <th style="min-width: 250px;">الاستجابة والنتيجة</th>
                        <th style="min-width: 130px;">الرصيد قبل</th>
                        <th style="min-width: 130px;">الرصيد بعد</th>
                        <th style="min-width: 140px;">توقيت العملية</th>
                    </tr>
                </thead>
                <tbody id="txTableBody">
                    @if (!txList.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted opacity-50"></i>
                                لا توجد عمليات مسجلة حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tx in txList)
                        {
                            var statusKey = tx.Status == GoIPGateway.Domain.Enums.TransactionStatus.Completed ? "COMPLETED" : (tx.Status == GoIPGateway.Domain.Enums.TransactionStatus.Processing ? "PROCESSING" : "FAILED");
                            var searchKeywords = $"{tx.TransactionRef} {tx.ExternalRef} {tx.Message} {tx.RawResponse} {tx.Status}".ToLower();

                            <tr class="tx-row" data-status="@statusKey" data-search="@searchKeywords">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded-3 bg-light border text-primary font-monospace fs-8 d-none d-md-block" style="background: rgba(37, 99, 235, 0.05) !important;">
                                            <i class="bi bi-hash"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <code class="fw-bold fs-7 text-primary text-truncate d-inline-block" style="max-width: 115px;" title="@tx.TransactionRef">@tx.TransactionRef</code>
                                            @if (!string.IsNullOrEmpty(tx.ErrorCode))
                                            {
                                                <small class="text-danger d-none d-md-block fs-8 font-monospace">كود الخطأ: @tx.ErrorCode</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(tx.ExternalRef))
                                    {
                                        <span class="font-monospace fw-semibold text-main small">@tx.ExternalRef</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8">-</span>
                                    }
                                </td>
                                <td>
                                    @if (tx.Status == GoIPGateway.Domain.Enums.TransactionStatus.Completed)
                                    {
                                        <span class="pill-badge pill-badge-success">
                                            <span class="dot-indicator"></span>
                                            <span>مكتملة بنجاح</span>
                                        </span>
                                    }
                                    else if (tx.Status == GoIPGateway.Domain.Enums.TransactionStatus.Processing)
                                    {
                                        <span class="pill-badge pill-badge-warning">
                                            <span class="dot-indicator"></span>
                                            <span>قيد التنفيذ</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill-badge pill-badge-danger">
                                            <span class="dot-indicator"></span>
                                            <span>فشلت (@tx.Status)</span>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="text-truncate text-main small" style="max-width: 290px;" title="@(tx.Message ?? tx.RawResponse)">
                                        @(tx.Message ?? tx.RawResponse ?? "-")
                                    </div>
                                </td>
                                <td>
                                    @if (tx.SimBalanceBefore.HasValue)
                                    {
                                        <span class="font-monospace fw-semibold text-muted">@tx.SimBalanceBefore.Value.ToString("N2")</span> <small class="text-muted fs-8">ج.م</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8">-</span>
                                    }
                                </td>
                                <td>
                                    @if (tx.SimBalanceAfter.HasValue)
                                    {
                                        <span class="font-monospace fw-bold text-success">@tx.SimBalanceAfter.Value.ToString("N2")</span> <small class="text-muted fs-8">ج.م</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="text-muted small font-monospace">
                                        <i class="bi bi-clock me-1"></i>@tx.CompletedAt.ToString("yyyy-MM-dd HH:mm")
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3 border-top" style="border-color: var(--card-border) !important;">
                <span class="small text-muted">
                    عرض الصفحة <strong class="text-primary font-monospace">@Model.PageNumber</strong> من <strong class="text-main font-monospace">@Model.TotalPages</strong> (إجمالي @Model.TotalCount عملية)
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link rounded-3 me-1" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">
                            <i class="bi bi-chevron-right me-1"></i>السابق
                        </a>
                    </li>
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link rounded-3" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">
                            التالي<i class="bi bi-chevron-left ms-1"></i>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        let currentStatusFilter = 'ALL';

        function onTxStatusChange(status) {
            currentStatusFilter = status || 'ALL';
            filterTransactions();
        }

        function resetTxFilters() {
            const sInp = document.getElementById('txSearchInput');
            if (sInp) {
                sInp.value = '';
                sInp.dispatchEvent(new Event('input', { bubbles: true }));
            }
            currentStatusFilter = 'ALL';
            const sel = document.getElementById('txStatusFilter');
            if (sel) {
                sel.value = 'ALL';
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            filterTransactions();
        }

        function setStatusFilter(btn, status) {
            currentStatusFilter = status;
            const sel = document.getElementById('txStatusFilter');
            if (sel) {
                sel.value = status;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            filterTransactions();
        }

        function filterTransactions() {
            const query = (document.getElementById('txSearchInput')?.value || '').trim().toLowerCase();
            const rows = document.querySelectorAll('.tx-row');
            let visible = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status');
                const rowSearch = row.getAttribute('data-search') || '';

                const matchesStatus = (currentStatusFilter === 'ALL') || (rowStatus === currentStatusFilter);
                const matchesQuery = !query || rowSearch.includes(query);

                if (matchesStatus && matchesQuery) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleTxCount');
            if (countEl) countEl.innerText = visible;
        }
    </script>
}
