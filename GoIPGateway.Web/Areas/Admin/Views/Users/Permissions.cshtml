@model GoIPGateway.Web.Models.Users.UserPermissionsViewModel
@{
    ViewData["Title"] = $"إدارة الصلاحيات المباشرة: {Model.FullName}";
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">إدارة المستخدمين</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">الصلاحيات المباشرة</li>
        </ol>
    </nav>

    <!-- User Info Card -->
    <div class="portal-card p-4 shadow-sm mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-info bg-opacity-10 text-info fs-3" style="width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-sliders"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">@Model.FullName</h4>
                    <div class="text-muted small">
                        <span class="font-monospace">@Model.Email</span>
                        @if (!string.IsNullOrEmpty(Model.TenantName))
                        {
                            <span> • الشركة: <strong>@Model.TenantName</strong></span>
                        }
                    </div>
                </div>
            </div>

            <!-- Roles badges -->
            <div class="d-flex flex-wrap gap-1.5 align-items-center">
                <span class="text-muted small">الأدوار الممنوحة:</span>
                @foreach (var r in Model.UserRoles)
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 font-monospace">@r</span>
                }
            </div>
        </div>
    </div>

    <!-- Permissions Form -->
    <form asp-action="Permissions" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-black text-main mb-1">مصفوفة الصلاحيات المباشرة للمستخدم</h5>
                <p class="text-muted small mb-0">
                    يمكنك منح صلاحيات إضافية محددة لهذا الحساب تتجاوز أو تكمل صلاحيات الدور الممنوح له.
                </p>
            </div>
            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-check-lg me-1"></i> حفظ الصلاحيات المباشرة
            </button>
        </div>

        <div class="row g-4 mb-4">
            @foreach (var group in Model.PermissionGroups)
            {
                <div class="col-12 col-lg-6">
                    <div class="portal-card p-3 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                            <h6 class="fw-black text-main mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-folder2-open text-primary"></i>
                                <span>@group.ModuleName</span>
                            </h6>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="grp_toggle_@group.ModuleKey" data-toggle-group="@group.ModuleKey" />
                                <label class="form-check-label fs-9 text-muted fw-bold" for="grp_toggle_@group.ModuleKey">تحديد الكل</label>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            @foreach (var perm in group.Permissions)
                            {
                                var isChecked = perm.IsGrantedDirectly;
                                <div class="p-2 rounded-3 border bg-light d-flex justify-content-between align-items-center">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="selectedPermissions" 
                                               value="@perm.Code" 
                                               id="perm_@perm.Code" 
                                               data-group-perm="@group.ModuleKey"
                                               @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small fw-bold text-main" for="perm_@perm.Code">
                                            @perm.NameAr
                                            <span class="text-muted fs-9 fw-normal d-block">@perm.DescriptionAr</span>
                                        </label>
                                    </div>

                                    @if (perm.IsInheritedFromRole)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 fs-9" title="هذه الصلاحية ممنوحة بالفعل للمستخدم من خلال أحد أدواره">
                                            <i class="bi bi-check2-all"></i> موروثة من الدور
                                        </span>
                                    }
                                    else if (!perm.IsTenantAllowed)
                                    {
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-25 fs-9">
                                            إدارة النظام فقط
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center pt-2">
            <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">إلغاء والعودة</a>
            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-check-lg me-1"></i> حفظ الصلاحيات المباشرة
            </button>
        </div>
    </form>
</div>

