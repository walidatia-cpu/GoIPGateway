@model GoIPGateway.Web.Models.Users.CreateUserViewModel
@{
    ViewData["Title"] = "إضافة مستخدم جديد";
    var tenants = ViewBag.Tenants as List<GoIPGateway.Application.DTOs.Identity.TenantLookupDto> ?? new();
    var roles = ViewBag.AvailableRoles as List<GoIPGateway.Application.DTOs.Identity.RoleDto> ?? new();
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">إدارة المستخدمين</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">إضافة مستخدم</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="portal-card p-4 shadow-sm mb-4">
                <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
                    <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-3" style="width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-black mb-1 text-main">إضافة مستخدم جديد للنظام</h4>
                        <p class="text-muted small mb-0">إنشاء حساب جديد وتعيين الشركة التابع لها ومجموعة الصلاحيات مع توليد كلمة مرور مؤقتة</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

                    <!-- Personal Info -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label small fw-bold text-main"></label>
                            <input asp-for="FullName" class="form-control" placeholder="مثال: م. أحمد الشريف" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold text-main"></label>
                            <input asp-for="Email" type="email" class="form-control font-monospace" placeholder="name@company.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-bold text-main"></label>
                            <input asp-for="PhoneNumber" class="form-control font-monospace" placeholder="01xxxxxxxxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="TenantId" class="form-label small fw-bold text-main"></label>
                            <select asp-for="TenantId" class="form-select searchable-select" data-searchable="true">
                                <option value="">-- مشرف النظام العام (بدون شركة / SuperAdmin) --</option>
                                @foreach (var t in tenants)
                                {
                                    <option value="@t.Id">@t.CompanyName (@t.ContactPerson)</option>
                                }
                            </select>
                            <span class="text-muted fs-9 d-block mt-1">اترك هذا الحقل فارغاً إذا كان الحساب يتبع الإدارة المركزية للمنصة.</span>
                        </div>
                    </div>

                    <!-- Roles & Groups Selection -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-main mb-2">الأدوار والمجموعات الممنوحة للمستخدم:</label>
                        <div class="p-3 rounded-3 border bg-light bg-opacity-50">
                            <div class="row g-2">
                                @foreach (var r in roles)
                                {
                                    <div class="col-12 col-sm-6">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@r.Name" id="role_@r.Id" @(r.Name == "TenantOperator" ? "checked" : "") />
                                            <label class="form-check-label fw-bold small text-main" for="role_@r.Id">
                                                @r.Name
                                                @if (!string.IsNullOrEmpty(r.Description))
                                                {
                                                    <span class="text-muted fw-normal fs-9 d-block">@r.Description</span>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Temporary Password & Security Settings -->
                    <div class="p-3 rounded-3 border mb-4" style="background: rgba(37, 99, 235, 0.03); border-color: rgba(37, 99, 235, 0.2) !important;">
                        <h6 class="fw-bold text-primary mb-2 d-flex align-items-center gap-1.5">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>إعدادات كلمة المرور المؤقتة</span>
                        </h6>
                        <p class="text-muted fs-8 mb-3">
                            يتم تزويد المستخدم بكلمة مرور مؤقتة، وسيقوم النظام بإجباره على تعيين كلمة مرور شخصية فور أول تسجيل دخول.
                        </p>

                        <div class="row g-3">
                            <div class="col-12 col-md-7">
                                <label asp-for="TempPassword" class="form-label small fw-bold text-main"></label>
                                <div class="input-group">
                                    <input asp-for="TempPassword" id="tempPasswordInput" class="form-control font-monospace fw-bold" />
                                    <button class="btn btn-outline-secondary" type="button" data-copy-target="#tempPasswordInput" title="نسخ كلمة المرور">
                                        <i class="bi bi-clipboard"></i> نسخ
                                    </button>
                                </div>
                                <span asp-validation-for="TempPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-5 d-flex flex-column justify-content-center">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="MustChangePassword" class="form-check-input" checked />
                                    <label asp-for="MustChangePassword" class="form-check-label small fw-bold text-main"></label>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" checked />
                                    <label asp-for="IsActive" class="form-check-label small fw-bold text-main"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">إلغاء والعودة</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> حفظ وإنشاء المستخدم
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

