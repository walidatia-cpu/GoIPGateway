@model IEnumerable<GoIPGateway.Domain.Entities.Tenant>
@{
    ViewData["Title"] = "إدارة الشركات والتجار";
    var tenantsList = Model.ToList();
    var nonDeletedTenants = tenantsList.Where(t => !t.IsDelete).ToList();
    var totalTenants = nonDeletedTenants.Count;
    var activeTenants = nonDeletedTenants.Count(t => t.IsActive && !t.IsBlocked);
    var blockedTenants = nonDeletedTenants.Count(t => t.IsBlocked || !t.IsActive);
    var deletedTenants = tenantsList.Count(t => t.IsDelete);
    var totalBalance = nonDeletedTenants.Sum(t => t.Balance);
    var totalAssignedDevices = nonDeletedTenants.Sum(t => t.AssignedDevices.Count);
    var totalMaxDevices = nonDeletedTenants.Sum(t => t.MaxDevices);
}

<style>
    .tenant-avatar {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(37, 99, 235, 0.04));
        color: var(--primary-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        border: 1px solid rgba(37, 99, 235, 0.15);
        flex-shrink: 0;
    }
    .badge-status-active {
        background-color: rgba(16, 185, 129, 0.12) !important;
        color: #059669 !important;
        border: 1px solid rgba(16, 185, 129, 0.25) !important;
        font-weight: 600;
    }
    .badge-status-blocked {
        background-color: rgba(239, 68, 68, 0.12) !important;
        color: #dc2626 !important;
        border: 1px solid rgba(239, 68, 68, 0.25) !important;
        font-weight: 600;
    }
    .badge-key-pill {
        background-color: rgba(99, 102, 241, 0.1) !important;
        color: #4f46e5 !important;
        border: 1px solid rgba(99, 102, 241, 0.2) !important;
        font-weight: 600;
        transition: all 0.15s ease;
    }
    .badge-key-pill:hover {
        background-color: rgba(99, 102, 241, 0.2) !important;
        transform: translateY(-1px);
    }
    .filter-pill.active {
        background-color: var(--primary-accent) !important;
        color: #ffffff !important;
        border-color: var(--primary-accent) !important;
    }
    .table-custom tbody tr {
        transition: background-color 0.15s ease;
    }
    .table-custom tbody tr:hover {
        background-color: rgba(37, 99, 235, 0.02) !important;
    }
    .table-card-container {
        overflow: visible !important;
    }
    .table-responsive-custom {
        overflow-x: auto;
        overflow-y: visible !important;
        min-height: 280px;
        padding-bottom: 90px;
    }
    /* Modern Segmented Action Toolbar */
    .actions-pill-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(148, 163, 184, 0.08);
        padding: 3px 6px;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.2);
    }
    [data-bs-theme="dark"] .actions-pill-group {
        background: rgba(30, 41, 59, 0.7);
        border-color: rgba(51, 65, 85, 0.6);
    }
    .action-pill-btn {
        height: 30px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
    }
    .action-pill-primary {
        background-color: #ffffff;
        color: #2563eb;
        border-color: rgba(37, 99, 235, 0.25);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    .action-pill-primary:hover {
        background-color: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
    }
    .action-pill-warning {
        background-color: #ffffff;
        color: #d97706;
        border-color: rgba(245, 158, 11, 0.25);
        width: 30px;
        padding: 0;
    }
    .action-pill-warning:hover {
        background-color: #f59e0b;
        color: #ffffff;
        border-color: #f59e0b;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(245, 158, 11, 0.25);
    }
    .action-pill-more {
        background-color: #ffffff;
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.25);
        width: 30px;
        padding: 0;
    }
    .action-pill-more:hover, .action-pill-more[aria-expanded="true"] {
        background-color: #475569;
        color: #ffffff;
        border-color: #475569;
        transform: translateY(-1px);
    }
    [data-bs-theme="dark"] .action-pill-primary {
        background-color: #1e293b;
        color: #60a5fa;
        border-color: rgba(96, 165, 250, 0.3);
    }
    [data-bs-theme="dark"] .action-pill-primary:hover {
        background-color: #2563eb;
        color: #ffffff;
    }
    [data-bs-theme="dark"] .action-pill-warning {
        background-color: #1e293b;
        color: #fbbf24;
        border-color: rgba(251, 191, 36, 0.3);
    }
    [data-bs-theme="dark"] .action-pill-warning:hover {
        background-color: #d97706;
        color: #ffffff;
    }
    [data-bs-theme="dark"] .action-pill-more {
        background-color: #1e293b;
        color: #94a3b8;
        border-color: rgba(148, 163, 184, 0.3);
    }
    [data-bs-theme="dark"] .action-pill-more:hover, [data-bs-theme="dark"] .action-pill-more[aria-expanded="true"] {
        background-color: #334155;
        color: #ffffff;
    }

    .btn-restore-tenant {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #ffffff !important;
        border: none;
        box-shadow: 0 2px 6px rgba(22, 163, 74, 0.3);
        transition: all 0.2s ease;
    }
    .btn-restore-tenant:hover {
        background: linear-gradient(135deg, #15803d, #166534);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4);
    }
    .dropdown-menu-actions {
        border-radius: 12px;
        border: 1px solid var(--card-border);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        min-width: 210px;
        padding: 6px;
        z-index: 1060;
    }
    .dropdown-menu-actions .dropdown-item {
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.86rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.15s ease;
    }
    .dropdown-menu-actions .dropdown-item:hover {
        background-color: rgba(37, 99, 235, 0.08);
        color: var(--primary-accent);
    }
</style>

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">إدارة الشركات (Multi-Tenant)</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-black mb-1 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-buildings-fill fs-4"></i>
                </span>
                <span>إدارة الشركات والتجار (Multi-Tenant)</span>
            </h3>
            <p class="text-muted small mb-0">التحكم المركزي في حسابات الشركات، باقات الأجهزة، كوتة العمليات اليومية، ومفاتيح الـ API</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2">
            <i class="bi bi-building-add fs-5"></i>
            <span>إضافة شركة جديدة</span>
        </a>
    </div>

    <!-- 4 KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي الشركات</div>
                        <div class="fs-4 fw-black text-main my-1">@totalTenants</div>
                        <div class="text-muted fs-8">مستأجرين مسجلين</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">حالة الشركات</div>
                        <div class="fs-4 fw-black text-success my-1">@activeTenants <span class="fs-7 text-muted fw-normal">نشطة</span></div>
                        <div class="text-muted fs-8">@blockedTenants محظورة أو معطلة</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي الأرصدة المودعة</div>
                        <div class="fs-4 fw-black text-primary font-monospace my-1">@totalBalance.ToString("N0") <span class="fs-8 text-muted">ج.م</span></div>
                        <div class="text-muted fs-8">في محافظ الشركات</div>
                    </div>
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">أجهزة GoIP المخصصة</div>
                        <div class="fs-4 fw-black text-warning font-monospace my-1">@totalAssignedDevices <span class="fs-7 text-muted fw-normal">/ @totalMaxDevices</span></div>
                        <div class="text-muted fs-8">إجمالي الأجهزة المستغلة</div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-router"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var tenantFilterBar = new SearchFilterBarModel
        {
            SearchInputId = "tenantSearchInput",
            SearchPlaceholder = "ابحث باسم الشركة، مسؤول الاتصال، الهاتف، أو البريد...",
            OnSearchInput = "filterTenants()",
            CounterId = "visibleTenantsCount",
            CounterLabel = "الشركات الظاهرة:",
            InitialCount = totalTenants,
            ResetFiltersFunction = "resetTenantFilters()",
            Filters = new List<FilterDropdownModel>
            {
                new FilterDropdownModel
                {
                    Id = "tenantStatusFilter",
                    Label = "معيار الحالة:",
                    Icon = "bi-funnel-fill",
                    OnChange = "onTenantStatusChange(this.value)",
                    Options = new List<FilterOptionModel>
                    {
                        new FilterOptionModel("ALL", "الشركات القائمة", badge: totalTenants.ToString(), color: "primary", isSelected: true),
                        new FilterOptionModel("ACTIVE", "النشطة فقط", badge: activeTenants.ToString(), color: "success"),
                        new FilterOptionModel("BLOCKED", "المحظورة أو المعطلة", badge: blockedTenants.ToString(), color: "warning"),
                        new FilterOptionModel("DELETED", "المحذوفة مؤقتاً", badge: deletedTenants.ToString(), color: "danger")
                    }
                }
            }
        };
    }

    <!-- Toolbar: Search & Filter Microcomponent -->
    <div class="portal-card mb-4 shadow-sm">
        <partial name="Partials/_SearchFilterBar" model="tenantFilterBar" />
    </div>

    <!-- Tenants Table Card -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        <div class="table-responsive table-responsive-custom">
            <table class="table table-custom table-sticky-col align-middle mb-0">
                <thead>
                    <tr>
                        <th style="min-width: 125px;"><span class="d-none d-sm-inline">اسم الشركة</span><span class="d-sm-none">الشركة</span></th>
                        <th style="min-width: 125px;"><span class="d-none d-sm-inline">مسؤول الاتصال</span><span class="d-sm-none">المسؤول</span></th>
                        <th style="min-width: 110px;"><span class="d-none d-sm-inline">الرصيد المتاح</span><span class="d-sm-none">الرصيد</span></th>
                        <th style="min-width: 100px;"><span class="d-none d-sm-inline">كوتة الأجهزة</span><span class="d-sm-none">الأجهزة</span></th>
                        <th style="min-width: 95px;"><span class="d-none d-sm-inline">الحد اليومي</span><span class="d-sm-none">الحد</span></th>
                        <th style="min-width: 90px;">مفاتيح API</th>
                        <th style="min-width: 80px;">الحالة</th>
                        <th class="text-center" style="min-width: 130px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="tenantsTableBody">
                    @if (!tenantsList.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-buildings fs-1 d-block mb-2 text-muted opacity-50"></i>
                                لا توجد شركات مسجلة في النظام حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tenant in tenantsList)
                        {
                            var activeKeys = tenant.ApiKeys.Count(k => k.IsActive);
                            var isBlocked = tenant.IsBlocked || !tenant.IsActive;
                            var rowStatus = tenant.IsDelete ? "DELETED" : (isBlocked ? "BLOCKED" : "ACTIVE");
                            var searchKeywords = $"{tenant.CompanyName} {tenant.CompanyNameEn} {tenant.ContactPerson} {tenant.ContactEmail} {tenant.ContactPhone}".ToLower();
                            var devPercent = tenant.MaxDevices > 0 ? (tenant.AssignedDevices.Count * 100 / tenant.MaxDevices) : 0;
                            var firstLetter = !string.IsNullOrWhiteSpace(tenant.CompanyName) ? tenant.CompanyName.Substring(0, 1) : "🏢";

                            <tr class="tenant-row @(tenant.IsDelete ? "opacity-75 bg-danger bg-opacity-10" : "")" 
                                data-status="@rowStatus" 
                                data-search="@searchKeywords">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="tenant-avatar d-none d-md-flex @(tenant.IsDelete ? "border-danger text-danger bg-danger bg-opacity-10" : "")">
                                            @firstLetter
                                        </div>
                                        <div class="min-w-0">
                                            <a asp-action="Details" asp-route-id="@tenant.Id" class="fw-bold text-main text-decoration-none d-block hover-primary text-truncate" style="max-width: 120px;" title="@tenant.CompanyName">
                                                @tenant.CompanyName
                                            </a>
                                            @if (!string.IsNullOrEmpty(tenant.CompanyNameEn))
                                            {
                                                <small class="text-muted d-none d-md-block" style="font-size: 0.78rem;">@tenant.CompanyNameEn</small>
                                            }
                                            <small class="text-muted fs-8 font-monospace d-none d-sm-block">كود: #@tenant.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-main small">
                                        <i class="bi bi-person me-1 text-muted"></i>@tenant.ContactPerson
                                    </div>
                                    @if (!string.IsNullOrEmpty(tenant.ContactPhone))
                                    {
                                        <div class="text-muted fs-8 font-monospace">
                                            <i class="bi bi-telephone me-1"></i>@tenant.ContactPhone
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(tenant.ContactEmail))
                                    {
                                        <div class="text-muted fs-8">
                                            <i class="bi bi-envelope me-1"></i>@tenant.ContactEmail
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-success font-monospace fs-6">
                                        @tenant.Balance.ToString("N2") <span class="fs-8 text-muted">ج.م</span>
                                    </div>
                                    @if (tenant.CreditLimit > 0)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 fs-9 mt-1">
                                            ائتمان: @tenant.CreditLimit.ToString("N0")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-between small mb-1">
                                        <span class="font-monospace fw-bold text-main">@tenant.AssignedDevices.Count / @tenant.MaxDevices</span>
                                        <span class="text-muted fs-8">جهاز</span>
                                    </div>
                                    <div class="progress" style="height: 5px; border-radius: 4px; background: rgba(0,0,0,0.06);">
                                        <div class="progress-bar @(devPercent >= 100 ? "bg-danger" : devPercent >= 75 ? "bg-warning" : "bg-primary")" 
                                             style="width: @Math.Min(devPercent, 100)%"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace fw-bold small text-main">@tenant.MaxDailyOperations.ToString("N0")</span>
                                    <div class="text-muted fs-8">عملية / يوم</div>
                                </td>
                                <td>
                                    @if (!tenant.IsDelete)
                                    {
                                        <a asp-action="ManageTokens" asp-route-id="@tenant.Id" class="badge badge-key-pill px-2.5 py-1.5 rounded-pill text-decoration-none d-inline-flex align-items-center gap-1" title="إدارة مفاتيح الـ API">
                                            <i class="bi bi-key-fill"></i>
                                            <span>@activeKeys مفاتيح</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-muted px-2.5 py-1.5 rounded-pill d-inline-flex align-items-center gap-1" title="مفاتيح الـ API معطلة للشركة المحذوفة">
                                            <i class="bi bi-key-fill"></i>
                                            <span>معطل</span>
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (tenant.IsDelete)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1" title="تم حذف الشركة ناعماً ولن تتمكن من دخول المنصة">
                                            <i class="bi bi-trash3-fill me-1"></i> محذوفة (موقوفة)
                                        </span>
                                    }
                                    else if (!isBlocked)
                                    {
                                        <span class="badge badge-status-active rounded-pill px-2.5 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-blocked rounded-pill px-2.5 py-1" title="@tenant.BlockReason">
                                            <i class="bi bi-slash-circle-fill me-1"></i> محظور
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (tenant.IsDelete)
                                    {
                                        <!-- For deleted tenant: ONLY Show Restore button directly -->
                                        <button type="button" class="btn btn-sm btn-restore-tenant rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5" onclick="openRestoreModal(@tenant.Id, '@tenant.CompanyName')" title="استعادة الشركة وإلغاء الحذف">
                                            <i class="bi bi-arrow-counterclockwise fs-6"></i>
                                            <span>استعادة الشركة</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="actions-pill-group">
                                            <!-- زر عرض الملف السريع -->
                                            <a asp-action="Details" asp-route-id="@tenant.Id" class="action-pill-btn action-pill-primary" title="عرض تفاصيل الشركة">
                                                <i class="bi bi-eye-fill"></i>
                                                <span>عرض</span>
                                            </a>

                                            <!-- زر تعديل البيانات السريع -->
                                            <a asp-action="Edit" asp-route-id="@tenant.Id" class="action-pill-btn action-pill-warning" title="تعديل البيانات والكوتة">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- قائمة الخيارات والمزيد -->
                                            <div class="dropdown d-inline-block">
                                                <button class="action-pill-btn action-pill-more dropdown-toggle-no-caret" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="المزيد من الإجراءات">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions shadow-lg border-0 rounded-3 p-2">
                                                    <li>
                                                        <a class="dropdown-item py-2 rounded-2 fw-semibold" asp-action="ManageServices" asp-route-id="@tenant.Id">
                                                            <i class="bi bi-gear-wide-connected text-info me-2 fs-6"></i>الخدمات المصرح بها
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item py-2 rounded-2 fw-semibold" asp-action="ManageTokens" asp-route-id="@tenant.Id">
                                                            <i class="bi bi-key-fill text-primary me-2 fs-6"></i>مفاتيح الـ API والتوكنات
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    <li>
                                                        <a class="dropdown-item py-2 rounded-2 fw-semibold" href="javascript:void(0)" onclick="openKeyModal(@tenant.Id, '@tenant.CompanyName')">
                                                            <i class="bi bi-plus-circle text-success me-2 fs-6"></i>توليد مفتاح API سريع
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 rounded-2 fw-semibold text-danger" onclick="openDeleteModal(@tenant.Id, '@tenant.CompanyName')">
                                                            <i class="bi bi-trash3 text-danger me-2 fs-6"></i>حذف مؤقت (نقل للأرشيف)
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- No search matches alert microcomponent -->
        <div id="noTenantMatches" class="d-none">
            <partial name="Partials/_EmptyTableState" model='new EmptyTableStateModel {
                Icon = "bi-search",
                Title = "لم يتم العثور على شركات مطابقة",
                Message = "يرجى التأكد من كتابة الاسم أو البريد بشكل صحيح أو تغيير معيار الحالة المحدد.",
                ResetActionClick = "resetTenantFilters()"
            }' />
        </div>
    </div>
</div>

<!-- Modal Soft Delete Tenant -->
<div class="modal fade" id="deleteTenantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Delete" method="post" class="modal-content shadow-lg border-0 rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteTenantId" />
            <div class="modal-header border-bottom py-3 bg-danger bg-opacity-10">
                <div class="d-flex align-items-center gap-2 text-danger">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <h5 class="modal-title fw-bold">تأكيد حذف الشركة (Soft Delete)</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-3 fs-6">هل أنت متأكد من رغبتك في حذف شركة <strong id="deleteTenantName" class="text-danger"></strong>؟</p>
                <div class="alert alert-warning small mb-0 rounded-3">
                    <i class="bi bi-shield-lock-fill me-1"></i>
                    <strong>إجراءات الحماية التلقائية بعد الحذف:</strong>
                    <ul class="mb-0 mt-2 ps-3">
                        <li><strong>منع تسجيل الدخول:</strong> لن يتمكن أي مستخدم أو تاجر تابع للشركة من دخول المنصة.</li>
                        <li><strong>إيقاف مفاتيح API:</strong> سيتم تعطيل مفاتيح الربط وتوقف استقبال طلبات الـ USSD للشركة.</li>
                        <li><strong>حفظ البيانات التاريخية:</strong> لن تُحذف المعاملات أو الأرصدة، ويمكنك استعادة الشركة في أي وقت.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-danger btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-trash3-fill me-1"></i> تأكيد الحذف والإيقاف
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Restore Tenant -->
<div class="modal fade" id="restoreTenantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Restore" method="post" class="modal-content shadow-lg border-0 rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="restoreTenantId" />
            <div class="modal-header border-bottom py-3 bg-success bg-opacity-10">
                <div class="d-flex align-items-center gap-2 text-success">
                    <i class="bi bi-arrow-counterclockwise fs-5"></i>
                    <h5 class="modal-title fw-bold">استعادة الشركة المحذوفة</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 fs-6">هل أنت متأكد من رغبتك في استعادة شركة <strong id="restoreTenantName" class="text-success"></strong>؟</p>
                <p class="text-muted small mb-0">سيتم إلغاء الحذف وإعادة تفعيل الشركة والسماح لمستخدميها بالدخول إلى المنصة مرة أخرى.</p>
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-success btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> تأكيد الاستعادة الآن
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Generate API Key -->
<div class="modal fade" id="apiKeyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="GenerateApiKey" method="post" class="modal-content shadow-lg border-0 rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tenantId" id="modalTenantId" />
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-key-fill fs-5"></i>
                    </div>
                    <h5 class="modal-title fw-bold" id="modalTenantName">توليد مفتاح API</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3">
                    <label class="form-label small text-muted fw-bold">اسم ووصف المفتاح (Key Label) <span class="text-danger">*</span></label>
                    <input type="text" name="keyName" class="form-control" placeholder="مثال: Production Server Key, POS Terminal" value="Production Key" required />
                    <small class="text-muted mt-1 d-block">سيتم توليد مفتاح سري فريد برمز بادئة مخصص للشركة.</small>
                </div>
            </div>
            <div class="modal-footer border-top py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-lightning-charge-fill me-1"></i> توليد المفتاح الآن
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentStatusFilter = 'ALL';

        function onTenantStatusChange(val) {
            currentStatusFilter = val || 'ALL';
            filterTenants();
        }

        function setStatusFilter(btn, filter) {
            currentStatusFilter = filter;
            const sel = document.getElementById('tenantStatusFilter');
            if (sel) {
                sel.value = filter;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            filterTenants();
        }

        function filterTenants() {
            const query = (document.getElementById('tenantSearchInput')?.value || '').trim().toLowerCase();
            const rows = document.querySelectorAll('.tenant-row');
            let totalVisible = 0;

            rows.forEach(r => {
                const rowStatus = r.getAttribute('data-status') || 'ACTIVE';
                const rowSearch = (r.getAttribute('data-search') || '').toLowerCase();

                let matchesStatus = false;
                if (currentStatusFilter === 'ALL') {
                    matchesStatus = (rowStatus !== 'DELETED');
                } else if (currentStatusFilter === 'DELETED') {
                    matchesStatus = (rowStatus === 'DELETED');
                } else {
                    matchesStatus = (rowStatus === currentStatusFilter);
                }

                const matchesQuery = (!query || rowSearch.includes(query));

                if (matchesStatus && matchesQuery) {
                    r.style.display = '';
                    totalVisible++;
                } else {
                    r.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleTenantsCount');
            if (countEl) countEl.innerText = totalVisible;

            const noMatches = document.getElementById('noTenantMatches');
            if (noMatches) {
                noMatches.classList.toggle('d-none', totalVisible > 0 || rows.length === 0);
            }
        }

        function resetTenantFilters() {
            const sInp = document.getElementById('tenantSearchInput');
            if (sInp) {
                sInp.value = '';
                sInp.dispatchEvent(new Event('input', { bubbles: true }));
            }
            currentStatusFilter = 'ALL';
            const sel = document.getElementById('tenantStatusFilter');
            if (sel) {
                sel.value = 'ALL';
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            filterTenants();
        }

        function openKeyModal(tenantId, name) {
            document.getElementById('modalTenantId').value = tenantId;
            document.getElementById('modalTenantName').innerText = 'توليد مفتاح API لـ ' + name;
            new bootstrap.Modal(document.getElementById('apiKeyModal')).show();
        }

        function openDeleteModal(tenantId, name) {
            document.getElementById('deleteTenantId').value = tenantId;
            document.getElementById('deleteTenantName').innerText = name;
            new bootstrap.Modal(document.getElementById('deleteTenantModal')).show();
        }

        function openRestoreModal(tenantId, name) {
            document.getElementById('restoreTenantId').value = tenantId;
            document.getElementById('restoreTenantName').innerText = name;
            new bootstrap.Modal(document.getElementById('restoreTenantModal')).show();
        }

        // Initialize table filtering to show active/non-deleted by default
        document.addEventListener("DOMContentLoaded", function () {
            filterTenants();
        });
    </script>
}
