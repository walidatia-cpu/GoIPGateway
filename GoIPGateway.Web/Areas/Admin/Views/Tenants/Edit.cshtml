@model GoIPGateway.Domain.Entities.Tenant
@{
    ViewData["Title"] = $"تعديل بيانات الشركة: {Model.CompanyName}";
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">إدارة الشركات</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">تعديل: @Model.CompanyName</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2" style="width: 58px; height: 58px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">تعديل بيانات الشركة المستأجرة</h4>
                    <div class="text-muted small">
                        الشركة: <strong class="text-primary">@Model.CompanyName</strong> 
                        <span class="badge bg-light text-dark font-monospace border ms-2">ID: #@Model.Id</span>
                        <span class="badge @(Model.IsActive && !Model.IsBlocked ? "bg-success" : "bg-danger") ms-1">
                            @(Model.IsActive && !Model.IsBlocked ? "نشط" : "محظور / متوقف")
                        </span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-eye me-1"></i> عرض الملف
                </a>
                <a asp-action="ManageServices" asp-route-id="@Model.Id" class="btn btn-outline-primary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-gear-wide me-1"></i> الخدمات
                </a>
                <a asp-action="ManageTokens" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-key me-1"></i> التوكنات
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold">
                    <i class="bi bi-arrow-right me-1"></i> العودة
                </a>
            </div>
        </div>
    </div>

    <!-- Edit Form Card -->
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="portal-card p-4 p-md-5 shadow-sm">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <!-- 1. الأساسية -->
                    <div class="mb-4">
                        <h6 class="fw-black text-main pb-2 border-bottom d-flex align-items-center gap-2">
                            <i class="bi bi-buildings text-primary"></i>
                            <span>1. البيانات الأساسية للشركة</span>
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted fw-bold">اسم الشركة بالعربية <span class="text-danger">*</span></label>
                                <input asp-for="CompanyName" class="form-control" required />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted fw-bold">اسم الشركة بالإنجليزية</label>
                                <input asp-for="CompanyNameEn" class="form-control" />
                                <span asp-validation-for="CompanyNameEn" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted">الرقم الضريبي / السجل التجاري</label>
                                <input asp-for="TaxId" class="form-control" placeholder="123-456-789" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted">العنوان والمقر الرئيسي</label>
                                <input asp-for="Address" class="form-control" placeholder="القاهرة، مصر" />
                            </div>
                        </div>
                    </div>

                    <!-- 2. التواصل -->
                    <div class="mb-4">
                        <h6 class="fw-black text-main pb-2 border-bottom d-flex align-items-center gap-2">
                            <i class="bi bi-person-lines-fill text-primary"></i>
                            <span>2. بيانات مسؤول التواصل</span>
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted">اسم المسؤول / جهة الاتصال</label>
                                <input asp-for="ContactPerson" class="form-control" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">رقم الهاتف للتواصل</label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="010XXXXXXXX" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">البريد الإلكتروني للشركة</label>
                                <input asp-for="ContactEmail" type="email" class="form-control" />
                                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. الكوتة والحدود -->
                    <div class="mb-4">
                        <h6 class="fw-black text-main pb-2 border-bottom d-flex align-items-center gap-2">
                            <i class="bi bi-speedometer2 text-primary"></i>
                            <span>3. كوتة الأجهزة وحدود العمليات (Quotas & Limits)</span>
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small text-muted fw-bold">كوتة أجهزة GoIP المسموحة <span class="text-danger">*</span></label>
                                <input asp-for="MaxDevices" type="number" min="1" max="1000" class="form-control font-monospace fw-bold text-primary" required />
                                <div class="text-muted fs-8 mt-1">تحدد عدد الأجهزة التي تستطيع الشركة تسجيلها في لوحتها</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small text-muted fw-bold">حد العمليات اليومي <span class="text-danger">*</span></label>
                                <input asp-for="MaxDailyOperations" type="number" min="1" class="form-control font-monospace" required />
                                <div class="text-muted fs-8 mt-1">أقصى عدد طلبات/عمليات في اليوم الواحد</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small text-muted fw-bold">حد العمليات الشهري</label>
                                <input asp-for="MaxMonthlyOps" type="number" min="1" class="form-control font-monospace" />
                                <div class="text-muted fs-8 mt-1">أقصى عدد طلبات شهرياً</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small text-muted fw-bold">حد الائتمان (Credit Limit)</label>
                                <div class="input-group">
                                    <input asp-for="CreditLimit" type="number" step="0.01" min="0" class="form-control font-monospace" />
                                    <span class="input-group-text">ج.م</span>
                                </div>
                                <div class="text-muted fs-8 mt-1">سقف السحب المسموح به</div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. الأمان والحالة -->
                    <div class="mb-4">
                        <h6 class="fw-black text-main pb-2 border-bottom d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock text-primary"></i>
                            <span>4. حالة الحساب والأمان</span>
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <div class="form-check form-switch mb-1">
                                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="chkIsActive" />
                                        <label class="form-check-label fw-bold text-main" for="chkIsActive">تفعيل حساب الشركة</label>
                                    </div>
                                    <div class="text-muted fs-8">عند إلغاء التفعيل، يتم إيقاف دخول مستخدمي الشركة وتوقف كافة طلبات الـ API</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 rounded-3 border bg-light h-100">
                                    <div class="form-check form-switch mb-1">
                                        <input class="form-check-input" type="checkbox" asp-for="IsBlocked" id="chkIsBlocked" onchange="toggleBlockReason(this.checked)" />
                                        <label class="form-check-label fw-bold text-danger" for="chkIsBlocked">حظر حساب الشركة (Block Tenant)</label>
                                    </div>
                                    <div class="text-muted fs-8">يمنع تنفيذ أي معاملات كاش أو USSD عبر أجهزة الشركة</div>
                                </div>
                            </div>

                            <div class="col-12" id="blockReasonGroup" style="display: @(Model.IsBlocked ? "block" : "none");">
                                <label class="form-label small text-danger fw-bold">سبب الحظر (يظهر للشركة عند محاولة التنفيذ)</label>
                                <textarea asp-for="BlockReason" class="form-control border-danger" rows="2" placeholder="اكتب سبب إيقاف أو حظر الشركة..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-bold">
                            إلغاء والعودة
                        </a>
                        <button type="submit" class="btn btn-primary px-5 py-2.5 fw-bold shadow">
                            <i class="bi bi-check-circle-fill me-1"></i> حفظ وتحديث بيانات الشركة
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleBlockReason(isBlocked) {
            const grp = document.getElementById('blockReasonGroup');
            if (grp) {
                grp.style.display = isBlocked ? 'block' : 'none';
            }
        }
    </script>
}
