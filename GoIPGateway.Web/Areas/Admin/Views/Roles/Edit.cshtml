@model GoIPGateway.Web.Models.Roles.CreateOrEditRoleViewModel
@{
    ViewData["Title"] = $"تعديل مجموعة الصلاحيات: {Model.Name}";
    var tenants = ViewBag.Tenants as List<GoIPGateway.Application.DTOs.Identity.TenantLookupDto> ?? new();
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">مجموعات الصلاحيات</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">تعديل المجموعة</li>
        </ol>
    </nav>

    <div class="portal-card p-4 shadow-sm mb-4">
        <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-3" style="width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-1 text-main">@Model.Name</h4>
                    <p class="text-muted small mb-0">@(Model.IsSystemRole ? "دور نظام أساسي - الصلاحيات قابلة للتعديل والتوسيع" : "مجموعة مخصصة")</p>
                </div>
            </div>

            @if (Model.IsSystemRole)
            {
                <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill font-monospace">
                    <i class="bi bi-shield-check me-1"></i> دور نظام أساسي
                </span>
            }
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IsSystemRole" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <label asp-for="Name" class="form-label small fw-bold text-main"></label>
                    <input asp-for="Name" class="form-control" readonly="@(Model.IsSystemRole ? "readonly" : null)" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                    @if (Model.IsSystemRole)
                    {
                        <span class="text-muted fs-9 d-block mt-1">لا يمكن تعديل اسم أدوار النظام الأساسية.</span>
                    }
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="Description" class="form-label small fw-bold text-main"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="TenantId" class="form-label small fw-bold text-main"></label>
                    <select asp-for="TenantId" class="form-select searchable-select" data-searchable="true" disabled="@(Model.IsSystemRole ? "disabled" : null)">
                        <option value="">-- مجموعة عامة لكافة الشركات أو النظام --</option>
                        @foreach (var t in tenants)
                        {
                            <option value="@t.Id" selected="@(Model.TenantId == t.Id)">@t.CompanyName</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Permissions Matrix -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-black text-main mb-1">الصلاحيات الممنوحة للمجموعة</h5>
                        <p class="text-muted small mb-0">اختر الصلاحيات الفعالة الممنوحة لكافة المستخدمين المنتمين لهذا الدور</p>
                    </div>
                </div>

                <div class="row g-4">
                    @foreach (var group in Model.PermissionGroups)
                    {
                        <div class="col-12 col-lg-6">
                            <div class="portal-card p-3 shadow-sm h-100 border">
                                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                                    <h6 class="fw-black text-main mb-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-folder2-open text-primary"></i>
                                        <span>@group.ModuleName</span>
                                    </h6>
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="grp_toggle_@group.ModuleKey" data-toggle-group="@group.ModuleKey" />
                                        <label class="form-check-label fs-9 text-muted fw-bold" for="grp_toggle_@group.ModuleKey">تحديد الكل</label>
                                    </div>
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    @foreach (var perm in group.Permissions)
                                    {
                                        var isChecked = Model.SelectedPermissions.Contains(perm.Code);
                                        <div class="p-2 rounded-3 border bg-light d-flex justify-content-between align-items-center">
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" 
                                                       type="checkbox" 
                                                       name="SelectedPermissions" 
                                                       value="@perm.Code" 
                                                       id="perm_@perm.Code" 
                                                       data-group-perm="@group.ModuleKey"
                                                       @(isChecked ? "checked" : "") />
                                                <label class="form-check-label small fw-bold text-main" for="perm_@perm.Code">
                                                    @perm.NameAr
                                                    <span class="text-muted fs-9 fw-normal d-block">@perm.DescriptionAr</span>
                                                </label>
                                            </div>

                                            @if (!perm.IsTenantAllowed)
                                            {
                                                <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-25 fs-9">
                                                    إدارة النظام فقط
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">إلغاء والعودة</a>
                <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
                </button>
            </div>
        </form>
    </div>
</div>

