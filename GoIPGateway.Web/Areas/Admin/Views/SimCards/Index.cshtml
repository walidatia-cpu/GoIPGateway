@model IEnumerable<GoIPGateway.Domain.Entities.SimCard>
@{
    ViewData["Title"] = "إدارة الشرايح ومحافظ الكاش";
    var simList = Model.ToList();
    var totalSims = simList.Count;
    var activeSims = simList.Count(s => s.IsActive && !s.IsBlocked);
    var blockedSims = simList.Count(s => s.IsBlocked || !s.IsActive);
    var totalBalance = simList.Sum(s => s.CurrentBalance);
    var totalConsumed = simList.Sum(s => s.DailyConsumed);

    int vfCount = simList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Vodafone);
    int orCount = simList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Orange);
    int etCount = simList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Etisalat);
    int weCount = simList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.WE);
}

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">إدارة الشرايح ومحافظ الكاش</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-black mb-1 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-sim-fill fs-4"></i>
                </span>
                <span>إدارة الشرايح ومحافظ الكاش</span>
            </h3>
            <p class="text-muted small mb-0">إدارة خطوط المحافظ الذكية، كلمات السر (PIN)، الأرصدة اللحظية والحدود اليومية لبوابات GoIP</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill fs-5"></i>
                <span>إضافة شريحة جديدة</span>
            </a>
        </div>
    </div>

    <!-- 4 KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي الشرايح</div>
                        <div class="fs-4 fw-black text-main my-1 font-monospace">@totalSims</div>
                        <div class="text-muted fs-8">خطوط مركبة بالبوابات</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-sim"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">حالة الخطوط</div>
                        <div class="fs-4 fw-black text-success my-1 font-monospace">@activeSims <span class="fs-7 text-muted fw-normal">جاهزة</span></div>
                        <div class="text-muted fs-8">@blockedSims متوقفة أو محظورة</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي أرصدة المحافظ</div>
                        <div class="fs-4 fw-black text-primary font-monospace my-1">@totalBalance.ToString("N0") <span class="fs-8 text-muted">ج.م</span></div>
                        <div class="text-muted fs-8">رصيد كاش جاهز للعمليات</div>
                    </div>
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">استهلاك اليوم</div>
                        <div class="fs-4 fw-black text-warning font-monospace my-1">@totalConsumed.ToString("N0") <span class="fs-8 text-muted">ج.م</span></div>
                        <div class="text-muted fs-8">إجمالي مبالغ العمليات المنفذة</div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var simFilterBar = new SearchFilterBarModel
        {
            SearchInputId = "simSearchInput",
            SearchPlaceholder = "ابحث برقم الهاتف، اسم البورت، أو الشبكة...",
            OnSearchInput = "filterSims()",
            CounterId = "visibleSimCount",
            CounterLabel = "الخطوط الظاهرة:",
            InitialCount = totalSims,
            ResetFiltersFunction = "resetSimFilters()",
            Filters = new List<FilterDropdownModel>
            {
                new FilterDropdownModel
                {
                    Id = "simOpFilter",
                    Label = "معيار الشبكة:",
                    Icon = "bi-broadcast",
                    OnChange = "onSimOpChange(this.value)",
                    Options = new List<FilterOptionModel>
                    {
                        new FilterOptionModel("ALL", "كل الشبكات", badge: totalSims.ToString(), color: "primary", isSelected: true),
                        new FilterOptionModel("Vodafone", "فودافون كاش", badge: vfCount.ToString(), color: "danger"),
                        new FilterOptionModel("Orange", "أورانج كاش", badge: orCount.ToString(), color: "warning"),
                        new FilterOptionModel("Etisalat", "اتصالات كاش", badge: etCount.ToString(), color: "success"),
                        new FilterOptionModel("WE", "وي باي (WE)", badge: weCount.ToString(), color: "info")
                    }
                }
            }
        };
    }

    <!-- Toolbar: Search & Filter Microcomponent -->
    <div class="portal-card mb-4 shadow-sm">
        <partial name="Partials/_SearchFilterBar" model="simFilterBar" />
    </div>

    <!-- SIM Cards Table Card -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        <div class="table-responsive table-responsive-custom">
            <table class="table table-custom table-sticky-col align-middle mb-0" id="simMasterTable">
                <thead>
                    <tr>
                        <th style="min-width: 120px;"><span class="d-none d-sm-inline">البورت / الجهاز</span><span class="d-sm-none">المنفذ</span></th>
                        <th style="min-width: 130px;">الشبكة</th>
                        <th style="min-width: 150px;">رقم الخط</th>
                        <th style="min-width: 140px;">باسورد المحفظة (PIN)</th>
                        <th style="min-width: 140px;">الرصيد اللحظي</th>
                        <th style="min-width: 160px;">الاستهلاك / الحد اليومي</th>
                        <th style="min-width: 110px;">الحالة</th>
                        <th class="text-center" style="min-width: 140px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="simTableBody">
                    @if (!simList.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-sim fs-1 d-block mb-2 text-muted opacity-50"></i>
                                لا توجد شرايح مسجلة. اضغط على "إضافة شريحة جديدة" لربط أول خط بالبورت.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sim in simList)
                        {
                            var opKey = sim.Operator.ToString();
                            var searchKeywords = $"{sim.PhoneNumber} {sim.DevicePort?.PortLabel} {sim.DevicePort?.Device?.DeviceName} {sim.Operator}".ToLower();

                            <tr class="sim-row" id="sim-row-@sim.Id" data-op="@opKey" data-search="@searchKeywords">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="row-avatar d-none d-md-flex" style="width: 40px; height: 40px; font-size: 1rem;">
                                            <i class="bi bi-cpu"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="fw-bold text-main text-truncate" style="max-width: 120px;">@(sim.DevicePort?.PortLabel ?? "بورت " + sim.DevicePortId)</div>
                                            <small class="text-muted d-none d-md-block fs-8 text-truncate" style="max-width: 120px;">@(sim.DevicePort?.Device?.DeviceName ?? "-")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @switch (sim.Operator)
                                    {
                                        case GoIPGateway.Domain.Enums.OperatorType.Vodafone:
                                            <span class="pill-telecom pill-op-vodafone">
                                                <span class="dot-indicator"></span>فودافون كاش
                                            </span>
                                            break;
                                        case GoIPGateway.Domain.Enums.OperatorType.Orange:
                                            <span class="pill-telecom pill-op-orange">
                                                <span class="dot-indicator"></span>أورانج كاش
                                            </span>
                                            break;
                                        case GoIPGateway.Domain.Enums.OperatorType.Etisalat:
                                            <span class="pill-telecom pill-op-etisalat">
                                                <span class="dot-indicator"></span>اتصالات كاش
                                            </span>
                                            break;
                                        default:
                                            <span class="pill-telecom pill-op-we">
                                                <span class="dot-indicator"></span>وي باي WE
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold fs-6 font-monospace text-main">@(sim.PhoneNumber ?? "غير محدد")</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span id="pin-text-@sim.Id" class="font-monospace fw-bold text-warning">••••••</span>
                                        @if (!string.IsNullOrEmpty(sim.WalletPassword))
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-muted p-0" onclick="togglePin(@sim.Id, '@sim.WalletPassword')" title="إظهار / إخفاء كلمة السر">
                                                <i id="pin-icon-@sim.Id" class="bi bi-eye"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="pill-badge pill-badge-danger fs-8">بدون PIN</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success font-monospace fs-6" id="sim-bal-@sim.Id">@sim.CurrentBalance.ToString("N2") <small class="text-muted fs-8">ج.م</small></div>
                                    @if (sim.LastBalanceCheck.HasValue)
                                    {
                                        <small class="text-muted fs-8 font-monospace"><i class="bi bi-clock me-1"></i>@sim.LastBalanceCheck.Value.ToString("HH:mm")</small>
                                    }
                                </td>
                                <td>
                                    <div class="small fw-bold font-monospace">@sim.DailyConsumed.ToString("N0") / @(sim.DailyLimit > 0 ? sim.DailyLimit.ToString("N0") : "∞") <small class="text-muted fs-8">ج.م</small></div>
                                    <div class="progress mt-1 rounded-pill" style="height: 5px;">
                                        @{
                                            var percent = sim.DailyLimit > 0 ? Math.Min(100, (int)((sim.DailyConsumed / sim.DailyLimit) * 100)) : 0;
                                        }
                                        <div class="progress-bar @(percent > 80 ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @percent%;"></div>
                                    </div>
                                </td>
                                <td>
                                    @if (sim.IsActive && !sim.IsBlocked)
                                    {
                                        <span class="pill-badge pill-badge-success">
                                            <span class="dot-indicator"></span>جاهزة للعمل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pill-badge pill-badge-danger">
                                            <span class="dot-indicator"></span>معطلة
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="actions-pill-group justify-content-center">
                                        <!-- Edit SIM & PIN -->
                                        <a asp-action="Edit" asp-route-id="@sim.Id" class="action-pill-btn action-pill-warning" title="تعديل بيانات الشريحة والباسورد">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Dropdown for more options -->
                                        <div class="dropdown d-inline-block">
                                            <button class="action-pill-btn action-pill-more dropdown-toggle-no-caret" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="المزيد من الإجراءات">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions shadow-lg border-0 rounded-3 p-2">
                                                <li>
                                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@sim.Id" />
                                                        <button type="submit" class="dropdown-item py-2 rounded-2 fw-semibold @(sim.IsActive ? "text-warning" : "text-success")">
                                                            <i class="bi @(sim.IsActive ? "bi-pause-circle text-warning" : "bi-play-circle text-success") me-2 fs-6"></i>@(sim.IsActive ? "تعطيل الشريحة مؤقتاً" : "تفعيل الشريحة للعمل")
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <form asp-action="Delete" method="post" class="d-inline"
                                                          data-confirm="true"
                                                          data-confirm-title="حذف الشريحة وتحرير البورت"
                                                          data-confirm-message="هل أنت متأكد من حذف هذه الشريحة نهائياً وتحرير البورت؟"
                                                          data-confirm-detail="@sim.PhoneNumber (@sim.Operator) - بورت @(sim.DevicePort?.PortLabel ?? sim.DevicePortId.ToString())"
                                                          data-confirm-detail-label="الشريحة:"
                                                          data-confirm-consequence="سيتم إخراج الشريحة من منظومة الربط وتفريغ المنفذ على جهاز GoIP."
                                                          data-confirm-btn="نعم، حذف الشريحة"
                                                          data-confirm-type="danger">
                                                        <input type="hidden" name="id" value="@sim.Id" />
                                                        <button type="submit" class="dropdown-item py-2 rounded-2 fw-semibold text-danger">
                                                            <i class="bi bi-trash3 text-danger me-2 fs-6"></i>حذف الشريحة وتحرير المنفذ
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentOpFilter = 'ALL';

        function onSimOpChange(op) {
            currentOpFilter = op || 'ALL';
            filterSims();
        }

        function resetSimFilters() {
            const sInp = document.getElementById('simSearchInput');
            if (sInp) {
                sInp.value = '';
                sInp.dispatchEvent(new Event('input', { bubbles: true }));
            }
            currentOpFilter = 'ALL';
            const sel = document.getElementById('simOpFilter');
            if (sel) {
                sel.value = 'ALL';
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            filterSims();
        }

        function setOpFilter(btn, op) {
            currentOpFilter = op;
            const sel = document.getElementById('simOpFilter');
            if (sel) {
                sel.value = op;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            filterSims();
        }

        function filterSims() {
            const query = (document.getElementById('simSearchInput')?.value || '').trim().toLowerCase();
            const rows = document.querySelectorAll('.sim-row');
            let visible = 0;

            rows.forEach(row => {
                const rowOp = row.getAttribute('data-op');
                const rowSearch = row.getAttribute('data-search') || '';

                const matchesOp = (currentOpFilter === 'ALL') || (rowOp === currentOpFilter);
                const matchesQuery = !query || rowSearch.includes(query);

                if (matchesOp && matchesQuery) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('visibleSimCount');
            if (countEl) countEl.innerText = visible;
        }

        function togglePin(simId, realPin) {
            const label = document.getElementById("pin-text-" + simId);
            const icon = document.getElementById("pin-icon-" + simId);
            if (!label) return;

            if (label.innerText === "••••••") {
                label.innerText = realPin;
                label.classList.remove("text-warning");
                label.classList.add("text-success");
                if (icon) icon.className = "bi bi-eye-slash";
            } else {
                label.innerText = "••••••";
                label.classList.remove("text-success");
                label.classList.add("text-warning");
                if (icon) icon.className = "bi bi-eye";
            }
        }

        window.addEventListener("goip:simBalanceChanged", function (e) {
            const sim = e.detail;
            const balLabel = document.getElementById("sim-bal-" + sim.id);
            if (balLabel) {
                balLabel.innerText = sim.currentBalance.toFixed(2) + " ج.م";
                balLabel.classList.add("text-warning");
                setTimeout(() => balLabel.classList.remove("text-warning"), 2500);
            }
        });
    </script>
}
