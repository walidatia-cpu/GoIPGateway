@model GoIPGateway.Domain.Entities.SimCard
@{
    ViewData["Title"] = $"تعديل الشريحة - {Model.PhoneNumber}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="portal-card p-4 p-md-5 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--card-border);">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-4 bg-warning bg-opacity-10 text-warning fs-3">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">تعديل بيانات الشريحة: @Model.PhoneNumber</h4>
                        <p class="text-muted small mb-0">مركبة على البورت <strong>@(Model.DevicePort?.PortLabel ?? "Port")</strong> في جهاز <strong>@(Model.DevicePort?.Device?.DeviceName ?? "GoIP")</strong></p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DevicePortId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 rounded-3" role="alert"></div>

                <!-- Operator & Phone Number -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">شركة المحمول (الشبكة) <span class="text-danger">*</span></label>
                        <select asp-for="Operator" class="form-select" asp-items="Html.GetEnumSelectList<GoIPGateway.Domain.Enums.OperatorType>()" required></select>
                        <span asp-validation-for="Operator" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">رقم هاتف الشريحة (المحفظة) <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Wallet PIN/Password & Current Balance -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-warning">
                            <i class="bi bi-key-fill me-1"></i> الرقم السري لمحفظة كاش (Wallet PIN) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="WalletPassword" id="editWalletPin" type="password" class="form-control fs-6 fw-bold" required />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleEditPin()" title="إظهار / إخفاء">
                                <i id="togglePinIcon" class="bi bi-eye"></i>
                            </button>
                        </div>
                        <small class="text-muted">الرقم السري للمحفظة المستخدم لتأكيد USSD</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">الرصيد الحالي للشريحة (ج.م)</label>
                        <input asp-for="CurrentBalance" type="number" step="0.01" min="0" class="form-control text-success fw-bold" />
                        <small class="text-muted">يتحدث تلقائياً عند طلب استعلام الرصيد</small>
                    </div>
                </div>

                <!-- Limits -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">الحد الأقصى اليومي (ج.م)</label>
                        <input asp-for="DailyLimit" type="number" step="100" min="0" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">الحد الأقصى الشهري (ج.م)</label>
                        <input asp-for="MonthlyLimit" type="number" step="1000" min="0" class="form-control" />
                    </div>
                </div>

                <!-- Status Checkboxes -->
                <div class="row g-3 mb-4 p-3 rounded-3" style="background: var(--bg-app); border: 1px solid var(--card-border);">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                            <label class="form-check-label fw-bold" for="isActiveSwitch">الشريحة مفعلة وجاهزة للعمل</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input asp-for="IsBlocked" class="form-check-input" type="checkbox" id="isBlockedSwitch">
                            <label class="form-check-label fw-bold text-danger" for="isBlockedSwitch">حظر الشريحة (إيقاف الطوارئ)</label>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted">ملاحظات إضافية</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary py-3 fw-bold fs-6 shadow rounded-3">
                        <i class="bi bi-save me-2"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleEditPin() {
            const input = document.getElementById("editWalletPin");
            const icon = document.getElementById("togglePinIcon");
            if (input.type === "password") {
                input.type = "text";
                icon.className = "bi bi-eye-slash";
            } else {
                input.type = "password";
                icon.className = "bi bi-eye";
            }
        }
    </script>
}
