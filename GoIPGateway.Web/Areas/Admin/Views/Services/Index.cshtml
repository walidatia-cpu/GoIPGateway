@model IEnumerable<GoIPGateway.Domain.Entities.ServiceDefinition>
@{
    ViewData["Title"] = "إدارة الخدمات";

    var servicesList = Model.ToList();
    var totalServices = servicesList.Count;

    // Grouping by Category Standard
    var paymentServices = servicesList.Where(s => s.Category == GoIPGateway.Domain.Enums.ServiceCategory.Payment || s.Category == GoIPGateway.Domain.Enums.ServiceCategory.Transfer).ToList();
    var balanceServices = servicesList.Where(s => s.Category == GoIPGateway.Domain.Enums.ServiceCategory.Inquiry || s.Category == GoIPGateway.Domain.Enums.ServiceCategory.BalanceInquiry).ToList();
    var numberServices = servicesList.Where(s => s.Category == GoIPGateway.Domain.Enums.ServiceCategory.NumberInquiry).ToList();
    var otherServices = servicesList.Except(paymentServices).Except(balanceServices).Except(numberServices).ToList();

    // Egyptian Operators counts
    int vfCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Vodafone);
    int orCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Orange);
    int etCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.Etisalat);
    int weCount = servicesList.Count(s => s.Operator == GoIPGateway.Domain.Enums.OperatorType.WE);
    int generalCount = servicesList.Count(s => s.Operator == null);
}

<style>
    /* Premium Telecom Brand Pills (Soft, Eye-Friendly, Non-glaring) */
    .pill-telecom {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.2px;
    }
    .pill-telecom .dot-indicator {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }
    .pill-op-vodafone {
        background-color: rgba(225, 29, 72, 0.08) !important;
        color: #be123c !important;
        border: 1px solid rgba(225, 29, 72, 0.2) !important;
    }
    .pill-op-vodafone .dot-indicator { background-color: #e11d48; }

    .pill-op-orange {
        background-color: rgba(249, 115, 22, 0.08) !important;
        color: #c2410c !important;
        border: 1px solid rgba(249, 115, 22, 0.2) !important;
    }
    .pill-op-orange .dot-indicator { background-color: #ea580c; }

    .pill-op-etisalat {
        background-color: rgba(22, 163, 74, 0.08) !important;
        color: #15803d !important;
        border: 1px solid rgba(22, 163, 74, 0.2) !important;
    }
    .pill-op-etisalat .dot-indicator { background-color: #16a34a; }

    .pill-op-we {
        background-color: rgba(147, 51, 234, 0.08) !important;
        color: #7e22ce !important;
        border: 1px solid rgba(147, 51, 234, 0.2) !important;
    }
    .pill-op-we .dot-indicator { background-color: #9333ea; }

    .pill-op-general {
        background-color: rgba(100, 116, 139, 0.08) !important;
        color: #475569 !important;
        border: 1px solid rgba(100, 116, 139, 0.2) !important;
    }
    .pill-op-general .dot-indicator { background-color: #64748b; }

    /* Category Badges */
    .badge-cat {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .badge-cat-payment {
        background-color: rgba(37, 99, 235, 0.08);
        color: #1d4ed8;
        border: 1px solid rgba(37, 99, 235, 0.18);
    }
    .badge-cat-inquiry {
        background-color: rgba(6, 182, 212, 0.08);
        color: #0e7490;
        border: 1px solid rgba(6, 182, 212, 0.2);
    }
    .badge-cat-number {
        background-color: rgba(245, 158, 11, 0.08);
        color: #b45309;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .badge-cat-other {
        background-color: rgba(100, 116, 139, 0.08);
        color: #475569;
        border: 1px solid rgba(100, 116, 139, 0.2);
    }

    /* Financial Impact Badges */
    .badge-impact {
        display: inline-flex;
        align-items: center;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-impact-add {
        background-color: rgba(16, 185, 129, 0.1);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-impact-deduct {
        background-color: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
    .badge-impact-neutral {
        background-color: rgba(100, 116, 139, 0.08);
        color: #64748b;
        border: 1px solid rgba(100, 116, 139, 0.15);
    }

    /* USSD Steps Pill */
    .badge-steps {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 8px;
        background-color: rgba(234, 179, 8, 0.1);
        color: #b45309;
        border: 1px solid rgba(234, 179, 8, 0.25);
        font-size: 0.78rem;
        font-weight: 700;
        transition: all 0.15s ease;
    }
    .badge-steps:hover {
        background-color: rgba(234, 179, 8, 0.2);
        color: #92400e;
        transform: translateY(-1px);
    }
    .badge-steps-empty {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 8px;
        background-color: rgba(100, 116, 139, 0.06);
        color: #94a3b8;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .service-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(37, 99, 235, 0.04));
        color: var(--primary-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
        border: 1px solid rgba(37, 99, 235, 0.15);
    }
</style>

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">إدارة الخدمات (Services Catalog)</li>
        </ol>
    </nav>

    <!-- Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-black mb-1 d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-gear-wide-connected fs-4"></i>
                </span>
                <span>كتالوج الخدمات وأوامر USSD (Services Catalog)</span>
            </h3>
            <p class="text-muted small mb-0">تعريف وتهيئة خدمات المحافظ الذكية، أكواد الـ API، وسلاسل أوامر USSD التفاعلية</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Searchable Service Quick Jump Combobox -->
            <div class="searchable-combobox position-relative" id="adminServiceQuickJump" style="min-width: 260px;">
                <div class="combobox-trigger d-flex align-items-center justify-content-between p-2 rounded-3 border bg-white cursor-pointer shadow-xs" onclick="toggleAdminQuickJump(event)">
                    <span class="text-muted small d-flex align-items-center gap-1.5 text-truncate">
                        <i class="bi bi-search text-primary"></i>
                        <span id="adminQuickJumpText">انتقال وبحث سريع لخدمة...</span>
                    </span>
                    <i class="bi bi-chevron-down text-muted fs-9 ms-1.5"></i>
                </div>
                <div class="combobox-menu shadow-lg p-2 rounded-3 bg-white border position-absolute end-0 z-3" id="adminQuickJumpMenu" style="min-width: 310px; display: none; top: calc(100% + 5px);">
                    <div class="p-1 mb-2 sticky-top bg-white border-bottom">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" id="adminQuickJumpSearch" class="form-control border-start-0 fs-7" 
                                   placeholder="ابحث باسم الخدمة أو الكود..." 
                                   onkeyup="filterAdminQuickJump(this.value)" 
                                   onclick="event.stopPropagation()" />
                        </div>
                    </div>
                    <div id="adminQuickJumpItems" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var srv in servicesList)
                        {
                            var sSearch = $"{srv.NameAr} {srv.NameEn} {srv.ServiceCode} {srv.Operator}".ToLower();
                            <div class="combobox-item p-2 rounded-2 mb-1 border-bottom border-light" data-search="@sSearch">
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="me-2 text-truncate">
                                        <a asp-action="Details" asp-route-id="@srv.Id" class="text-decoration-none fw-bold text-main fs-7 d-block text-truncate">
                                            @srv.NameAr
                                        </a>
                                        <small class="text-muted font-monospace fs-9">@srv.ServiceCode • @(srv.Operator?.ToString() ?? "عام")</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                        <a asp-action="ConfigureSteps" asp-route-id="@srv.Id" class="btn btn-xs btn-outline-warning px-1.5 py-0.5 rounded" title="تهيئة USSD">
                                            <i class="bi bi-sliders"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div id="adminQuickJumpNoResults" class="text-center py-3 text-muted small d-none">
                        لا توجد خدمات مطابقة
                    </div>
                </div>
            </div>

            <a asp-action="Create" class="btn btn-primary px-3.5 py-2 fw-bold shadow-sm rounded-3 d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle-fill fs-5"></i>
                <span>إضافة خدمة جديدة</span>
            </a>
        </div>
    </div>

    <!-- 4 Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">إجمالي الخدمات</div>
                        <div class="fs-4 fw-black text-main my-1">@totalServices</div>
                        <div class="text-muted fs-8">خدمة جاهزة للاستخدام</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-collection"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">دفع وتحويل كاش</div>
                        <div class="fs-4 fw-black text-success my-1">@paymentServices.Count</div>
                        <div class="text-muted fs-8">سداد تجار وسحب</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-credit-card-2-front"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">استعلام رصيد</div>
                        <div class="fs-4 fw-black text-info my-1">@balanceServices.Count</div>
                        <div class="text-muted fs-8">أرصدة المحافظ اللحظية</div>
                    </div>
                    <div class="icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-search"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card-stat p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold">استعلام وتأكيد رقم</div>
                        <div class="fs-4 fw-black text-warning my-1">@numberServices.Count</div>
                        <div class="text-muted fs-8">اكتشاف أرقام الخطوط</div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-phone"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Unified Filters Toolbar -->
    <div class="portal-card p-3 mb-4 shadow-sm">
        <!-- Row 1: Search & Toggle -->
        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="serviceSearchInput" class="form-control border-start-0" 
                           placeholder="ابحث باسم الخدمة، كود الـ API (مثل VF_PAY)، أو الشبكة..." 
                           onkeyup="filterCatalog()" />
                </div>
            </div>

            <div class="col-12 col-md-6 d-flex align-items-center gap-3 justify-content-md-end flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" id="btnActiveOnly" onclick="toggleActiveOnly(this)">
                    <i class="bi bi-toggle2-on me-1"></i> النشطة فقط
                </button>
                <div class="text-muted small">
                    عرض <strong class="text-primary font-monospace" id="visibleCount">@totalServices</strong> من أصل @totalServices خدمة
                </div>
            </div>
        </div>

        <!-- Row 2: Telecom Networks Filter Pills -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
            <span class="text-muted small fw-bold me-2"><i class="bi bi-sim me-1"></i> تصفية بالشبكة:</span>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-pill active" data-op="ALL" onclick="filterByOp(this, 'ALL')">
                كل الشبكات (@totalServices)
            </button>
            @if (generalCount > 0)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-pill" data-op="General" onclick="filterByOp(this, 'General')">
                    🌐 عامة / لكافة الشبكات (@generalCount)
                </button>
            }
            <button type="button" class="btn btn-sm pill-op-vodafone rounded-pill px-3 filter-pill" data-op="Vodafone" onclick="filterByOp(this, 'Vodafone')">
                <span class="dot-indicator"></span> فودافون كاش (@vfCount)
            </button>
            <button type="button" class="btn btn-sm pill-op-orange rounded-pill px-3 filter-pill" data-op="Orange" onclick="filterByOp(this, 'Orange')">
                <span class="dot-indicator"></span> أورانج كاش (@orCount)
            </button>
            <button type="button" class="btn btn-sm pill-op-etisalat rounded-pill px-3 filter-pill" data-op="Etisalat" onclick="filterByOp(this, 'Etisalat')">
                <span class="dot-indicator"></span> اتصالات كاش (@etCount)
            </button>
            <button type="button" class="btn btn-sm pill-op-we rounded-pill px-3 filter-pill" data-op="WE" onclick="filterByOp(this, 'WE')">
                <span class="dot-indicator"></span> وي باي WE (@weCount)
            </button>
        </div>

        <!-- Row 3: Category Tabs -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-2 mt-2 border-top">
            <span class="text-muted small fw-bold me-2"><i class="bi bi-tags me-1"></i> تصفية بالتصنيف:</span>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-cat-tab active" data-cat="ALL" onclick="filterByCat(this, 'ALL')">
                كل التصنيفات (@totalServices)
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 filter-cat-tab" data-cat="Payment" onclick="filterByCat(this, 'Payment')">
                💳 دفع وتحويل كاش (@paymentServices.Count)
            </button>
            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 filter-cat-tab" data-cat="Inquiry" onclick="filterByCat(this, 'Inquiry')">
                🔍 استعلام رصيد (@balanceServices.Count)
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 filter-cat-tab" data-cat="NumberInquiry" onclick="filterByCat(this, 'NumberInquiry')">
                📱 استعلام رقم (@numberServices.Count)
            </button>
            @if (otherServices.Any())
            {
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-cat-tab" data-cat="Other" onclick="filterByCat(this, 'Other')">
                    ⚙️ خدمات أخرى (@otherServices.Count)
                </button>
            }
        </div>
    </div>

    <!-- Unified Master Services Table Card -->
    <div class="portal-card shadow-sm table-card-container mb-4">
        <div class="table-responsive table-responsive-custom">
            <table class="table table-custom align-middle mb-0" id="servicesMasterTable">
                <thead>
                    <tr>
                        <th style="min-width: 220px;">اسم الخدمة</th>
                        <th style="min-width: 140px;">كود الـ API</th>
                        <th style="min-width: 130px;">الشبكة</th>
                        <th style="min-width: 120px;">التصنيف</th>
                        <th style="min-width: 120px;">التأثير المالي</th>
                        <th style="min-width: 90px;">الرسوم</th>
                        <th style="min-width: 110px;">أوامر USSD</th>
                        <th style="min-width: 80px;">الحالة</th>
                        <th class="text-center" style="min-width: 140px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!servicesList.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-collection fs-1 d-block mb-2 text-muted opacity-50"></i>
                                لا توجد خدمات مضافة حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var srv in servicesList)
                        {
                            @await Html.PartialAsync("_ServiceTableRowPartial", srv)
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- No search matches alert -->
        <div id="noCatalogMatches" class="p-5 text-center d-none">
            <i class="bi bi-search fs-1 text-muted opacity-50 d-block mb-2"></i>
            <h6 class="fw-bold mb-1 text-main">لم يتم العثور على خدمات مطابقة</h6>
            <p class="text-muted small mb-3">جرب تغيير كلمات البحث أو اختيار شبكة أو تصنيف آخر.</p>
            <button type="button" class="btn btn-sm btn-outline-secondary px-3" onclick="resetCatalogFilters()">
                إعادة ضبط كل الفلاتر
            </button>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let currentOp = 'ALL';
        let currentCat = 'ALL';
        let activeOnly = false;

        function filterByOp(btn, op) {
            document.querySelectorAll(".filter-pill").forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
            currentOp = op;
            filterCatalog();
        }

        function filterByCat(btn, cat) {
            document.querySelectorAll(".filter-cat-tab").forEach(p => p.classList.remove("active"));
            btn.classList.add("active");
            currentCat = cat;
            filterCatalog();
        }

        function toggleActiveOnly(btn) {
            activeOnly = !activeOnly;
            if (activeOnly) {
                btn.classList.remove("btn-outline-primary");
                btn.classList.add("btn-primary");
            } else {
                btn.classList.remove("btn-primary");
                btn.classList.add("btn-outline-primary");
            }
            filterCatalog();
        }

        function resetCatalogFilters() {
            document.getElementById('serviceSearchInput').value = '';
            currentOp = 'ALL';
            currentCat = 'ALL';
            activeOnly = false;

            const activeBtn = document.getElementById('btnActiveOnly');
            if (activeBtn) {
                activeBtn.classList.remove('btn-primary');
                activeBtn.classList.add('btn-outline-primary');
            }

            document.querySelectorAll('.filter-pill').forEach(p => {
                p.classList.toggle('active', p.getAttribute('data-op') === 'ALL');
            });

            document.querySelectorAll('.filter-cat-tab').forEach(p => {
                p.classList.toggle('active', p.getAttribute('data-cat') === 'ALL');
            });

            filterCatalog();
        }

        function filterCatalog() {
            const query = (document.getElementById('serviceSearchInput')?.value || '').trim().toLowerCase();
            const rows = document.querySelectorAll('.service-table-row');
            let totalVisible = 0;

            rows.forEach(r => {
                const rowOp = r.getAttribute('data-op') || 'ALL';
                const rowCat = r.getAttribute('data-cat') || '';
                const rowActive = r.getAttribute('data-active') === 'true';
                const rowSearch = (r.getAttribute('data-search') || '').toLowerCase();

                const matchesOp = (currentOp === 'ALL')
                               || (currentOp === 'General' && (rowOp === 'General' || rowOp === 'ALL'))
                               || (rowOp === currentOp || rowOp === 'General' || rowOp === 'ALL');
                const matchesCat = (currentCat === 'ALL' || rowCat === currentCat);
                const matchesActive = (!activeOnly || rowActive);
                const matchesQuery = (!query || rowSearch.includes(query));

                if (matchesOp && matchesCat && matchesActive && matchesQuery) {
                    r.style.display = '';
                    totalVisible++;
                } else {
                    r.style.display = 'none';
                }
            });

            const counter = document.getElementById('visibleCount');
            if (counter) counter.innerText = totalVisible;

            const noMatches = document.getElementById('noCatalogMatches');
            if (noMatches) {
                noMatches.classList.toggle('d-none', totalVisible > 0 || rows.length === 0);
            }
        }

        function openDeleteServiceModal(id, name, code) {
            showConfirmModal({
                title: 'تأكيد حذف الخدمة',
                message: 'هل أنت متأكد من حذف هذه الخدمة نهائياً من الكتالوج؟',
                detail: name + ' (' + code + ')',
                detailLabel: 'الخدمة:',
                consequence: 'سيتم نقل الخدمة للمحذوفات وتعطيلها في بوابة الـ Gateway فوراً، ولن تتمكن الشركات من استدعائها.',
                btnText: 'نعم، حذف الخدمة',
                type: 'danger',
                onConfirm: function () {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Admin/Services/Delete/' + id;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = '__RequestVerificationToken';
                        hidden.value = token.value;
                        form.appendChild(hidden);
                    }
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }


        // Admin Searchable Quick Jump Combobox
        function toggleAdminQuickJump(e) {
            e.stopPropagation();
            const menu = document.getElementById("adminQuickJumpMenu");
            if (!menu) return;
            const isShown = menu.style.display === "block";
            if (isShown) {
                closeAdminQuickJump();
            } else {
                menu.style.display = "block";
                const inp = document.getElementById("adminQuickJumpSearch");
                if (inp) {
                    inp.value = '';
                    filterAdminQuickJump('');
                    setTimeout(() => inp.focus(), 50);
                }
            }
        }

        function closeAdminQuickJump() {
            const menu = document.getElementById("adminQuickJumpMenu");
            if (menu) menu.style.display = "none";
        }

        function filterAdminQuickJump(query) {
            const q = (query || '').trim().toLowerCase();
            const items = document.querySelectorAll("#adminQuickJumpItems .combobox-item");
            let visible = 0;
            items.forEach(el => {
                const s = el.getAttribute("data-search") || "";
                if (!q || s.includes(q)) {
                    el.style.display = "";
                    visible++;
                } else {
                    el.style.display = "none";
                }
            });
            const noRes = document.getElementById("adminQuickJumpNoResults");
            if (noRes) noRes.classList.toggle("d-none", visible > 0);
        }

        document.addEventListener("click", function (e) {
            const box = document.getElementById("adminServiceQuickJump");
            if (box && !box.contains(e.target)) {
                closeAdminQuickJump();
            }
        });
    </script>
}
