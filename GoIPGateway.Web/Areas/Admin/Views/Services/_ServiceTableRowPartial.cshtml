@model GoIPGateway.Domain.Entities.ServiceDefinition
@{
    var srv = Model;
    var opKey = srv.Operator?.ToString() ?? "ALL";
    var stepCount = srv.UssdSteps.Count(s => !s.IsDelete);

    var opArabic = srv.Operator switch
    {
        GoIPGateway.Domain.Enums.OperatorType.Vodafone => "فودافون كاش",
        GoIPGateway.Domain.Enums.OperatorType.Orange => "أورانج كاش",
        GoIPGateway.Domain.Enums.OperatorType.Etisalat => "اتصالات كاش",
        GoIPGateway.Domain.Enums.OperatorType.WE => "وي باي WE",
        _ => "عامة"
    };

    var opPillClass = srv.Operator switch
    {
        GoIPGateway.Domain.Enums.OperatorType.Vodafone => "pill-op-vodafone",
        GoIPGateway.Domain.Enums.OperatorType.Orange => "pill-op-orange",
        GoIPGateway.Domain.Enums.OperatorType.Etisalat => "pill-op-etisalat",
        GoIPGateway.Domain.Enums.OperatorType.WE => "pill-op-we",
        _ => "pill-op-general"
    };

    var catArabic = srv.Category switch
    {
        GoIPGateway.Domain.Enums.ServiceCategory.Payment => "دفع تاجر",
        GoIPGateway.Domain.Enums.ServiceCategory.Transfer => "تحويل كاش",
        GoIPGateway.Domain.Enums.ServiceCategory.Inquiry => "استعلام رصيد",
        GoIPGateway.Domain.Enums.ServiceCategory.NumberInquiry => "استعلام رقم",
        GoIPGateway.Domain.Enums.ServiceCategory.Settlement => "تسوية وسحب",
        _ => srv.Category.ToString()
    };

    var catGroupKey = srv.Category switch
    {
        GoIPGateway.Domain.Enums.ServiceCategory.Payment or GoIPGateway.Domain.Enums.ServiceCategory.Transfer => "Payment",
        GoIPGateway.Domain.Enums.ServiceCategory.Inquiry => "Inquiry",
        GoIPGateway.Domain.Enums.ServiceCategory.NumberInquiry => "NumberInquiry",
        _ => "Other"
    };

    var searchKeywords = $"{srv.NameAr} {srv.NameEn} {srv.ServiceCode} {opArabic} {catArabic} {opKey} {srv.Category}".ToLower();
}

<tr class="service-table-row" 
    data-op="@opKey" 
    data-cat="@catGroupKey" 
    data-active="@(srv.IsActive ? "true" : "false")"
    data-search="@searchKeywords">
    <td>
        <div class="d-flex align-items-center gap-2.5">
            <div class="service-icon-box">
                <i class="bi @(string.IsNullOrEmpty(srv.IconClass) ? "bi-lightning-charge" : srv.IconClass)"></i>
            </div>
            <div>
                <a asp-action="Details" asp-route-id="@srv.Id" class="fw-bold text-main fs-6 text-decoration-none d-block hover-primary">
                    @srv.NameAr
                </a>
                @if (!string.IsNullOrEmpty(srv.NameEn))
                {
                    <small class="text-muted d-block" style="font-size: 0.78rem;">@srv.NameEn</small>
                }
            </div>
        </div>
    </td>
    <td>
        <span class="service-code-chip" title="كود الخدمة في الـ API">
            <code>@srv.ServiceCode</code>
        </span>
    </td>
    <td>
        <span class="pill-telecom @opPillClass">
            <span class="dot-indicator"></span>
            <span>@opArabic</span>
        </span>
    </td>
    <td>
        @switch (catGroupKey)
        {
            case "Payment":
                <span class="badge-cat badge-cat-payment">
                    <i class="bi bi-credit-card-2-front me-1"></i> @catArabic
                </span>
                break;
            case "Inquiry":
                <span class="badge-cat badge-cat-inquiry">
                    <i class="bi bi-search me-1"></i> @catArabic
                </span>
                break;
            case "NumberInquiry":
                <span class="badge-cat badge-cat-number">
                    <i class="bi bi-phone me-1"></i> @catArabic
                </span>
                break;
            default:
                <span class="badge-cat badge-cat-other">
                    <i class="bi bi-gear me-1"></i> @catArabic
                </span>
                break;
        }
    </td>
    <td>
        @switch (srv.BalanceActionType)
        {
            case GoIPGateway.Domain.Enums.BalanceActionType.Increment:
                <span class="badge-impact badge-impact-add">
                    <i class="bi bi-plus-circle-fill me-1"></i> إضافة (+)
                </span>
                break;
            case GoIPGateway.Domain.Enums.BalanceActionType.Decrement:
                <span class="badge-impact badge-impact-deduct">
                    <i class="bi bi-dash-circle-fill me-1"></i> خصم (-)
                </span>
                break;
            default:
                <span class="badge-impact badge-impact-neutral">
                    <i class="bi bi-dash me-1"></i> بدون تأثير
                </span>
                break;
        }
    </td>
    <td>
        <span class="font-monospace fw-bold text-main">@srv.BaseCost.ToString("N2")</span> <small class="text-muted fs-8">ج.م</small>
    </td>
    <td>
        @if (stepCount > 0)
        {
            <a asp-action="ConfigureSteps" asp-route-id="@srv.Id" class="badge-steps text-decoration-none" title="تعديل خطوات USSD">
                <i class="bi bi-sliders me-1"></i> @stepCount خطوة
            </a>
        }
        else
        {
            <span class="badge-steps-empty">
                0 خطوة
            </span>
        }
    </td>
    <td>
        <form asp-action="ToggleStatus" asp-route-id="@srv.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <div class="form-check form-switch m-0 d-inline-block">
                <input class="form-check-input cursor-pointer" type="checkbox" role="switch" @(srv.IsActive ? "checked" : "") onchange="this.form.submit()" title="تبديل التفعيل اللحظي">
            </div>
        </form>
    </td>
    <td class="text-center">
        <div class="actions-btn-group justify-content-center">
            <!-- Action 1: View Details -->
            <a asp-action="Details" asp-route-id="@srv.Id" class="btn-action-icon btn-action-view" title="عرض التفاصيل">
                <i class="bi bi-eye"></i>
            </a>

            <!-- Action 2: Configure USSD Steps -->
            <a asp-action="ConfigureSteps" asp-route-id="@srv.Id" class="btn-action-icon" style="color: #b45309;" title="تهيئة خطوات USSD (@stepCount خطوة)">
                <i class="bi bi-sliders"></i>
            </a>

            <!-- Action 3: Test Service Directly -->
            <button type="button" class="btn-action-icon" style="color: #059669;" title="تجربة واختبار الخدمة مباشرة على GoIP" onclick="openTestServiceModal('@srv.ServiceCode', '@srv.NameAr', '@srv.Category', '@opArabic')">
                <i class="bi bi-play-circle-fill"></i>
            </button>

            <!-- Action 4: Dropdown for more actions -->
            <div class="dropdown">
                <button class="btn-action-icon" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="خيارات إضافية">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions">
                    <li>
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@srv.Id">
                            <i class="bi bi-pencil-square text-warning"></i>تعديل بيانات الخدمة
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="openDeleteServiceModal(@srv.Id, '@srv.NameAr', '@srv.ServiceCode')">
                            <i class="bi bi-trash"></i>حذف الخدمة
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </td>
</tr>
