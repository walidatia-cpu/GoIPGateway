@model GoIPGateway.Domain.Entities.ServiceDefinition
@using GoIPGateway.Domain.Common
@{
    ViewData["Title"] = $"خطوات أوامر USSD: {Model.NameAr}";
    var steps = Model.UssdSteps.Where(s => !s.IsDelete).OrderBy(s => s.StepOrder).ToList();

    var opBadge = Model.Operator switch
    {
        GoIPGateway.Domain.Enums.OperatorType.Vodafone => "badge-op-vodafone",
        GoIPGateway.Domain.Enums.OperatorType.Orange => "badge-op-orange",
        GoIPGateway.Domain.Enums.OperatorType.Etisalat => "badge-op-etisalat",
        GoIPGateway.Domain.Enums.OperatorType.WE => "badge-op-we",
        _ => "bg-secondary text-white"
    };

    var opArabic = Model.Operator switch
    {
        GoIPGateway.Domain.Enums.OperatorType.Vodafone => "فودافون كاش",
        GoIPGateway.Domain.Enums.OperatorType.Orange => "أورانج كاش",
        GoIPGateway.Domain.Enums.OperatorType.Etisalat => "اتصالات كاش",
        GoIPGateway.Domain.Enums.OperatorType.WE => "وي باي WE",
        _ => "عامة"
    };

    string FormatUssdDisplay(string cmd)
    {
        if (string.IsNullOrEmpty(cmd)) return "";
        var formatted = System.Web.HttpUtility.HtmlEncode(cmd);
        formatted = formatted.Replace("{Password}", "<span class=\"ussd-tag tag-pwd\"><i class=\"bi bi-key-fill\"></i> {Password}</span>");
        formatted = formatted.Replace("{Pin}", "<span class=\"ussd-tag tag-pwd\"><i class=\"bi bi-key-fill\"></i> {Pin}</span>");
        formatted = formatted.Replace("{Amount}", "<span class=\"ussd-tag tag-amt\"><i class=\"bi bi-cash\"></i> {Amount}</span>");
        formatted = formatted.Replace("{MobileNumber}", "<span class=\"ussd-tag tag-phone\"><i class=\"bi bi-phone\"></i> {MobileNumber}</span>");
        formatted = formatted.Replace("{PhoneNumber}", "<span class=\"ussd-tag tag-phone\"><i class=\"bi bi-phone\"></i> {PhoneNumber}</span>");
        formatted = formatted.Replace("{MerchantCode}", "<span class=\"ussd-tag tag-merchant\"><i class=\"bi bi-shop\"></i> {MerchantCode}</span>");
        formatted = formatted.Replace("{SimNumber}", "<span class=\"ussd-tag tag-phone\"><i class=\"bi bi-sim\"></i> {SimNumber}</span>");
        formatted = formatted.Replace("{NationalId}", "<span class=\"ussd-tag tag-custom\"><i class=\"bi bi-person-vcard\"></i> {NationalId}</span>");
        formatted = formatted.Replace("{AccountNumber}", "<span class=\"ussd-tag tag-custom\"><i class=\"bi bi-file-earmark-text\"></i> {AccountNumber}</span>");
        formatted = formatted.Replace("{InvoiceNumber}", "<span class=\"ussd-tag tag-custom\"><i class=\"bi bi-receipt\"></i> {InvoiceNumber}</span>");
        formatted = formatted.Replace("{OtpCode}", "<span class=\"ussd-tag tag-custom\"><i class=\"bi bi-shield-lock\"></i> {OtpCode}</span>");
        return formatted;
    }
}

<style>
    /* Step Number Badge */
    .step-order-pill {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1rem;
        background: linear-gradient(135deg, var(--primary-accent, #2563eb), #1d4ed8);
        color: #ffffff;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
    }

    /* Modern USSD Code Container (Strict horizontal flow, NO word-break vertical wrap) */
    .ussd-code-box {
        direction: ltr !important;
        text-align: left !important;
        unicode-bidi: isolate !important;
        font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace !important;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.4px;
        background: #0f172a;
        color: #38bdf8;
        padding: 8px 14px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
        white-space: nowrap !important;
        overflow-x: auto;
        word-break: normal !important;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
    }

    [data-bs-theme="light"] .ussd-code-box {
        background: #1e293b;
        color: #38bdf8;
        border-color: #334155;
    }

    .ussd-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0;
        white-space: nowrap !important;
    }
    .tag-pwd { background: rgba(245, 158, 11, 0.22); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); }
    .tag-amt { background: rgba(16, 185, 129, 0.22); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); }
    .tag-phone { background: rgba(14, 165, 233, 0.22); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.35); }
    .tag-merchant { background: rgba(168, 85, 247, 0.22); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.35); }
    .tag-custom { background: rgba(99, 102, 241, 0.22); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.35); }

    /* Pill Badges (High Contrast, No Opacity Glitches) */
    .pill-badge {
        font-size: 0.78rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        line-height: 1.2;
    }
    .pill-badge-success {
        background: #ecfdf5 !important;
        color: #047857 !important;
        border: 1px solid #a7f3d0 !important;
    }
    .pill-badge-danger {
        background: #fef2f2 !important;
        color: #b91c1c !important;
        border: 1px solid #fecaca !important;
    }
    .actions-btn-group {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Action Buttons in Table */
    .btn-action-step {
        padding: 5px 10px;
        font-size: 0.82rem;
        border-radius: 8px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.15s ease;
    }
</style>

<div class="container-xl px-0 py-2">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">لوحة التحكم</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">كتالوج الخدمات</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-muted">@Model.NameAr</a></li>
            <li class="breadcrumb-item active text-main fw-bold" aria-current="page">خطوات أوامر USSD</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="portal-card p-4 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-primary fs-2" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi @(string.IsNullOrEmpty(Model.IconClass) ? "bi-terminal" : Model.IconClass)"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <h4 class="fw-black mb-0 text-main">@Model.NameAr</h4>
                        <span class="badge @opBadge px-2.5 py-1 rounded-pill fs-8">
                            @opArabic
                        </span>
                        <code class="font-monospace text-primary fw-bold bg-primary bg-opacity-10 px-2.5 py-1 rounded-2 fs-8 border border-primary border-opacity-25">
                            @Model.ServiceCode
                        </code>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill fs-8">
                                <i class="bi bi-check-circle-fill me-1"></i>نشطة
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2.5 py-1 rounded-pill fs-8">
                                <i class="bi bi-x-circle-fill me-1"></i>معطلة
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
                        <span><i class="bi bi-tag me-1 text-primary"></i> التصنيف: <strong>@Model.Category</strong></span>
                        <span>•</span>
                        <span><i class="bi bi-cash me-1 text-success"></i> الرسوم الأساسية: <strong class="text-success">@Model.BaseCost.ToString("N2") ج.م</strong></span>
                        <span>•</span>
                        <span><i class="bi bi-layers me-1 text-primary"></i> إجمالي الخطوات: <strong class="text-primary">@steps.Count</strong></span>
                    </div>
                </div>
            </div>

            <!-- Top Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-action="CreateStep" asp-route-serviceId="@Model.Id" class="btn btn-primary fw-black px-3.5 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>إضافة خطوة جديدة</span>
                </a>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info px-3 py-2 rounded-3 fw-bold" title="عرض تفاصيل الخدمة">
                    <i class="bi bi-eye me-1"></i> تفاصيل الخدمة
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-bold" title="العودة لكتالوج الخدمات">
                    <i class="bi bi-arrow-right me-1"></i> رجوع للخدمات
                </a>
            </div>
        </div>
    </div>

    <!-- USSD Steps Table Card -->
    <div class="portal-card p-4 shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h5 class="fw-black mb-0 d-flex align-items-center gap-2 text-main">
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-list-ol fs-5"></i>
                </span>
                <span>مسار وخطوات تنفيذ أوامر الـ USSD (@steps.Count خطوات)</span>
            </h5>
            <a asp-action="CreateStep" asp-route-serviceId="@Model.Id" class="btn btn-sm btn-primary fw-bold px-3 rounded-pill">
                <i class="bi bi-plus-lg me-1"></i> إضافة خطوة
            </a>
        </div>

        @if (!steps.Any())
        {
            <div class="text-center py-5 border rounded-4 border-dashed bg-light bg-opacity-50">
                <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning d-inline-block mb-3">
                    <i class="bi bi-terminal fs-1"></i>
                </div>
                <h5 class="fw-bold text-main mb-1">لا توجد خطوات USSD معرفة لهذه الخدمة بعد</h5>
                <p class="text-muted small mb-3">قم بإضافة الخطوات التفاعلية التي سترسلها بوابة الـ Gateway إلى شرائح الـ GoIP بالترتيب.</p>
                <a asp-action="CreateStep" asp-route-serviceId="@Model.Id" class="btn btn-primary px-4 py-2 rounded-3 fw-bold">
                    <i class="bi bi-plus-circle-fill me-1"></i> إضافة أول خطوة الآن
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8">
                        <tr>
                            <th style="width: 60px;" class="text-center">#</th>
                            <th style="min-width: 150px;">عنوان الخطوة</th>
                            <th style="min-width: 280px;">أمر الـ USSD وقوالب المتغيرات</th>
                            <th style="min-width: 170px;">شروط النجاح</th>
                            <th style="min-width: 170px;">شروط الفشل والرد البديل</th>
                            <th style="min-width: 110px;">المهلة / التأخير</th>
                            <th style="width: 170px;" class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in steps)
                        {
                            var successRules = step.ParsedSuccessRules;
                            var failureRules = step.ParsedFailureRules;

                            <tr>
                                <td class="text-center">
                                    <span class="step-order-pill">@step.StepOrder</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-main">@(string.IsNullOrEmpty(step.StepTitle) ? $"خطوة {step.StepOrder}" : step.StepTitle)</div>
                                    <div class="text-muted fs-9 mt-0.5">
                                        <span class="badge bg-light text-muted border font-monospace">ID: #@step.Id</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <div class="ussd-code-box" dir="ltr" title="@step.UssdCommand">
                                            @Html.Raw(FormatUssdDisplay(step.UssdCommand))
                                        </div>
                                        <button type="button" class="btn btn-xs btn-outline-secondary p-1 border-0" onclick="navigator.clipboard.writeText('@step.UssdCommand'); showAlertModal('تم نسخ أمر الـ USSD إلى الحافظة بنجاح.', 'تم النسخ', 'success');" title="نسخ الأمر">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    @if (successRules.Any())
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var s in successRules)
                                            {
                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                    <span class="pill-badge pill-badge-success">
                                                        <i class="bi bi-check-lg me-0.5"></i>@s.Pattern
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(s.ClientMessage))
                                                    {
                                                        <span class="text-muted fs-9" title="الرد للعميل: @s.ClientMessage">
                                                            ➔ @(s.ClientMessage.Length > 18 ? s.ClientMessage[..18] + "..." : s.ClientMessage)
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border fs-9">
                                            <i class="bi bi-lightning-charge me-1"></i>NoNeedToWait (فوري)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (failureRules.Any())
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var f in failureRules)
                                            {
                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                    <span class="pill-badge pill-badge-danger">
                                                        <i class="bi bi-x-lg me-0.5"></i>@f.Pattern
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(f.ClientMessage))
                                                    {
                                                        <span class="text-muted fs-9" title="الرد البديل للعميل: @f.ClientMessage">
                                                            ➔ @(f.ClientMessage.Length > 18 ? f.ClientMessage[..18] + "..." : f.ClientMessage)
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-9">فحص تلقائي</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="badge bg-light text-dark border font-monospace fs-9 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-stopwatch text-primary"></i> مهلة: @step.TimeoutSeconds ث
                                        </span>
                                        <span class="badge bg-light text-muted border font-monospace fs-9 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-hourglass-split text-warning"></i> تأخير: @step.DelayAfterMs م.ث
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="actions-pill-group justify-content-center">
                                        <!-- Action 1: View Step Details -->
                                        <a asp-action="StepDetails" asp-route-id="@step.Id" class="action-pill-btn action-pill-primary" title="عرض تفاصيل الخطوة">
                                            <i class="bi bi-eye-fill"></i>
                                            <span>عرض</span>
                                        </a>

                                        <!-- Action 2: Quick Edit Step -->
                                        <a asp-action="EditStep" asp-route-id="@step.Id" class="action-pill-btn action-pill-warning" title="تعديل بيانات وأوامر الخطوة">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Action 3: Dropdown More Actions -->
                                        <div class="dropdown d-inline-block">
                                            <button class="action-pill-btn action-pill-more dropdown-toggle-no-caret" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="المزيد">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions shadow-lg border-0 rounded-3 p-2">
                                                <li>
                                                    <form asp-action="DeleteStep" method="post"
                                                          data-confirm="true"
                                                          data-confirm-title="حذف خطوة USSD"
                                                          data-confirm-message="هل أنت متأكد من حذف هذه الخطوة من مسار التنفيذ؟"
                                                          data-confirm-detail="خطوة رقم #@step.StepOrder: @(step.StepTitle ?? step.UssdCommand)"
                                                          data-confirm-detail-label="الخطوة:"
                                                          data-confirm-consequence="سيؤدي حذف الخطوة إلى تعديل تسلسل الخطوات البرمجية في محرك الـ Gateway."
                                                          data-confirm-btn="نعم، حذف الخطوة"
                                                          data-confirm-type="danger">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@step.Id" />
                                                        <input type="hidden" name="serviceId" value="@Model.Id" />
                                                        <button type="submit" class="dropdown-item py-2 rounded-2 fw-semibold text-danger border-0 bg-transparent w-100 text-start">
                                                            <i class="bi bi-trash3 text-danger me-2 fs-6"></i>حذف الخطوة
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Required API Parameters Card -->
    <div class="portal-card p-4 shadow-sm mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-black mb-0 d-flex align-items-center gap-2 text-main">
                    <span class="p-2 rounded-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-input-cursor-text fs-5"></i>
                    </span>
                    <span>بارامترات الـ API المطلوبة للخدمة (@Model.Parameters.Count(p => p.IsActive))</span>
                </h5>
                <p class="text-muted small mb-0 mt-1">البارامترات المعيارية المعتمدة التي يستقبلها الـ Gateway من تطبيق العميل أو الشركة لتمريرها واستبدالها داخل أوامر الـ USSD</p>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#addParamInline" aria-expanded="false">
                <i class="bi bi-plus-lg me-1"></i> إضافة بارامتر من الأنواع المعيارية
            </button>
        </div>

        <!-- System vs Client Parameters Clarification Alert -->
        <div class="alert alert-light border border-opacity-75 shadow-xs rounded-3 p-3 mb-3">
            <div class="d-flex align-items-start gap-3">
                <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary fs-5 mt-0.5">
                    <i class="bi bi-info-circle-fill"></i>
                </div>
                <div class="flex-grow-1 small">
                    <div class="fw-bold text-main mb-1">دليل معمارية متغيرات الـ USSD والمدفوعات:</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="p-2 rounded-2 bg-success bg-opacity-10 border border-success border-opacity-25 h-100">
                                <div class="fw-bold text-success mb-1 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>بارامترات العميل المعيارية (تُطلب عبر الـ API):</span>
                                </div>
                                <div class="text-muted fs-9">
                                    تُضاف أدناه وتُرسل في ريكوست الدفع من العميل:
                                    <span class="badge bg-light text-primary border font-monospace mt-1">{Amount}</span>
                                    <span class="badge bg-light text-info border font-monospace mt-1">{PhoneNumber}</span>
                                    <span class="badge bg-light text-secondary border font-monospace mt-1">{NationalId}</span>
                                    <span class="badge bg-light text-secondary border font-monospace mt-1">{AccountNumber}</span>
                                    <span class="badge bg-light text-secondary border font-monospace mt-1">{InvoiceNumber}</span>
                                    <span class="badge bg-light text-secondary border font-monospace mt-1">{OtpCode}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2 rounded-2 bg-warning bg-opacity-10 border border-warning border-opacity-25 h-100">
                                <div class="fw-bold text-warning mb-1 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <span>حقول النظام الداخلية المحمية (تلقائية بالكامل):</span>
                                </div>
                                <div class="text-muted fs-9">
                                    يستبدلها النظام داخلياً من إعدادات الشريحة أو جهاز الـ GoIP (ممنوع طلبها من العميل):
                                    <span class="badge bg-light text-dark border font-monospace mt-1">{Password} / {Pin}</span>
                                    <span class="badge bg-light text-dark border font-monospace mt-1">{MerchantCode}</span>
                                    <span class="badge bg-light text-dark border font-monospace mt-1">{SimNumber}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inline Add Parameter Form (Collapsible) -->
        <div class="collapse mb-3" id="addParamInline">
            <div class="p-3.5 rounded-3 border bg-light bg-opacity-75 border-primary border-opacity-25 shadow-xs">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="fw-bold text-primary mb-0 small d-flex align-items-center gap-1.5">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>إضافة بارامتر جديد من قائمة الأنواع الثابتة المعيارية</span>
                    </h6>
                    <button type="button" class="btn-close fs-9" data-bs-toggle="collapse" data-bs-target="#addParamInline" aria-label="Close"></button>
                </div>
                <form asp-action="AddParameter" method="post" id="addParameterForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="serviceId" value="@Model.Id" />

                    <div class="row g-2.5 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">نوع البارامتر المعياري <span class="text-danger">*</span></label>
                            <select id="standardParamSelector" name="ParameterKey" class="form-select form-select-sm fw-bold" required>
                                <option value="" disabled selected>-- اختر النوع المعياري --</option>
                                @foreach (var std in StandardServiceParameters.All)
                                {
                                    var isAlreadyAdded = Model.Parameters.Any(p => p.IsActive && !p.IsDelete && string.Equals(p.ParameterKey, std.Key, StringComparison.OrdinalIgnoreCase));
                                    <option value="@std.Key" 
                                            data-name="@std.Name" 
                                            data-display="@std.DisplayNameAr" 
                                            data-type="@((int)std.DataType)" 
                                            data-required="@(std.DefaultRequired ? "true" : "false")"
                                            data-desc="@std.DescriptionAr"
                                            disabled="@(isAlreadyAdded ? "disabled" : null)">
                                        @std.DisplayNameAr (@std.Key) @(isAlreadyAdded ? " [مضاف بالفعل]" : "")
                                    </option>
                                }
                            </select>
                            <small class="text-muted fs-9">مقتصر حصرياً على الأنواع المعتمدة</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">الاسم بالعربية <span class="text-danger">*</span></label>
                            <input type="text" id="paramDisplayInput" name="DisplayNameAr" class="form-control form-control-sm" placeholder="الاسم الظاهر للمستخدم" required />
                            <small class="text-muted fs-9">الاسم الذي يظهر للعملاء في التوثيق</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">الاسم البرمجي / قالب USSD</label>
                            <input type="text" id="paramNameInput" name="ParameterName" class="form-control form-control-sm font-monospace bg-light" placeholder="ParameterName" readonly />
                            <small class="text-muted fs-9">قالب الاستبدال البرمجي</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">نوع البيانات</label>
                            <select id="paramDataTypeSelect" name="DataType" class="form-select form-select-sm bg-light" readonly>
                                <option value="1">نص (String)</option>
                                <option value="2">رقم صحيح (Integer)</option>
                                <option value="3">مبلغ عشري (Decimal)</option>
                                <option value="4">رقم هاتف (Phone)</option>
                                <option value="5">منطقي (Boolean)</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-center gap-2">
                            <div class="form-check form-switch mb-0">
                                <input type="checkbox" name="IsRequired" value="true" class="form-check-input" role="switch" checked id="isReqParamInline" />
                                <label class="form-check-label small fw-bold" for="isReqParamInline">إجباري</label>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary fw-bold px-3 ms-auto rounded-2">
                                <i class="bi bi-check2 me-1"></i>حفظ
                            </button>
                        </div>
                    </div>
                    <!-- Live Dynamic Hint -->
                    <div id="paramInfoBox" class="mt-2.5 p-2 rounded-2 bg-white border d-none">
                        <div class="d-flex align-items-center gap-2 flex-wrap fs-9">
                            <span class="fw-bold text-primary"><i class="bi bi-braces me-1"></i>رمز الاستبدال في الـ USSD:</span>
                            <code id="paramPlaceholderPreview" class="bg-primary bg-opacity-10 text-primary px-2 py-0.5 rounded fw-bold font-monospace"></code>
                            <span class="text-muted">•</span>
                            <span id="paramDescPreview" class="text-muted"></span>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (!Model.Parameters.Any())
        {
            <div class="text-center py-4 border rounded-3 border-dashed bg-light bg-opacity-30">
                <span class="text-muted small d-block mb-2">لا توجد بارامترات مسجلة لهذه الخدمة بعد.</span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#addParamInline">
                    + إضافة أول بارامتر معياري (مثل amount أو phoneNumber)
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light fs-8">
                        <tr>
                            <th style="min-width: 140px;">مفتاح الـ API</th>
                            <th style="min-width: 160px;">الاسم بالعربية</th>
                            <th style="min-width: 140px;">قالب الـ USSD</th>
                            <th style="min-width: 120px;">نوع البيانات</th>
                            <th style="min-width: 100px;">الإلزامية</th>
                            <th style="width: 80px;" class="text-center">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Parameters.Where(p => p.IsActive).OrderBy(p => p.SortOrder))
                        {
                            var typeBadge = p.DataType switch
                            {
                                GoIPGateway.Domain.Enums.ParameterDataType.String => "bg-primary bg-opacity-10 text-primary border-primary border-opacity-25",
                                GoIPGateway.Domain.Enums.ParameterDataType.Number => "bg-info bg-opacity-10 text-info border-info border-opacity-25",
                                GoIPGateway.Domain.Enums.ParameterDataType.Decimal => "bg-success bg-opacity-10 text-success border-success border-opacity-25",
                                GoIPGateway.Domain.Enums.ParameterDataType.Phone => "bg-purple bg-opacity-10 text-purple border-purple border-opacity-25",
                                _ => "bg-light text-muted border"
                            };

                            <tr>
                                <td>
                                    <code class="font-monospace fw-bold text-primary bg-primary bg-opacity-10 px-2.5 py-1 rounded-2 fs-8 border border-primary border-opacity-25">
                                        @p.ParameterKey
                                    </code>
                                </td>
                                <td>
                                    <span class="fw-bold text-main">@(p.DisplayNameAr ?? p.ParameterName)</span>
                                </td>
                                <td>
                                    <span class="font-monospace text-muted small bg-light px-2 py-0.5 rounded border">
                                        {@p.ParameterName}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @typeBadge border px-2 py-0.5 rounded-pill fs-8">
                                        @p.DataType
                                    </span>
                                </td>
                                <td>
                                    @if (p.IsRequired)
                                    {
                                        <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2 py-0.5 rounded-pill fs-9 fw-bold">
                                            <i class="bi bi-asterisk fs-9 me-0.5"></i> إجباري
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-0.5 rounded-pill fs-9">
                                            اختياري
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="actions-pill-group justify-content-center">
                                        <form asp-action="DeleteParameter" method="post" class="d-inline"
                                              data-confirm="true"
                                              data-confirm-title="حذف بارامتر الخدمة"
                                              data-confirm-message="هل أنت متأكد من حذف هذا البارامتر المعياري؟"
                                              data-confirm-detail="@p.ParameterKey (@(p.DisplayNameAr ?? p.ParameterName))"
                                              data-confirm-detail-label="البارامتر:"
                                              data-confirm-consequence="إذا كان هذا المتغير مستخدماً داخل أوامر USSD، فقد تفشل الطلبات القادمة من الـ API."
                                              data-confirm-btn="نعم، حذف البارامتر"
                                              data-confirm-type="danger">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="serviceId" value="@Model.Id" />
                                            <button type="submit" class="action-pill-btn action-pill-more text-danger" title="حذف البارامتر" style="color: #ef4444 !important; border-color: rgba(239, 68, 68, 0.25);">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selector = document.getElementById('standardParamSelector');
            if (!selector) return;

            selector.addEventListener('change', function () {
                const opt = this.options[this.selectedIndex];
                if (!opt || !opt.value) return;

                const nameInput = document.getElementById('paramNameInput');
                const displayInput = document.getElementById('paramDisplayInput');
                const dataTypeSelect = document.getElementById('paramDataTypeSelect');
                const isReqSwitch = document.getElementById('isReqParamInline');
                const infoBox = document.getElementById('paramInfoBox');
                const previewTag = document.getElementById('paramPlaceholderPreview');
                const descText = document.getElementById('paramDescPreview');

                const name = opt.getAttribute('data-name') || '';
                const display = opt.getAttribute('data-display') || '';
                const type = opt.getAttribute('data-type') || '1';
                const required = opt.getAttribute('data-required') === 'true';
                const desc = opt.getAttribute('data-desc') || '';

                if (nameInput) nameInput.value = name;
                if (displayInput) displayInput.value = display;
                if (dataTypeSelect) dataTypeSelect.value = type;
                if (isReqSwitch) isReqSwitch.checked = required;

                if (infoBox) infoBox.classList.remove('d-none');
                if (previewTag) previewTag.textContent = '{' + name + '}';
                if (descText) descText.textContent = desc;
            });
        });
    </script>
}
