@model GoIPGateway.Application.DTOs.TransactionResultDto

<div class="modal-header">
    <h5 class="modal-title fw-bold">تفاصيل العملية: <code>@Model.TransactionRef</code></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="row g-3 mb-3">
        <div class="col-6">
            <span class="text-muted small d-block">الحالة</span>
            <span class="badge @(Model.IsSuccess ? "bg-success" : "bg-danger")">@Model.Status</span>
        </div>
        <div class="col-6">
            <span class="text-muted small d-block">توقيت التنفيذ</span>
            <span class="small fw-bold">@Model.CompletedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
        </div>
    </div>

    <div class="mb-3">
        <span class="text-muted small d-block mb-1">الاستجابة الخام (Raw Response)</span>
        <pre class="p-3 rounded-3 small mb-0" style="background: var(--bg-app); color: var(--text-main); border: 1px solid var(--card-border); font-family: monospace;">@(Model.RawResponse ?? Model.Message ?? "لا توجد استجابة خام")</pre>
    </div>

    @if (Model.Logs.Any())
    {
        <h6 class="fw-bold mb-2">مراحل التنفيذ (USSD Step Logs):</h6>
        <div class="list-group list-group-flush bg-transparent">
            @foreach (var log in Model.Logs)
            {
                <div class="list-group-item bg-transparent border-secondary border-opacity-25 px-0 py-2">
                    <div class="d-flex justify-content-between small">
                        <strong>الخطوة @log.StepOrder: @log.StepName</strong>
                        <span class="badge @(log.IsSuccess ? "bg-success" : "bg-danger")">@(log.IsSuccess ? "ناجحة" : "فاشلة")</span>
                    </div>
                    <code class="d-block text-warning small my-1">@log.Command</code>
                    <small class="text-muted">الرد: @log.Response (@log.DurationMs ms)</small>
                </div>
            }
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إغلاق</button>
</div>
