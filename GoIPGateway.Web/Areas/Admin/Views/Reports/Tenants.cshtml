@model GoIPGateway.Application.DTOs.Reports.TenantsPerformanceReportDto
@{
    ViewData["Title"] = "تقرير أداء وحجم أعمال الشركات";
    var filter = Model.Filter;
}

<div class="container-fluid py-2">
    <!-- Header with Action Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-bold fs-7">
                    <i class="bi bi-buildings me-1"></i> الرقابة المالية وإدارة التجار
                </span>
                <span class="text-muted fs-8">تقرير تحليلي مالي مركزي</span>
            </div>
            <h2 class="fw-black mb-1 text-main fs-3">تقرير أداء وحجم أعمال الشركات (Tenants Financial Volume)</h2>
            <p class="text-muted small mb-0">كشف شامل لحجم المبالغ المنفذة لكل شركة، أرباح ورسوم المنصة، معدلات النجاح، وحالة البنية التحتية</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" onclick="window.print()" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-bold">
                <i class="bi bi-printer"></i> <span>طباعة التقرير</span>
            </button>
            <a asp-action="ExportTenantsCsv"
               asp-route-datePreset="@filter.DatePreset"
               asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
               asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
               asp-route-searchTerm="@filter.SearchTerm"
               asp-route-sortBy="@filter.SortBy"
               asp-route-isActiveOnly="@filter.IsActiveOnly"
               class="btn btn-success d-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-bold shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i> <span>تصدير Excel (CSV)</span>
            </a>
        </div>
    </div>

    <!-- Navigation Tabs Between Reports -->
    <ul class="nav nav-pills gap-2 mb-4 p-1.5 rounded-4 border" style="background: var(--card-bg); border-color: var(--card-border) !important; width: fit-content;">
        <li class="nav-item">
            <a class="nav-link active rounded-3 px-3 py-2 fw-bold d-flex align-items-center gap-2" asp-action="Tenants">
                <i class="bi bi-buildings-fill"></i> <span>ملخص أداء الشركات (كل شركة عملت إيه)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-muted rounded-3 px-3 py-2 fw-bold d-flex align-items-center gap-2" asp-action="Summary">
                <i class="bi bi-graph-up-arrow"></i> <span>تقرير الإجماليات والتسويات</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-muted rounded-3 px-3 py-2 fw-bold d-flex align-items-center gap-2" asp-action="Index">
                <i class="bi bi-cpu"></i> <span>التقرير التفصيلي للعمليات وبوابات GoIP</span>
            </a>
        </li>
    </ul>

    <!-- High-Caliber Filter Card ("فلاتر محترمه") -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
        <div class="card-body p-4">
            <form method="get" asp-action="Tenants" id="tenantsFilterForm">
                <!-- Date Presets Bar -->
                <div class="d-flex flex-wrap align-items-center gap-2 pb-3 mb-3 border-bottom border-secondary border-opacity-10">
                    <span class="text-muted fs-8 fw-bold me-1"><i class="bi bi-calendar3 me-1"></i> الفترة المحاسبية:</span>
                    <button type="submit" name="datePreset" value="today" class="btn btn-sm @(filter.DatePreset == "today" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">اليوم</button>
                    <button type="submit" name="datePreset" value="yesterday" class="btn btn-sm @(filter.DatePreset == "yesterday" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">أمس</button>
                    <button type="submit" name="datePreset" value="last7days" class="btn btn-sm @(filter.DatePreset == "last7days" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">آخر 7 أيام</button>
                    <button type="submit" name="datePreset" value="thismonth" class="btn btn-sm @(filter.DatePreset == "thismonth" || string.IsNullOrEmpty(filter.DatePreset) ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">هذا الشهر</button>
                    <button type="submit" name="datePreset" value="lastmonth" class="btn btn-sm @(filter.DatePreset == "lastmonth" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">الشهر الماضي</button>
                    <button type="button" onclick="toggleCustomDates()" class="btn btn-sm @(filter.DatePreset == "custom" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">تاريخ مخصص...</button>
                </div>

                <!-- Custom Dates Row -->
                <div id="customDatesRow" class="row g-3 mb-3 @(filter.DatePreset == "custom" ? "" : "d-none")">
                    <input type="hidden" name="datePreset" id="datePresetInput" value="@filter.DatePreset" />
                    <div class="col-md-6">
                        <label class="form-label fs-8 fw-bold text-muted">من تاريخ</label>
                        <input type="datetime-local" name="fromDate" value="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm")" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fs-8 fw-bold text-muted">إلى تاريخ</label>
                        <input type="datetime-local" name="toDate" value="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm")" class="form-control rounded-3" />
                    </div>
                </div>

                <!-- Grid Filters -->
                <div class="row g-3">
                    <!-- Search Input -->
                    <div class="col-md-5 col-sm-12">
                        <label class="form-label fs-8 fw-bold text-muted">🔍 بحث باسم الشركة / المسؤول / الهاتف / البريد</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchTerm" value="@filter.SearchTerm" class="form-control border-start-0 rounded-start-3" placeholder="اكتب اسم الشركة أو بيانات التواصل..." />
                        </div>
                    </div>

                    <!-- Sort By Selector -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">📊 ترتيب النتائج حسب</label>
                        <select name="sortBy" class="form-select rounded-3">
                            <option value="volume_desc" selected="@(filter.SortBy == "volume_desc" || string.IsNullOrEmpty(filter.SortBy))">الأعلى في حجم المبالغ المنفذة</option>
                            <option value="count_desc" selected="@(filter.SortBy == "count_desc")">الأعلى في عدد العمليات</option>
                            <option value="fees_desc" selected="@(filter.SortBy == "fees_desc")">الأعلى في أرباح ورسوم المنصة</option>
                            <option value="success_rate" selected="@(filter.SortBy == "success_rate")">الأعلى في نسبة النجاح</option>
                            <option value="name_asc" selected="@(filter.SortBy == "name_asc")">ترتيب أبجدي حسب اسم الشركة</option>
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="col-md-2 col-sm-6">
                        <label class="form-label fs-8 fw-bold text-muted">🏢 حالة الشركات</label>
                        <select name="isActiveOnly" class="form-select rounded-3">
                            <option value="true" selected="@(filter.IsActiveOnly == true)">الشركات النشطة فقط</option>
                            <option value="false" selected="@(filter.IsActiveOnly == false)">كل الشركات (بما فيها المتوقفة)</option>
                        </select>
                    </div>

                    <!-- Submit & Reset Buttons -->
                    <div class="col-md-2 col-sm-12 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-2 rounded-3 py-2 fw-bold shadow-sm">
                            <i class="bi bi-funnel-fill"></i> <span>فلترة</span>
                        </button>
                        <a asp-action="Tenants" class="btn btn-outline-secondary d-flex align-items-center justify-content-center rounded-3 py-2 px-3 fw-bold" title="إعادة تعيين الفلاتر">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Executive KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Volume Processed Across All Companies -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #2563eb !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">إجمالي حجم المبالغ المنفذة للشركات</span>
                    <div class="p-2.5 rounded-3 bg-primary bg-opacity-10 text-primary fs-5">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
                <div class="fs-3 fw-black text-main">@Model.TotalOverallVolume.ToString("N2") <small class="fs-7 text-muted">ج.م</small></div>
                <div class="text-muted fs-8 mt-2">
                    <span>خلال الفترة الزمنية المحددة</span>
                </div>
            </div>
        </div>

        <!-- Platform Revenue / Fees -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #16a34a !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">إجمالي أرباح ورسوم المنصة</span>
                    <div class="p-2.5 rounded-3 bg-success bg-opacity-10 text-success fs-5">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
                <div class="fs-3 fw-black text-main">@Model.TotalOverallFees.ToString("N2") <small class="fs-7 text-muted">ج.م</small></div>
                <div class="text-muted fs-8 mt-2">
                    <span>إيرادات النظام المحصلة من العمليات</span>
                </div>
            </div>
        </div>

        <!-- Total Operations & Average Success Rate -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #8b5cf6 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">العمليات ومعدل النجاح العام</span>
                    <div class="p-2.5 rounded-3 bg-purple bg-opacity-10 text-purple fs-5" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                        <i class="bi bi-check2-all"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <div class="fs-3 fw-black text-main">@Model.TotalOverallOperations.ToString("N0")</div>
                    <span class="badge @(Model.AverageSuccessRate >= 90 ? "bg-success" : (Model.AverageSuccessRate >= 75 ? "bg-warning" : "bg-danger")) text-white fs-8 fw-bold rounded-pill">
                        @Model.AverageSuccessRate% نجاح
                    </span>
                </div>
                <div class="text-muted fs-8 mt-2">
                    <span class="text-success fw-bold">@Model.TotalSuccessfulOperations ناجحة</span> • 
                    <span class="text-danger fw-bold">@Model.TotalFailedOperations فاشلة</span>
                </div>
            </div>
        </div>

        <!-- Registered Companies -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: var(--card-bg); border-right: 4px solid #f59e0b !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted fs-8 fw-bold">الشركات والتجار المسجلين</span>
                    <div class="p-2.5 rounded-3 bg-warning bg-opacity-10 text-warning fs-5">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
                <div class="fs-3 fw-black text-main">@Model.Tenants.Count <small class="fs-7 text-muted">شركة بالتقرير</small></div>
                <div class="text-muted fs-8 mt-2">
                    <span>منها <strong>@Model.ActiveTenantsCount</strong> شركة بحساب نشط ومفعل</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Companies Volume Table ("كل شركة عملت إيه") -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: var(--card-bg); border: 1px solid var(--card-border) !important;">
        <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center justify-content-between border-bottom" style="border-color: var(--card-border) !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-main">تفاصيل أداء وحجم أعمال كل شركة</h5>
            </div>
            <span class="text-muted fs-8">
                عرض <strong>@Model.Tenants.Count</strong> شركة مطابقة لشروط الفلترة
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Tenants.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-buildings fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    لا توجد شركات مطابقة لمعايير البحث والفلترة المحددة.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom table-sticky-dual align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 38px;" class="text-center sticky-col-1">#</th>
                                <th style="min-width: 125px;" class="sticky-col-2"><span class="d-none d-sm-inline">الشركة / التاجر</span><span class="d-sm-none">الشركة</span></th>
                                <th>حجم المبالغ المنفذة</th>
                                <th>رسوم المنصة</th>
                                <th>العمليات والنجاح</th>
                                <th>نسبة النجاح</th>
                                <th>الأجهزة والشرائح</th>
                                <th>الرصيد المالي</th>
                                <th>آخر نشاط</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Tenants.Count; i++)
                            {
                                var t = Model.Tenants[i];
                                <tr>
                                    <td class="text-center sticky-col-1">
                                        <span class="text-muted fs-8 fw-bold font-monospace">@(i + 1)</span>
                                    </td>
                                    <td class="sticky-col-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2.5 rounded-3 bg-primary bg-opacity-10 text-primary fs-6 d-none d-md-flex">
                                                <i class="bi bi-building"></i>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                    <span class="fw-bold text-main fs-7 text-truncate" style="max-width: 115px;" title="@t.CompanyName">@t.CompanyName</span>
                                                    @if (t.IsBlocked)
                                                    {
                                                        <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-2 py-0.5 fs-9">محظور</span>
                                                    }
                                                    else if (!t.IsActive)
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-15 text-muted rounded-pill px-2 py-0.5 fs-9">معطل</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-2 py-0.5 fs-9 d-none d-md-inline-block">نشط</span>
                                                    }
                                                </div>
                                                <div class="text-muted fs-8 d-none d-md-block text-truncate" style="max-width: 140px;">
                                                    @(t.ContactPerson ?? "بدون مسؤول") • <span class="font-monospace">@(t.ContactPhone ?? "-")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fs-6 fw-black text-main font-monospace">@t.TotalFinancialVolume.ToString("N2") <small class="fs-8 text-muted">ج.م</small></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success font-monospace fs-8 fw-bold">
                                            +@t.TotalPlatformFees.ToString("N2") ج.م
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-main fs-7">@t.TotalOperationsCount.ToString("N0") <small class="text-muted fs-8">عملية</small></div>
                                        <div class="fs-8 text-muted">
                                            <span class="text-success fw-semibold">@t.SuccessfulOperationsCount ناجحة</span> • 
                                            <span class="text-danger fw-semibold">@t.FailedOperationsCount فاشلة</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" style="min-width: 120px;">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar @(t.SuccessRate >= 90 ? "bg-success" : (t.SuccessRate >= 75 ? "bg-warning" : "bg-danger"))" style="width: @t.SuccessRate%"></div>
                                            </div>
                                            <span class="fs-8 fw-bold">@t.SuccessRate%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-secondary bg-opacity-10 text-main fs-8" title="أجهزة GoIP المخصصة">
                                                <i class="bi bi-router me-1"></i> @t.AssignedDevicesCount أجهزة
                                            </span>
                                            <span class="badge bg-secondary bg-opacity-10 text-main fs-8" title="الشرائح النشطة">
                                                <i class="bi bi-sim me-1"></i> @t.ActiveSimsCount شرايح
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-main font-monospace fs-8">@t.CurrentBalance.ToString("N2") ج.م</span>
                                    </td>
                                    <td>
                                        @if (t.LastOperationAt.HasValue)
                                        {
                                            <div class="text-main fs-8">@t.LastOperationAt.Value.ToString("yyyy-MM-dd")</div>
                                            <div class="text-muted fs-8 font-monospace">@t.LastOperationAt.Value.ToString("HH:mm")</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-8">لا يوجد نشاط</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <a asp-action="Index"
                                               asp-route-tenantId="@t.TenantId"
                                               asp-route-datePreset="@filter.DatePreset"
                                               asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                               asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-ddTHH:mm:ss")"
                                               class="btn btn-sm btn-primary d-flex align-items-center gap-1 rounded-3 px-2.5 py-1 fw-bold fs-8"
                                               title="عرض العمليات التفصيلية وأجهزة هذه الشركة">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                                <span>تقرير تفصيلي</span>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Tenants" asp-action="Edit" asp-route-id="@t.TenantId"
                                               class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-1"
                                               title="تعديل بيانات الشركة">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleCustomDates() {
            const row = document.getElementById('customDatesRow');
            const presetInput = document.getElementById('datePresetInput');
            if (row.classList.contains('d-none')) {
                row.classList.remove('d-none');
                presetInput.value = 'custom';
            } else {
                row.classList.add('d-none');
            }
        }
    </script>
}
