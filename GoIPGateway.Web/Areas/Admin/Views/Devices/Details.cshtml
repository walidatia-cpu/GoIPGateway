@model GoIPGateway.Domain.Entities.Device
@{
    ViewData["Title"] = $"تفاصيل الجهاز - {Model.DeviceName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-router text-primary me-2"></i> @Model.DeviceName</h3>
        <p class="text-muted small mb-0"><code>@Model.IpAddress:@Model.Port</code> • نوع الجهاز: <strong>@Model.DeviceType (@Model.TotalPorts بورت)</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right me-1"></i> العودة للقائمة</a>
    </div>
</div>

<!-- Port Status Legend -->
<div class="portal-card p-3 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-4">
            <span class="small fw-bold text-muted">دليل ألوان البورتات:</span>
            <span class="d-flex align-items-center gap-2 small"><span class="port-cell active d-inline-flex" style="width:20px;height:20px;"></span> شريحة نشطة</span>
            <span class="d-flex align-items-center gap-2 small"><span class="port-cell busy d-inline-flex" style="width:20px;height:20px;"></span> جاري معالجة USSD (مشغول)</span>
            <span class="d-flex align-items-center gap-2 small"><span class="port-cell empty d-inline-flex" style="width:20px;height:20px;"></span> بورت فارغ</span>
        </div>
        <div class="small text-muted">
            إجمالي البورتات: <strong>@Model.TotalPorts</strong> | المشغول: <span id="busy-count" class="text-warning fw-bold">@Model.Ports.Count(p => p.IsBusy)</span>
        </div>
    </div>
</div>

<!-- Interactive Visual Port Grid (128 / 512 Ports) -->
<div class="portal-card p-4 shadow-sm mb-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-grid-3x3-gap-fill text-info me-2"></i> خريطة البورتات اللحظية (GoIP Port Matrix)</h5>

    <div class="port-grid">
        @foreach (var port in Model.Ports)
        {
            var cellClass = "empty";
            if (port.IsBusy) cellClass = "busy";
            else if (port.SimCard != null && port.SimCard.IsActive) cellClass = "active";

            <div class="port-cell @cellClass"
                 id="port-cell-@port.Id"
                 data-port-id="@port.Id"
                 data-port-label="@port.PortLabel"
                 data-port-num="@port.PortNumber"
                 data-sim-phone="@(port.SimCard?.PhoneNumber ?? "لا توجد شريحة")"
                 data-sim-balance="@(port.SimCard?.CurrentBalance.ToString("N2") ?? "0.00")"
                 data-operator="@(port.SimCard?.Operator.ToString() ?? "-")"
                 onclick="openPortModal(this)"
                 title="بورت @port.PortLabel: @(port.SimCard?.PhoneNumber ?? "فارغ")">
                <span>@port.PortNumber</span>
            </div>
        }
    </div>
</div>

<!-- Port Quick Actions Modal -->
<div class="modal fade" id="portModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalPortTitle">بورت</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="text-muted small">رقم الشريحة</label>
                    <h5 id="modalSimPhone" class="fw-bold text-primary"></h5>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">شركة المحمول</label>
                    <div id="modalSimOperator" class="fw-bold"></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">الرصيد الحالي</label>
                    <h4 id="modalSimBalance" class="fw-bold text-success"></h4>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPortModal(cell) {
            document.getElementById('modalPortTitle').innerText = 'تفاصيل بورت: ' + cell.getAttribute('data-port-label');
            document.getElementById('modalSimPhone').innerText = cell.getAttribute('data-sim-phone');
            document.getElementById('modalSimOperator').innerText = cell.getAttribute('data-operator');
            document.getElementById('modalSimBalance').innerText = cell.getAttribute('data-sim-balance') + ' ج.م';

            const modal = new bootstrap.Modal(document.getElementById('portModal'));
            modal.show();
        }

        window.addEventListener("goip:portStatusChanged", function (e) {
            const port = e.detail;
            const cell = document.getElementById("port-cell-" + port.id);
            if (cell) {
                cell.className = "port-cell";
                if (port.isBusy) {
                    cell.classList.add("busy");
                } else if (port.status === 1) {
                    cell.classList.add("active");
                } else {
                    cell.classList.add("empty");
                }
            }
        });
    </script>
}
