@model GoIPGateway.Application.Features.Devices.Commands.RegisterDeviceCommand
@{
    ViewData["Title"] = "إضافة جهاز GoIP";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="portal-card p-4 p-md-5 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-4 bg-primary bg-opacity-25 text-primary fs-3">
                        <i class="bi bi-router"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">تسجيل جهاز GoIP جديد</h4>
                        <p class="text-muted small mb-0">ربط جهاز GoIP 128 أو 512 بورت وتوليد البورتات تلقائياً في النظام</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-right me-1"></i> رجوع للقائمة
                </a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-bold">اسم الجهاز (Device Name) <span class="text-danger">*</span></label>
                        <input asp-for="DeviceName" class="form-control" placeholder="GoIP 128 - Gateway Primary" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-bold">نوع وموديل الجهاز <span class="text-danger">*</span></label>
                        <select asp-for="DeviceType" class="form-select">
                            <option value="1">GoIP 128 (128 بورت)</option>
                            <option value="2">GoIP 512 (512 بورت)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small text-muted fw-bold">عنوان IP للجهاز في الشبكة <span class="text-danger">*</span></label>
                        <input asp-for="IpAddress" class="form-control" placeholder="192.168.1.100" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small text-muted fw-bold">المنفذ (HTTP Port) <span class="text-danger">*</span></label>
                        <input asp-for="Port" type="number" min="1" max="65535" class="form-control" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-bold">اسم مستخدم الجهاز (HTTP Auth) <span class="text-danger">*</span></label>
                        <input asp-for="Username" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-bold">كلمة مرور الجهاز (Password) <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label small text-muted">موقع الجهاز (Location / Rack)</label>
                        <input asp-for="Location" class="form-control" placeholder="Data Center Rack A-12" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small text-muted">ملاحظات إضافية</label>
                        <input asp-for="Notes" class="form-control" placeholder="ملاحظات تشغيلية" />
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary py-3 fw-bold shadow">
                        <i class="bi bi-hdd-network-fill me-2"></i> حفظ الجهاز وتوليد مصفوفة البورتات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
