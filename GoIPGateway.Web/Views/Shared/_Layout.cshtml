                    <a asp-area="Company" asp-controller="Reports" asp-action="Summary" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Summary" ? "active" : "")" title="تقرير الإجماليات والتسويات">
