    <!-- Unified System-Wide Confirmation Modal -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden; background: var(--card-bg);">
                <div class="p-4 text-center">
                    <!-- Dynamic Pulsing Icon -->
                    <div class="confirm-icon-wrapper mb-3 mx-auto" id="globalConfirmIconWrapper">
                        <i id="globalConfirmIcon" class="bi bi-shield-x"></i>
                    </div>

                    <!-- Title & Primary Question -->
                    <h5 class="fw-black mb-2 text-main fs-5" id="globalConfirmTitle">تأكيد الإجراء</h5>
                    <p class="text-muted small mb-3 px-2" id="globalConfirmMessage">هل أنت متأكد من تنفيذ هذه العملية؟</p>

                    <!-- Highlight Box (Item Detail) -->
                    <div class="p-2.5 rounded-3 mb-3 text-start d-none" id="globalConfirmDetailBox" style="background: var(--bg-app); border: 1px solid var(--card-border);">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted fs-8 fw-bold" id="globalConfirmDetailLabel">العنصر:</span>
                            <span class="fw-bold font-monospace text-primary text-truncate fs-8" id="globalConfirmDetailText"></span>
                        </div>
                    </div>

                    <!-- Consequence Warning Box -->
                    <div class="alert alert-danger border-0 d-flex align-items-start gap-2 text-start p-2.5 mb-4 rounded-3 d-none" id="globalConfirmConsequenceBox">
                        <i class="bi bi-exclamation-triangle-fill fs-6 flex-shrink-0 text-danger mt-0.5"></i>
                        <div class="fs-8 text-danger fw-semibold" id="globalConfirmConsequence">
                            تنبيه: هذا الإجراء حساس وله تأثير مباشر على العمليات.
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center gap-2 justify-content-center">
                        <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-bold fs-7 flex-grow-1" id="globalConfirmCancelBtn" data-bs-dismiss="modal">
                            إلغاء وتراجع
                        </button>
                        <button type="button" class="btn btn-danger px-4 py-2 rounded-pill fw-bold fs-7 flex-grow-1 shadow-sm d-flex align-items-center justify-content-center gap-1.5" id="globalConfirmActionBtn">
                            <i class="bi bi-check-circle-fill" id="globalConfirmActionBtnIcon"></i>
                            <span id="globalConfirmActionBtnText">نعم، تأكيد</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

