@model GoIPGateway.Web.Models.Components.SearchFilterBarModel

@if (Model != null)
{
    <div class="search-filter-bar-container py-3 px-3 px-md-4">
        <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-md-center">
            
            <!-- Right: Search Input & Filter Dropdowns -->
            <div class="d-flex flex-wrap align-items-center gap-2.5 flex-grow-1">
                
                <!-- Quick Search Input -->
                <div class="position-relative flex-grow-1 search-input-wrapper" style="min-width: 250px; max-width: 380px;">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted fs-6 pointer-events-none opacity-75"></i>
                    <input type="text"
                           id="@Model.SearchInputId"
                           class="form-control ps-5 pe-4 rounded-pill bg-body-tertiary border shadow-xs search-bar-input"
                           style="height: 44px; font-size: 0.92rem;"
                           placeholder="@Model.SearchPlaceholder"
                           @(!string.IsNullOrEmpty(Model.OnSearchInput) ? $"oninput=\"{Model.OnSearchInput}\"" : "") />
                    <button type="button"
                            class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted p-0 me-3 text-decoration-none d-none"
                            id="@(Model.SearchInputId)_clear"
                            onclick="const inp=document.getElementById('@Model.SearchInputId'); if(inp){ inp.value=''; inp.dispatchEvent(new Event('input', {bubbles:true})); } this.classList.add('d-none');">
                        <i class="bi bi-x-circle-fill fs-6"></i>
                    </button>
                </div>

                <!-- Reusable Searchable Filter Dropdowns -->
                @if (Model.Filters != null && Model.Filters.Any())
                {
                    <div class="d-flex flex-wrap align-items-center gap-2.5">
                        @foreach (var filter in Model.Filters)
                        {
                            <partial name="Partials/_FilterDropdown" model="filter" />
                        }
                    </div>
                }

                <!-- Reset Filters Button -->
                @if (!string.IsNullOrEmpty(Model.ResetFiltersFunction))
                {
                    <button type="button"
                            class="btn btn-outline-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1.5 fs-7 fw-semibold reset-filter-btn"
                            style="height: 44px;"
                            onclick="@Model.ResetFiltersFunction"
                            title="إعادة ضبط الفلاتر">
                        <i class="bi bi-arrow-counterclockwise fs-6"></i>
                        <span class="d-none d-sm-inline">إعادة ضبط</span>
                    </button>
                }
            </div>

            <!-- Left: Counter & Primary Action Button -->
            <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-2.5 flex-shrink-0">
                @if (!string.IsNullOrEmpty(Model.CounterId))
                {
                    <span class="badge bg-body-secondary text-body border px-3 py-2 rounded-pill fs-7 fw-bold d-inline-flex align-items-center gap-1.5 shadow-xs" style="height: 44px;">
                        <span class="text-muted fw-normal">@Model.CounterLabel</span>
                        <span id="@Model.CounterId" class="fw-black text-primary fs-6">@(Model.InitialCount.HasValue ? Model.InitialCount.Value.ToString() : "0")</span>
                    </span>
                }

                @if (Model.PrimaryAction != null)
                {
                    @if (!string.IsNullOrEmpty(Model.PrimaryAction.Url))
                    {
                        <a href="@Model.PrimaryAction.Url" class="btn @Model.PrimaryAction.ColorClass rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm btn-primary-action-pill" style="height: 44px; font-size: 0.92rem;">
                            @if (!string.IsNullOrEmpty(Model.PrimaryAction.Icon))
                            {
                                <i class="bi @Model.PrimaryAction.Icon fs-6"></i>
                            }
                            <span>@Model.PrimaryAction.Text</span>
                        </a>
                    }
                    else if (!string.IsNullOrEmpty(Model.PrimaryAction.OnClick))
                    {
                        <button type="button" onclick="@Model.PrimaryAction.OnClick" class="btn @Model.PrimaryAction.ColorClass rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm btn-primary-action-pill" style="height: 44px; font-size: 0.92rem;">
                            @if (!string.IsNullOrEmpty(Model.PrimaryAction.Icon))
                            {
                                <i class="bi @Model.PrimaryAction.Icon fs-6"></i>
                            }
                            <span>@Model.PrimaryAction.Text</span>
                        </button>
                    }
                }
            </div>

        </div>
    </div>
}
