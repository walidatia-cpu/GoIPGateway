@model GoIPGateway.Web.Models.ChangePasswordRequiredViewModel
@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة - GoIP Gateway";
    Layout = null;
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <script>
        (function () {
            const savedTheme = localStorage.getItem('goip_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap@(isRtl ? ".rtl" : "").min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --font-ar: 'IBM Plex Sans Arabic', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-en: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-base: var(--font-ar);
            --primary-gradient: linear-gradient(135deg, #2563eb 0%, #4f46e5 50%, #7c3aed 100%);
        }

        [data-bs-theme="dark"] {
            --page-bg: #070a13;
            --card-bg: rgba(13, 19, 34, 0.95);
            --card-border: rgba(255, 255, 255, 0.1);
            --text-heading: #f8fafc;
            --text-body: #94a3b8;
            --input-bg: rgba(15, 23, 42, 0.7);
            --input-border: rgba(255, 255, 255, 0.12);
            --input-text: #f8fafc;
        }

        [data-bs-theme="light"] {
            --page-bg: #f1f5f9;
            --card-bg: #ffffff;
            --card-border: #e2e8f0;
            --text-heading: #0f172a;
            --text-body: #475569;
            --input-bg: #ffffff;
            --input-border: #cbd5e1;
            --input-text: #0f172a;
        }

        body {
            font-family: var(--font-base);
            background-color: var(--page-bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 520px;
            overflow: hidden;
        }

        .auth-header {
            padding: 32px 32px 16px;
            text-align: center;
        }

        .auth-body {
            padding: 0 32px 32px;
        }

        .security-badge {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: rgba(37, 99, 235, 0.12);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin: 0 auto 16px;
            border: 1px solid rgba(37, 99, 235, 0.25);
        }

        .form-control-custom {
            background-color: var(--input-bg);
            border: 1px solid var(--input-border);
            color: var(--input-text);
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .form-control-custom:focus {
            background-color: var(--input-bg);
            border-color: #3b82f6;
            color: var(--input-text);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        }

        .btn-gradient {
            background: var(--primary-gradient);
            border: none;
            color: #ffffff;
            font-weight: 700;
            padding: 12px;
            border-radius: 12px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.35);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-header">
            <div class="security-badge">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h3 class="fw-bold mb-2" style="color: var(--text-heading);">تعيين كلمة مرور جديدة</h3>
            <p class="small mb-0" style="color: var(--text-body);">
                تم تسجيل الدخول بكلمة مرور مؤقتة. حرصاً على سرية وحماية حسابك والعمليات المالية لشركتك، يرجى تعيين كلمة مرور شخصية جديدة للمتابعة.
            </p>
        </div>

        <div class="auth-body">
            @if (!string.IsNullOrEmpty(Model.FullName))
            {
                <div class="p-3 mb-3 rounded-3 border d-flex align-items-center gap-2" style="background: rgba(37, 99, 235, 0.05); border-color: rgba(37, 99, 235, 0.2) !important;">
                    <i class="bi bi-person-check-fill text-primary fs-5"></i>
                    <div>
                        <div class="fw-bold small" style="color: var(--text-heading);">@Model.FullName</div>
                        <div class="text-muted fs-8 font-monospace">@Model.Email</div>
                    </div>
                </div>
            }

            <form asp-action="ChangePasswordRequired" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

                <!-- Current Temp Password -->
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label small fw-bold" style="color: var(--text-heading);"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--input-border); color: var(--text-body);">
                            <i class="bi bi-key"></i>
                        </span>
                        <input asp-for="CurrentPassword" type="password" class="form-control form-control-custom border-start-0" placeholder="أدخل كلمة المرور المؤقتة التي استلمتها" required />
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-bold" style="color: var(--text-heading);"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--input-border); color: var(--text-body);">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="NewPassword" type="password" class="form-control form-control-custom border-start-0" placeholder="أدخل كلمة مرور جديدة قوية (6 أحرف فأكثر)" required />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <!-- Confirm New Password -->
                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label small fw-bold" style="color: var(--text-heading);"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--input-border); color: var(--text-body);">
                            <i class="bi bi-shield-check"></i>
                        </span>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control form-control-custom border-start-0" placeholder="أعد إدخال كلمة المرور الجديدة للتأكيد" required />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-gradient">
                        <i class="bi bi-check-circle me-1"></i> حفظ كلمة المرور والدخول للمنصة
                    </button>
                    <a asp-action="Logout" class="btn btn-link text-muted small text-decoration-none">
                        <i class="bi bi-box-arrow-right"></i> تسجيل الخروج والعودة لاحقاً
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>

